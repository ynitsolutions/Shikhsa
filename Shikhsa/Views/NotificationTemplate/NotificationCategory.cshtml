@model Shikhsa.Models.Notification.NotificationCategory
@{
    ViewData["Title"] = "Notification Categories";
    var list = ViewBag.List as List<Shikhsa.Models.Notification.NotificationCategory>;
}

<div class="container-fluid">

    <!-- FORM (TOP) -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white">
            <strong>@Localizer.Get("Notification Category")</strong>
        </div>

        <div class="card-body">
            <form method="post" asp-action="SaveNotificationCategory">
                <input type="hidden" asp-for="NotificationCategoryId" />

                <div class="row g-3">

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">@Localizer.Get("Category Code")</label>
                        <input asp-for="CategoryCode" class="form-control" required />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">@Localizer.Get("Category Name")</label>
                        <input asp-for="CategoryName" class="form-control" required />
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <label class="form-label">@Localizer.Get("Icon")</label>
                        <input asp-for="Icon" class="form-control" placeholder="bi bi-people" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <label class="form-label">@Localizer.Get("Color")</label>
                        <input asp-for="Color" class="form-control" placeholder="#0d6efd" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <label class="form-label">@Localizer.Get("Display Order")</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label" asp-for="IsActive">@Localizer.Get("Active")</label>
                        </div>
                    </div>

                </div>

                <div class="mt-3">
                    <button class="btn btn-success px-4">@Localizer.Get("Save")</button>
                </div>
            </form>
        </div>
    </div>

    <!-- LIST (BOTTOM) -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <strong>@Localizer.Get("Category List")</strong>
        </div>

        <div class="card-body">

           @*  <input type="text"
                   id="searchBox"
                   class="form-control mb-2"
                   placeholder="Search category..." /> *@

            <div class="table-responsive">
                <table class="table table-bordered table-sm table-hover align-middle datatable" id="tbl">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer.Get("Code")</th>
                            <th>@Localizer.Get("Name")</th>
                            <th>@Localizer.Get("Icon")</th>
                            <th>@Localizer.Get("Color")</th>
                            <th>@Localizer.Get("Status")</th>
                            <th class="text-nowrap" style="width:140px;">@Localizer.Get("Action")</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (list != null)
                        {
                            foreach (var item in list)
                            {
                                <tr>
                                    <td>@item.CategoryCode</td>
                                    <td>@item.CategoryName</td>
                                    <td><i class="@item.Icon"></i></td>
                                    <td>
                                        <span style="background:@item.Color;padding:5px 10px;color:#fff;border-radius:4px;">
                                            @item.Color
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    <td class="text-nowrap">
                                        <a asp-action="SaveNotificationCategory"
                                           asp-route-id="@item.NotificationCategoryId"
                                           class="btn btn-warning btn-sm">
                                            @Localizer.Get("Edit")
                                        </a>

                                        <button class="btn btn-sm btn-danger"
                                                onclick="deleteItem(@item.NotificationCategoryId)">
                                            @Localizer.Get("Delete")
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
     <partial name="_ValidationScriptsPartial" />
    <script>
        // SEARCH FILTER
        var searchBox = document.getElementById("searchBox");
        if (searchBox) {
            searchBox.addEventListener("keyup", function() {
                let value = this.value.toLowerCase();
                document.querySelectorAll("#tbl tbody tr").forEach(function(r) {
                    r.style.display = r.innerText.toLowerCase().includes(value) ? "" : "none";
                });
            });
        }

        // DELETE
        function deleteItem(id) {
            if (!confirm("Are you sure to delete?")) return;

            fetch('@Url.Action("Delete", "NotificationCategory")?id=' + id, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() }
            })
                .then(res => res.json())
                .then(res => {
                    alert(res.message);
                    if (res.status === 1) location.reload();
                })
                .catch(() => alert("Error while deleting."));
        }

        function getToken() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
    </script>
}
