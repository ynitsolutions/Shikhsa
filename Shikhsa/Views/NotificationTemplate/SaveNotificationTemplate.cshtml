@using Shikhsa.Models.Notification
@model Shikhsa.Models.Notification.NotificationTemplate

@{
    ViewData["Title"] = @Localizer.Get("Notification Template");

    var categories = ViewBag.Categories as List<NotificationCategory>;
    var placeholders = ViewBag.Placeholders as List<NotificationPlaceholder>;
    var selectedCategories = ViewBag.SelectedCategories as List<long> ?? new List<long>();
}

<div class="container-fluid">
    <form asp-action="SaveNotificationTemplate" method="post">
        <input asp-for="NotificationTemplateId" type="hidden" />

        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@Localizer.Get("Notification Template")</h5>
            </div>

            <div class="card-body">

                <!-- Basic Info -->
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer.Get("Template Name")</label>
                        <input asp-for="TemplateName" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer.Get("Template Code")</label>
                        <input asp-for="TemplateCode" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer.Get("Channel")</label>
                        <select asp-for="Channel" class="form-select">
                            <option value="1">@Localizer.Get("Email")</option>
                            <option value="2">@Localizer.Get("SMS")</option>
                            <option value="3">@Localizer.Get("WhatsApp")</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer.Get("Categories")</label>
                        <select class="form-select select2" multiple name="categoryIds">
                            @foreach (var item in categories)
                            {
                                if (selectedCategories.Contains(item.NotificationCategoryId))
                                {
                                    <option selected value="@item.NotificationCategoryId">@item.CategoryName</option>
                                }
                                else
                                {
                                    <option value="@item.NotificationCategoryId">@item.CategoryName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">@Localizer.Get("Subject")</label>
                        <input asp-for="Subject" class="form-control" />
                    </div>
                </div>

                <!-- Body + Placeholders -->
                <div class="mt-3">
                    <label class="form-label fw-bold">@Localizer.Get("Email Body")</label>

                    <div class="row g-3">

                        <!-- Placeholder Panel -->
                        <div class="col-12 col-lg-3">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-primary text-white py-2">
                                    <i class="bi bi-tags"></i>
                                    @Localizer.Get("Available Placeholders")
                                </div>

                                <div class="card-body p-2">
                                    <input type="text"
                                           id="txtSearch"
                                           class="form-control form-control-sm mb-2"
                                           placeholder="@Localizer.Get("Search Placeholder...")" />

                                    <div class="placeholder-container">
                                        @foreach (var group in placeholders.GroupBy(x => x.NotificationCategory.CategoryName))
                                        {
                                            <div class="mb-2">
                                                <div class="placeholder-category">@group.Key</div>

                                                @foreach (var item in group)
                                                {
                                                    <div class="placeholder-item" data-code="@item.PlaceholderCode">
                                                        <div class="fw-semibold">@item.DisplayName</div>
                                                        <small class="text-muted">@item.PlaceholderCode</small>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Editor -->
                        <div class="col-12 col-lg-9">
                            <textarea asp-for="Body" id="Body" class="form-control"></textarea>
                        </div>
                    </div>
                </div>

                <div class="form-check mt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">
                        @Localizer.Get("Active")
                    </label>
                </div>

            </div>

            <div class="card-footer d-flex flex-column flex-sm-row justify-content-sm-end gap-2">
                <button type="button" class="btn btn-info" id="btnPreview">
                    <i class="bi bi-eye"></i> @Localizer.Get("Preview")
                </button>

                <button type="button" class="btn btn-success" id="btnTestEmail">
                    <i class="bi bi-envelope"></i> @Localizer.Get("Send Test Email")
                </button>

                <button type="submit" class="btn btn-primary">
                    @Localizer.Get("Save")
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer.Get("Email Preview")</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <iframe id="previewFrame" style="width:100%;height:min(650px,70vh);border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Test Email Modal -->
<div class="modal fade" id="testEmailModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer.Get("Send Test Email")</h5>
            </div>
            <div class="modal-body">
                <label class="form-label">@Localizer.Get("Email Address")</label>
                <input type="email" id="txtEmail" class="form-control" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    @Localizer.Get("Close")
                </button>
                <button class="btn btn-success" id="btnSendEmail">
                    @Localizer.Get("Send")
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .placeholder-container {
        max-height: 520px;
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 5px;
    }

    .placeholder-category {
        background: #0d6efd;
        color: #fff;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .placeholder-item {
        border: 1px solid #e5e5e5;
        border-radius: 5px;
        padding: 6px 8px;
        margin-bottom: 5px;
        cursor: pointer;
        transition: .2s;
        background: #fff;
    }

        .placeholder-item:hover {
            background: #0d6efd;
            color: #fff;
            transform: translateX(3px);
        }

            .placeholder-item:hover small {
                color: #fff !important;
            }

    .ck-editor__editable {
        min-height: 520px;
    }

    /* Mobile / tablet tweaks */
    @@media (max-width: 991.98px) {
        .placeholder-container {
            max-height: 260px;
        }

        .ck-editor__editable {
            min-height: 320px;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
     <partial name="_ValidationScriptsPartial" />
    <script>
        let editor;

        ClassicEditor
            .create(document.querySelector('#Body'))
            .then(e => { editor = e; });

        $(document).on("click", ".placeholder-item", function () {
            var code = $(this).data("code");
            editor.model.change(writer => {
                editor.model.insertContent(writer.createText(code));
            });
        });

        $("#txtSearch").keyup(function () {
            var value = $(this).val().toLowerCase();
            $(".placeholder-item").each(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        $("#btnPreview").click(function () {
            var html = editor.getData();
            var iframe = document.getElementById("previewFrame");
            iframe.contentWindow.document.open();
            iframe.contentWindow.document.write(html);
            iframe.contentWindow.document.close();
            new bootstrap.Modal(document.getElementById("previewModal")).show();
        });

        $("#btnTestEmail").click(function () {
            new bootstrap.Modal(document.getElementById("testEmailModal")).show();
        });

        $("#btnSendEmail").click(function () {
            $.ajax({
                url: '/NotificationTemplate/SendTestEmail',
                type: 'POST',
                data: {
                    email: $("#txtEmail").val(),
                    subject: $("#Subject").val(),
                    body: editor.getData()
                },
                success: function (res) {
                    Swal.fire(
                        res.status == 1 ? "@Localizer.Get("Success")" : "@Localizer.Get("Error")",
                        res.message,
                        res.status == 1 ? "success" : "error"
                    );
                }
            });
        });
    </script>
}
