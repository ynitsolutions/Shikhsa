@model Shikhsa.ViewModels.NotificationPlaceholderVM

@{
    ViewData["Title"] = "Notification Placeholders";
}

<div class="container-fluid">

    <!-- SEARCH BAR -->
    <form method="get" asp-action="PlaceHolder" class="mb-3">
        <div class="row g-2">
            <div class="col-12 col-md-10">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer.Get("Search Placeholder..")" />
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button class="btn btn-primary">@Localizer.Get("Search")</button>
            </div>
        </div>
    </form>

    <!-- FORM (TOP) -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white">
            <strong>@Localizer.Get("Notification Placeholder")</strong>
        </div>

        <div class="card-body">
            <form asp-action="SavePlaceHolder" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Placeholder.NotificationPlaceholderId" type="hidden" />

                <div class="row g-3">

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Category")</label>
                        <select asp-for="Placeholder.NotificationCategoryId" class="form-select">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in Model.Categories)
                            {
                                <option value="@item.NotificationCategoryId">@item.CategoryName</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Placeholder Code")</label>
                        <input asp-for="Placeholder.PlaceholderCode" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Display Name")</label>
                        <input asp-for="Placeholder.DisplayName" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Sample Value")</label>
                        <input asp-for="Placeholder.SampleValue" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Display Order")</label>
                        <input asp-for="Placeholder.DisplayOrder" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Description")</label>
                        <textarea asp-for="Placeholder.Description" class="form-control" rows="1"></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="Placeholder.IsActive" class="form-check-input" />
                            <label class="form-check-label" asp-for="Placeholder.IsActive">@Localizer.Get("Active")</label>
                        </div>
                    </div>

                </div>

                <div class="mt-3 d-flex flex-column flex-sm-row gap-2">
                    <button class="btn btn-success px-4">@Localizer.Get("Save")</button>
                    <a asp-action="PlaceHolder" class="btn btn-secondary px-4">@Localizer.Get("Reset")</a>
                </div>
            </form>
        </div>
    </div>

    <!-- LIST (BOTTOM) -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <strong>Placeholder List</strong>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm align-middle mb-0 datatable">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer.Get("Category")</th>
                            <th>@Localizer.Get("Code")</th>
                            <th>@Localizer.Get("Display")</th>
                            <th>@Localizer.Get("Sample")</th>
                            <th>@Localizer.Get("Status")</th>
                            <th class="text-nowrap" style="width:150px;">@Localizer.Get("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Placeholders)
                        {
                            <tr>
                                <td>@item.NotificationCategory?.CategoryName</td>
                                <td>@item.PlaceholderCode</td>
                                <td>@item.DisplayName</td>
                                <td>@item.SampleValue</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">@Localizer.Get("Active")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@Localizer.Get("Inactive")</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.NotificationPlaceholderId"
                                       class="btn btn-warning btn-sm">@Localizer.Get("Edit")</a>

                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.NotificationPlaceholderId" />
                                        <button class="btn btn-danger btn-sm">@Localizer.Get("Delete")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>