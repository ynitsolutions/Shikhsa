@using Shikhsa.Models.Payment
@model SchoolMaster

@{
    ViewData["Title"] = "School Master";
}

<style>
    /* Vertical tabs layout */
    .school-tabs-wrap {
        min-height: 420px;
    }

    .school-tabs-nav {
        border-right: 1px solid var(--bs-border-color, #dee2e6);
        padding-right: .5rem;
    }

        .school-tabs-nav .nav-link {
            display: flex;
            align-items: center;
            gap: .6rem;
            text-align: left;
            color: var(--bs-body-color, #212529);
            border-radius: .4rem;
            margin-bottom: .35rem;
            padding: .6rem .75rem;
            white-space: normal;
        }

            .school-tabs-nav .nav-link i {
                width: 1.25rem;
                text-align: center;
                flex-shrink: 0;
            }

            .school-tabs-nav .nav-link.active {
                background-color: var(--bs-primary, #0d6efd);
                color: #fff;
            }

            .school-tabs-nav .nav-link:not(.active):hover {
                background-color: rgba(0,0,0,.05);
            }

    .school-tabs-content {
        padding-left: .75rem;
        min-width: 0;
    }

    /* Desktop: sticky sidebar */
    @@media (min-width: 768px) {
        .school-tabs-nav {
            position: sticky;
            top: 1rem;
            align-self: flex-start;
        }

        .school-tabs-content {
            padding-left: 1.25rem;
        }
    }

    /* Mobile: icon-only narrow sidebar so the form gets maximum width */
    @@media (max-width: 767.98px) {
        .school-tabs-nav {
            padding-right: .25rem;
        }

            .school-tabs-nav .nav-link {
                justify-content: center;
                padding: .75rem .5rem;
            }

                .school-tabs-nav .nav-link i {
                    font-size: 1.15rem;
                    width: auto;
                }

        .school-tabs-content {
            padding-left: .5rem;
        }
    }
</style>

<div class="container-fluid">

    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">
                <i class="fa fa-school"></i>
                @Localizer.Get("School Master")
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="SaveSchoolMasters"
                  method="post"
                  enctype="multipart/form-data"
                  id="schoolMasterForm">

                <input asp-for="SchoolId" type="hidden" />
                <input asp-for="LogoPath" type="hidden" />

                <div class="row g-0 school-tabs-wrap mb-3">

                    <!-- LEFT: Tab Headers (vertical) -->
                    <div class="col-auto col-md-3 col-lg-2 school-tabs-nav">
                        <div class="nav flex-column nav-pills" id="schoolTabs" role="tablist" aria-orientation="vertical">
                            <button class="nav-link active" id="tab-basic" data-bs-toggle="pill" data-bs-target="#pane-basic"
                                    type="button" role="tab" aria-controls="pane-basic" aria-selected="true"
                                    title="@Localizer.Get("Basic Information")">
                                <i class="fa fa-info-circle"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Basic Information")</span>
                            </button>
                            <button class="nav-link" id="tab-contact" data-bs-toggle="pill" data-bs-target="#pane-contact"
                                    type="button" role="tab" aria-controls="pane-contact" aria-selected="false"
                                    title="@Localizer.Get("Contact Information")">
                                <i class="fa fa-phone"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Contact Information")</span>
                            </button>
                            <button class="nav-link" id="tab-academic" data-bs-toggle="pill" data-bs-target="#pane-academic"
                                    type="button" role="tab" aria-controls="pane-academic" aria-selected="false"
                                    title="@Localizer.Get("Academic Information")">
                                <i class="fa fa-graduation-cap"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Academic Information")</span>
                            </button>
                            <button class="nav-link" id="tab-management" data-bs-toggle="pill" data-bs-target="#pane-management"
                                    type="button" role="tab" aria-controls="pane-management" aria-selected="false"
                                    title="@Localizer.Get("Management Information")">
                                <i class="fa fa-users"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Management Information")</span>
                            </button>
                            <button class="nav-link" id="tab-government" data-bs-toggle="pill" data-bs-target="#pane-government"
                                    type="button" role="tab" aria-controls="pane-government" aria-selected="false"
                                    title="@Localizer.Get("Government Information")">
                                <i class="fa fa-landmark"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Government Information")</span>
                            </button>
                            <button class="nav-link" id="tab-reports" data-bs-toggle="pill" data-bs-target="#pane-reports"
                                    type="button" role="tab" aria-controls="pane-reports" aria-selected="false"
                                    title="@Localizer.Get("Report & Certificate Settings")">
                                <i class="fa fa-file-alt"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Report & Certificate Settings")</span>
                            </button>
                            <button class="nav-link" id="tab-email" data-bs-toggle="pill" data-bs-target="#pane-email"
                                    type="button" role="tab" aria-controls="pane-email" aria-selected="false"
                                    title="@Localizer.Get("Email Configuration")">
                                <i class="fa fa-envelope"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Email Configurations")</span>
                            </button>
                            <button class="nav-link" id="tab-payment" data-bs-toggle="pill" data-bs-target="#pane-payment"
                                    type="button" role="tab" aria-controls="pane-payment" aria-selected="false"
                                    title="@Localizer.Get("Payment Gateway")">
                                <i class="fa fa-credit-card"></i>
                                <span class="d-none d-md-inline">@Localizer.Get("Payment Gateway")</span>
                            </button>
                        </div>
                    </div>

                    <!-- RIGHT: Tab Panes -->
                    <div class="col school-tabs-content">
                        <div class="tab-content" id="schoolTabsContent">

                            <!-- Basic Information -->
                            <div class="tab-pane fade show active" id="pane-basic" role="tabpanel" aria-labelledby="tab-basic" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Basic Information")</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("School Name")</label>
                                        <input asp-for="SchoolName" class="form-control required textspaceonly" />
                                        <span asp-validation-for="SchoolName" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("School Short Name")</label>
                                        <input asp-for="SchoolShortName" class="form-control required textspaceonly" />
                                        <span asp-validation-for="SchoolShortName" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Tag Line")</label>
                                        <input asp-for="TagLine" class="form-control required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("School Motto")</label>
                                        <input asp-for="SchoolMotto" class="form-control" />
                                    </div>
                                    <!-- Logo upload + preview -->
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("School Logo")</label>
                                        <input asp-for="SchoolLogo" type="file" class="form-control" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                                        {
                                            <img src="@Model.LogoPath" class="img-thumbnail mt-1" style="max-height:80px;" />
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Contact Information -->
                            <div class="tab-pane fade" id="pane-contact" role="tabpanel" aria-labelledby="tab-contact" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Contact Information")</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("School Address")</label>
                                        <textarea asp-for="SchoolAddress" rows="3" class="form-control required"></textarea>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("State")</label>
                                        <input asp-for="State" class="form-control required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("District")</label>
                                        <input asp-for="District" class="form-control required textspaceonly" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("City")</label>
                                        <input asp-for="City" class="form-control textspaceonly" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Pin Code")</label>
                                        <input asp-for="PinCode" class="form-control number-only required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Mobile Number")</label>
                                        <input asp-for="MobileContactNo" class="form-control indianmobile required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Land Line Number")</label>
                                        <input asp-for="LandlineNo" class="form-control required number-only" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Email")</label>
                                        <input asp-for="Email" type="email" class="form-control required " />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Website")</label>
                                        <input asp-for="Website" class="form-control required" />
                                    </div>
                                </div>
                            </div>

                            <!-- Academic Information -->
                            <div class="tab-pane fade" id="pane-academic" role="tabpanel" aria-labelledby="tab-academic" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Academic Information")</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Board")</label>
                                        <input asp-for="Board" class="form-control required textspaceonly" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Affiliation No")</label>
                                        <input asp-for="AffiliationNo" class="form-control required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Registration Code")</label>
                                        <input asp-for="RegistrationCode" class="form-control required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Initial Class")</label>
                                        <select asp-for="InitialClassId" asp-items="ViewBag.ClassList" class="form-select select2">
                                            <option value="">@Localizer.Get("Select Class")</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Academic Session Start Month")</label>
                                        <select asp-for="AcademicSessionStartMonth" class="form-select select2">
                                            <option value="1">@Localizer.Get("January")</option>
                                            <option value="2">@Localizer.Get("February")</option>
                                            <option value="3">@Localizer.Get("March")</option>
                                            <option value="4">@Localizer.Get("April")</option>
                                            <option value="5">@Localizer.Get("May")</option>
                                            <option value="6">@Localizer.Get("June")</option>
                                            <option value="7">@Localizer.Get("July")</option>
                                            <option value="8">@Localizer.Get("August")</option>
                                            <option value="9">@Localizer.Get("September")</option>
                                            <option value="10">@Localizer.Get("October")</option>
                                            <option value="11">@Localizer.Get("November")</option>
                                            <option value="12">@Localizer.Get("December")</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Management Information -->
                            <div class="tab-pane fade" id="pane-management" role="tabpanel" aria-labelledby="tab-management" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Management Information")</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Principal Name")</label>
                                        <input asp-for="PrincipalName" class="form-control textspaceonly" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Principal Mobile No")</label>
                                        <input asp-for="PrincipalMobileNo" class="form-control indianmobile required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Principal Email")</label>
                                        <input asp-for="PrincipalEmail" type="email" class="form-control required" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Manager Name")</label>
                                        <input asp-for="ManagerName" class="form-control textspaceonly" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Manager Mobile No")</label>
                                        <input asp-for="ManagerMobileNo" class="form-control indianmobile required" />
                                    </div>
                                </div>
                            </div>

                            <!-- Government Information -->
                            <div class="tab-pane fade" id="pane-government" role="tabpanel" aria-labelledby="tab-government" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Government Information")</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("UDISE Code")</label>
                                        <input asp-for="UDISECode" class="form-control required number-only" minlength="11" maxlength="11" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("PAN No")</label>
                                        <input asp-for="PANNo" class="form-control" pattern="[A-Z]{5}[0-9]{4}[A-Z]{1}" maxlength="10" placeholder="ABCDE1234F" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("GST No")</label>
                                        <input asp-for="GSTNo" class="form-control" pattern="[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}" maxlength="15" placeholder="22AAAAA0000A1Z5" />
                                    </div>
                                </div>
                            </div>

                            <!-- Report & Certificate Settings -->
                            <div class="tab-pane fade" id="pane-reports" role="tabpanel" aria-labelledby="tab-reports" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Report & Certificate Settings")</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Established Year")</label>
                                        <input asp-for="EstablishedYear" class="form-control number-only" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Recognition Text")</label>
                                        <textarea asp-for="RecognitionText" rows="2" class="form-control required"></textarea>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Report Card Footer Text")</label>
                                        <textarea asp-for="ReportCardFooterText" rows="3" class="form-control required"></textarea>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("TC Footer Text")</label>
                                        <textarea asp-for="TCFooterText" rows="3" class="form-control required"></textarea>
                                    </div>
                                </div>
                            </div>
                            <!-- Email -->
                            <div class="tab-pane fade" id="pane-email" role="tabpanel" aria-labelledby="tab-email" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Email Configurations")</h5>

                                <!-- NOTE: these inputs intentionally have no name attribute, so they are NOT posted with the main form. They are saved via AJAX (Save Email Setting button). -->
                                <input type="hidden" id="es-id" value="0" />
                                <div class="row g-3" id="emailSettingFormRow">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Provider")</label>
                                        <input type="text" id="es-provider" class="form-control" list="es-provider-list" maxlength="50" placeholder="Zoho / Gmail" />
                                        <datalist id="es-provider-list">
                                            <option value="Zoho"></option>
                                            <option value="Gmail"></option>
                                        </datalist>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Priority") <small class="text-muted">(1 = @Localizer.Get("used first"))</small></label>
                                        <input type="number" id="es-priority" class="form-control" min="1" value="1" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Host")</label>
                                        <input type="text" id="es-host" class="form-control" maxlength="200" placeholder="smtp.zoho.in" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Port")</label>
                                        <input type="number" id="es-port" class="form-control" min="1" max="65535" value="587" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("User Name")</label>
                                        <input type="text" id="es-username" class="form-control" maxlength="200" autocomplete="off" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Password")</label>
                                        <input type="password" id="es-password" class="form-control" maxlength="200" autocomplete="new-password" />
                                        <small class="text-muted" id="es-password-hint" style="display:none;">@Localizer.Get("Leave blank to keep existing password")</small>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("From Email")</label>
                                        <input type="email" id="es-fromemail" class="form-control" maxlength="200" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("From Name")</label>
                                        <input type="text" id="es-fromname" class="form-control" maxlength="200" placeholder="School ERP" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-check form-switch mt-md-4">
                                            <input class="form-check-input" type="checkbox" id="es-ssl" checked />
                                            <label class="form-check-label" for="es-ssl">@Localizer.Get("Enable SSL")</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-check form-switch mt-md-4">
                                            <input class="form-check-input" type="checkbox" id="es-active" checked />
                                            <label class="form-check-label" for="es-active">@Localizer.Get("Active")</label>
                                        </div>
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="button" class="btn btn-secondary btn-sm" id="es-reset">
                                            <i class="fa fa-undo"></i> @Localizer.Get("Reset")
                                        </button>
                                        <button type="button" class="btn btn-success btn-sm" id="es-save">
                                            <i class="fa fa-save"></i> @Localizer.Get("Save Email Setting")
                                        </button>
                                    </div>
                                </div>

                                <hr />

                                <h6 class="mb-2">@Localizer.Get("Configured Email Providers")</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@Localizer.Get("Priority")</th>
                                                <th>@Localizer.Get("Provider")</th>
                                                <th>@Localizer.Get("Host")</th>
                                                <th>@Localizer.Get("Port")</th>
                                                <th>@Localizer.Get("User Name")</th>
                                                <th>@Localizer.Get("From Email")</th>
                                                <th>@Localizer.Get("SSL")</th>
                                                <th>@Localizer.Get("Active")</th>
                                                <th>@Localizer.Get("Status")</th>
                                                <th class="text-nowrap">@Localizer.Get("Action")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.EmailSettings != null && Model.EmailSettings.Any())
                                            {
                                                @foreach (var es in Model.EmailSettings.OrderBy(x => x.Priority))
                                                {
                                                    <tr data-id="@es.EmailSettingId"
                                                        data-provider="@es.ProviderName"
                                                        data-priority="@es.Priority"
                                                        data-host="@es.Host"
                                                        data-port="@es.Port"
                                                        data-username="@es.UserName"
                                                        data-fromemail="@es.FromEmail"
                                                        data-fromname="@es.FromName"
                                                        data-ssl="@es.EnableSsl.ToString().ToLower()"
                                                        data-active="@es.IsEmailActive.ToString().ToLower()">
                                                        <td><span class="badge bg-primary">@es.Priority</span></td>
                                                        <td>@es.ProviderName</td>
                                                        <td>@es.Host</td>
                                                        <td>@es.Port</td>
                                                        <td>@es.UserName</td>
                                                        <td>@es.FromEmail</td>
                                                        <td>@(es.EnableSsl ? "Yes" : "No")</td>
                                                        <td>@(es.IsEmailActive ? "Yes" : "No")</td>
                                                        <td>@(es.IsActive ? "Active" : "InActive")</td>
                                                        <td class="text-nowrap">
                                                            <button type="button" class="btn btn-outline-primary btn-sm es-edit" title="@Localizer.Get("Edit")"><i class="fa fa-edit"></i></button>
                                                            <button type="button" class="btn btn-outline-danger btn-sm es-delete" title="@Localizer.Get("Delete")"><i class="fa fa-trash"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="9" class="text-center text-muted">@Localizer.Get("No email settings configured")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!--Payment Gateway-->
                            
                            @{
                                var paymentGateways = ViewBag.PaymentGateways as List<PaymentGatewaySetting> ?? new List<PaymentGatewaySetting>();
                            }
                            <div class="tab-pane fade" id="pane-payment" role="tabpanel" aria-labelledby="tab-payment" tabindex="0">
                                <h5 class="mb-3 d-md-none">@Localizer.Get("Payment Gateway")</h5>

                                @* inputs here have NO name attribute on purpose: they are saved by AJAX, not by the main School form *@
                                <input type="hidden" id="pg-id" value="0" />
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer.Get("Gateway Name")</label>
                                        <input type="text" id="pg-name" class="form-control" list="pg-name-list" maxlength="50" placeholder="Zoho / ATOM / ..." />
                                        <datalist id="pg-name-list">
                                            <option value="Zoho"></option>
                                        </datalist>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="d-flex flex-wrap gap-4 mt-md-4 pt-md-2">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="pg-active" checked />
                                                <label class="form-check-label" for="pg-active">@Localizer.Get("Active")</label>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="pg-default" />
                                                <label class="form-check-label" for="pg-default">@Localizer.Get("Default Gateway")</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                                            <label class="form-label mb-0">@Localizer.Get("Settings")</label>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-secondary" id="pg-load-zoho">
                                                    <i class="fa fa-magic"></i> @Localizer.Get("Zoho Template")
                                                </button>
                                                <button type="button" class="btn btn-outline-primary" id="pg-add-row">
                                                    <i class="fa fa-plus"></i> @Localizer.Get("Add Setting")
                                                </button>
                                            </div>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="min-width:160px;">@Localizer.Get("Key")</th>
                                                        <th style="min-width:220px;">@Localizer.Get("Value")</th>
                                                        <th class="text-center">@Localizer.Get("Secret")</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="pg-rows"></tbody>
                                            </table>
                                        </div>
                                        <small class="text-muted" id="pg-secret-hint" style="display:none;">@Localizer.Get("Leave a secret value blank to keep the saved one")</small>
                                    </div>

                                    <div class="col-12 text-end">
                                        <button type="button" class="btn btn-secondary btn-sm" id="pg-reset"><i class="fa fa-undo"></i> @Localizer.Get("Reset")</button>
                                        <button type="button" class="btn btn-primary btn-sm" id="pg-save"><i class="fa fa-save"></i> @Localizer.Get("Save Gateway")</button>
                                    </div>
                                </div>

                                <hr />

                                <h6 class="mb-2">@Localizer.Get("Configured Payment Gateways")</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@Localizer.Get("Gateway")</th>
                                                <th>@Localizer.Get("Default")</th>
                                                <th>@Localizer.Get("Active")</th>
                                                <th>@Localizer.Get("Settings")</th>
                                                <th class="text-nowrap">@Localizer.Get("Action")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (paymentGateways.Any())
                                            {
                                                @foreach (var g in paymentGateways)
                                                {
                                                    <tr data-id="@g.PaymentGatewaySettingId">
                                                        <td>@g.GatewayName</td>
                                                        <td>@(g.IsDefault ? "Yes" : "No")</td>
                                                        <td>@(g.IsActive ? "Yes" : "No")</td>
                                                        <td>@(g.Values.Any() ? g.Values.Count + " settings" : "Fixed columns")</td>
                                                        <td class="text-nowrap">
                                                            @if (g.Values.Any())
                                                            {
                                                                <button type="button" class="btn btn-outline-primary btn-sm pg-edit" title="@Localizer.Get("Edit")"><i class="fa fa-edit"></i></button>
                                                                <button type="button" class="btn btn-outline-danger btn-sm pg-delete" title="@Localizer.Get("Delete")"><i class="fa fa-trash"></i></button>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">@Localizer.Get("Managed separately")</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="5" class="text-center text-muted">@Localizer.Get("No payment gateways configured")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
               
                <!-- Submit Button (outside tabs, always visible, saves all tabs together) -->
                <div class="text-end">
                    <permission controller="Masters" action="SchoolMasters" type="create">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fa fa-save"></i>
                            @Localizer.Get("Save School Information")
                        </button>
                    </permission>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        var emailSettingUrls = {
            save: '@Url.Action("SaveEmailSetting", "Masters")',
            remove: '@Url.Action("DeleteEmailSetting", "Masters")'
        };
    </script>
    <script src="~/js/schoolMasterEmail.js" asp-append-version="true"></script>
    <script>
        var paymentGatewayUrls = {
            get: '@Url.Action("PaymentGateway", "Masters")',
            save: '@Url.Action("SavePaymentGateway", "Masters")',
            remove: '@Url.Action("DeletePaymentGateway", "Masters")'
        };
    </script>
    <script src="~/js/schoolMasterPayment.js" asp-append-version="true"></script>

    <script>
        (function () {
            const storageKey = 'schoolMasterActiveTab';
            const tabsEl = document.getElementById('schoolTabs');
            const form = document.getElementById('schoolMasterForm');
            if (!tabsEl || !form) { return; }

            function showTab(targetSelector = '') {
                const btn = document.querySelector('#schoolTabs [data-bs-target="' + targetSelector + '"]');
                if (btn instanceof HTMLElement) { btn.click(); }
            }

            // Restore last active tab (e.g. after save / reload)
            try {
                const saved = sessionStorage.getItem(storageKey);
                if (saved) { showTab(saved); }
            } catch (e) { }

            // Remember active tab
            tabsEl.addEventListener('shown.bs.tab', function (e) {
                const target = e.target;
                if (!(target instanceof HTMLElement)) { return; }
                try {
                    sessionStorage.setItem(storageKey, target.getAttribute('data-bs-target') || '');
                } catch (err) { }
            });

            // If validation fails, jump to the first tab containing an invalid field
            form.addEventListener('submit', function () {
                setTimeout(function () {
                    const invalid = form.querySelector('.input-validation-error, :invalid');
                    if (!(invalid instanceof HTMLElement)) { return; }
                    const pane = invalid.closest('.tab-pane');
                    if (pane) {
                        showTab('#' + pane.id);
                        invalid.focus();
                    }
                }, 0);
            });
        })();
    </script>



}
