@model SchoolMaster

@{
    ViewData["Title"] = "School Master";
}

<div class="container-fluid">

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="fa fa-school"></i>
                @Localizer.Get("School Master")
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="SaveSchoolMasters"
                  method="post"
                  enctype="multipart/form-data">

                <input asp-for="SchoolId" type="hidden" />
                <input asp-for="LogoPath" type="hidden" />

                <!-- Basic Information -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <strong>@Localizer.Get("Basic Information")</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="SchoolName" class="form-label"></label>
                                <input asp-for="SchoolName" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="SchoolShortName" class="form-label"></label>
                                <input asp-for="SchoolShortName" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="TagLine" class="form-label"></label>
                                <input asp-for="TagLine" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="SchoolMotto" class="form-label"></label>
                                <input asp-for="SchoolMotto" class="form-control" />
                            </div>
                            <!-- Logo upload + preview -->
                            <div class="col-12 col-md-9">
                                <label>@Localizer.Get("School Logo")</label>
                                <input asp-for="SchoolLogo" type="file" class="form-control" />
                            </div>
                            <div class="col-12 col-md-3">
                                @if (!string.IsNullOrEmpty(Model.LogoPath))
                                {
                                    <img src="@Model.LogoPath" class="img-thumbnail mt-1" style="max-height:80px;" />
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Information -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <strong>@Localizer.Get("Contact Information")</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="SchoolAddress"></label>
                                <textarea asp-for="SchoolAddress" rows="3" class="form-control"></textarea>
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="State"></label>
                                <input asp-for="State" class="form-control" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="District"></label>
                                <input asp-for="District" class="form-control" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="City"></label>
                                <input asp-for="City" class="form-control" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="PinCode"></label>
                                <input asp-for="PinCode" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="MobileContactNo"></label>
                                <input asp-for="MobileContactNo" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="LandlineNo"></label>
                                <input asp-for="LandlineNo" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Email"></label>
                                <input asp-for="Email" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Website"></label>
                                <input asp-for="Website" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Academic Information -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <strong>@Localizer.Get("Academic Information")</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="Board"></label>
                                <input asp-for="Board" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="AffiliationNo"></label>
                                <input asp-for="AffiliationNo" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="RegistrationCode"></label>
                                <input asp-for="RegistrationCode" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label>@Localizer.Get("Initial Class")</label>
                                <select asp-for="InitialClassId" asp-items="ViewBag.ClassList" class="form-select">
                                    <option value="">@Localizer.Get("Select Class")</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label>@Localizer.Get("Academic Session Start Month")</label>
                                <select asp-for="AcademicSessionStartMonth" class="form-select">
                                    <option value="1">@Localizer.Get("January")</option>
                                    <option value="2">@Localizer.Get("February")</option>
                                    <option value="3">@Localizer.Get("March")</option>
                                    <option value="4">@Localizer.Get("April")</option>
                                    <option value="5">@Localizer.Get("May")</option>
                                    <option value="6">@Localizer.Get("June")</option>
                                    <option value="7">@Localizer.Get("July")</option>
                                    <option value="8">@Localizer.Get("August")</option>
                                    <option value="9">@Localizer.Get("September")</option>
                                    <option value="10">@Localizer.Get("October")</option>
                                    <option value="11">@Localizer.Get("November")</option>
                                    <option value="12">@Localizer.Get("December")</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Management Information -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <strong>@Localizer.Get("Management Information")</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="PrincipalName"></label>
                                <input asp-for="PrincipalName" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="PrincipalMobileNo"></label>
                                <input asp-for="PrincipalMobileNo" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="PrincipalEmail"></label>
                                <input asp-for="PrincipalEmail" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ManagerName"></label>
                                <input asp-for="ManagerName" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ManagerMobileNo"></label>
                                <input asp-for="ManagerMobileNo" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Government Information -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <strong>@Localizer.Get("Government Information")</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="UDISECode"></label>
                                <input asp-for="UDISECode" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="PANNo"></label>
                                <input asp-for="PANNo" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="GSTNo"></label>
                                <input asp-for="GSTNo" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Report & Certificate Settings -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <strong>@Localizer.Get("Report & Certificate Settings")</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="EstablishedYear"></label>
                                <input asp-for="EstablishedYear" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="RecognitionText"></label>
                                <textarea asp-for="RecognitionText" rows="2" class="form-control"></textarea>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ReportCardFooterText"></label>
                                <textarea asp-for="ReportCardFooterText" rows="3" class="form-control"></textarea>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="TCFooterText"></label>
                                <textarea asp-for="TCFooterText" rows="3" class="form-control"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="text-end">
                    <permission controller="Masters" action="SchoolMasters" type="create">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fa fa-save"></i>
                            @Localizer.Get("Save School Information")
                        </button>
                    </permission>
                </div>

            </form>

        </div>
    </div>

</div>