@using Shikhsa.Data
@model Menu

@{
    var menuList = ViewBag.MenuList as List<Menu>;
    ViewData["Title"] = Localizer.Get("Menu Master");
}

<div class="container-fluid">
    <!-- FORM CARD -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h4 class="mb-0">@(Model.Id == 0 ? Localizer.Get("Add Menu") : Localizer.Get("Update Menu"))</h4>
                </div>
                <div class="card-body">
                    <form asp-action="SaveMenus" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <!-- Menu Name -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">@Localizer.Get("Menu Name")</label>
                                <input asp-for="Name" class="form-control" />
                            </div>

                            <!-- Controller Name (hidden) -->
                            <div class="col-12 col-md-6 col-lg-4" style="display:none">
                                <label class="form-label">@Localizer.Get("Controller Name")</label>
                                <input asp-for="ControllerName" class="form-control" />
                            </div>

                            <!-- Action Name (hidden) -->
                            <div class="col-12 col-md-6 col-lg-4" style="display:none">
                                <label class="form-label">@Localizer.Get("Action Name")</label>
                                <input asp-for="ActionName" class="form-control" />
                            </div>

                            <!-- Icon -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">@Localizer.Get("Icon")</label>
                                <input asp-for="Icon" class="form-control" placeholder="ti ti-home" />
                            </div>

                            <!-- Display Order -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">@Localizer.Get("Display Order")</label>
                                <input asp-for="DisplayOrder" class="form-control" />
                            </div>

                            <!-- Status -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">@Localizer.Get("Status")</label>
                                <select asp-for="IsActive" class="form-select select2">
                                    <option value="true">@Localizer.Get("Active")</option>
                                    <option value="false">@Localizer.Get("InActive")</option>
                                </select>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <permission controller="Masters" action="Menus" type="create">
                                <button type="submit" class="btn btn-success">
                                    @Localizer.Get("Save Menu")
                                </button>
                            </permission>
                            <button type="reset" class="btn btn-secondary">@Localizer.Get("Reset")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- LIST CARD -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">@Localizer.Get("Menu List")</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle datatable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@Localizer.Get("Menu")</th>
                                    <th>@Localizer.Get("Icon")</th>
                                    <th>@Localizer.Get("Order")</th>
                                    <th>@Localizer.Get("Status")</th>
                                    <th style="min-width:180px;">@Localizer.Get("Action")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (menuList != null && menuList.Any())
                                {
                                    int i = 1;
                                    foreach (var item in menuList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.Name</td>
                                            <td>
                                                <i class="@item.Icon"></i> @item.Icon
                                            </td>
                                            <td>@item.DisplayOrder</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">@Localizer.Get("Active")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@Localizer.Get("InActive")</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <permission controller="Masters" action="Menus" type="edit">
                                                        <a asp-action="Menus" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                                            @Localizer.Get("Edit")
                                                        </a>
                                                    </permission>
                                                    <permission controller="Masters" action="Menus" type="delete">
                                                        <a asp-action="DeleteMenu" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                                            @(item.IsActive ? Localizer.Get("InActive") : Localizer.Get("Active"))
                                                        </a>
                                                    </permission>
                                                </div>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">
                                            @Localizer.Get("No Record Found")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>