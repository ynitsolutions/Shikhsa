@model IEnumerable<Shikhsa.Models.DataList>

@{
    ViewData["Title"] = "Data List";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="mb-0">@Localizer.Get("Data List")</h5>
                        <permission controller="Masters" action="DataLIst" type="create">
                            <a asp-action="SaveDataLIst" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle"></i>
                                @Localizer.Get("New Data List")
                            </a>
                        </permission>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover datatable align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@Localizer.Get("List Name")</th>
                                    <th>@Localizer.Get("Description")</th>
                                    <th>@Localizer.Get("Total Items")</th>
                                    <th>@Localizer.Get("Status")</th>
                                    <th style="min-width:150px;">@Localizer.Get("Action")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    int i = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.DataListName</td>
                                            <td>@item.Description</td>
                                            <td>@item.DataListItems?.Count()</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">@Localizer.Get("Active")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@Localizer.Get("InActive")</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <permission controller="Masters" action="DataList" type="Edit">
                                                        <a asp-action="SaveDataList" asp-route-id="@item.DataListId" class="btn btn-warning btn-sm">
                                                            <i class="bi bi-pencil"></i> @Localizer.Get("Edit")
                                                        </a>
                                                    </permission>
                                                    <permission controller="Masters" action="DataList" type="Edit">
                                                        <a asp-action="DeleteDataList" asp-route-id="@item.DataListId" class="btn btn-info btn-sm">
                                                            @(item.IsActive ? Localizer.Get("InActive") : Localizer.Get("Active"))
                                                        </a>
                                                    </permission>
                                                </div>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">
                                            @Localizer.Get("No Record Found")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>