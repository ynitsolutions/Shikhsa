@using Shikhsa.ViewModels
@model BatchVM

@{
    var batchList = ViewBag.BatchList as List<Batches>;
}

<div class="container-fluid">
    <!-- Form Card -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            @using (Html.BeginForm("SaveBatches", "Masters", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.BatchId)

                
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Academic Year")</label>
                        @Html.TextBoxFor(x => x.AcademicYear, new { @class = "form-control" })
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Start Date")</label>
                        @Html.TextBoxFor(x => x.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("End Date")</label>
                        @Html.TextBoxFor(x => x.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>

                <hr />

                <!-- Row 2: Checkboxes -->
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(x => x.ActiveForRegistration, new { @class = "form-check-input" })
                            <label class="form-check-label">@Localizer.Get("Active For Registration")</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(x => x.ActiveForAdmission, new { @class = "form-check-input" })
                            <label class="form-check-label">@Localizer.Get("Active For Admission")</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(x => x.ActiveForPayment, new { @class = "form-check-input" })
                            <label class="form-check-label">@Localizer.Get("Active For Payment")</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(x => x.IsCurrentYear, new { @class = "form-check-input" })
                            <label class="form-check-label">@Localizer.Get("Current Academic Year")</label>
                        </div>
                    </div>
                </div>

                <hr />

                <!-- Buttons: stack on small screens -->
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        @(Model.BatchId == 0 ? Localizer.Get("Save") : Localizer.Get("Update"))
                    </button>
                    <a href="@Url.Action("Batches")" class="btn btn-secondary">
                        @Localizer.Get("Reset")
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- List Card -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle datatable">
                    <thead>
                        <tr>
                            <th>@Localizer.Get("Academic Year")</th>
                            <th class="text-center">@Localizer.Get("Registration")</th>
                            <th class="text-center">@Localizer.Get("Admission")</th>
                            <th class="text-center">@Localizer.Get("Payment")</th>
                            <th class="text-center">@Localizer.Get("Current Year")</th>
                            <th style="min-width:150px;">@Localizer.Get("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in batchList)
                        {
                            <tr>
                                <td>@item.AcademicYear</td>
                                <td class="text-center">
                                    <input type="checkbox" @(item.ActiveForRegistration ? "checked" : "") disabled />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" @(item.ActiveForAdmission ? "checked" : "") disabled />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" @(item.ActiveForPayment ? "checked" : "") disabled />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" @(item.IsCurrentYear ? "checked" : "") disabled />
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <permission controller="Masters" action="Batches" type="edit">
                                            <a href="@Url.Action("Batches", new { id = item.BatchId })" class="btn btn-warning btn-sm">
                                                @Localizer.Get("Edit")
                                            </a>
                                        </permission>
                                        <permission controller="Masters" action="Batches" type="delete">
                                            <a href="@Url.Action("DeleteBatches", new { id = item.BatchId })"
                                               onclick="return confirm('@Localizer.Get("Delete this record?")');"
                                               class="btn btn-danger btn-sm">
                                                @Localizer.Get("Delete")
                                            </a>
                                        </permission>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>