@using Shikhsa.ViewModels
@model SubjectMasterVM
@{
    ViewData["Title"] = "Subjects Master";
}

<div class="container-fluid">

    <!-- Subject Form -->
    <div class="card shadow-sm mb-3">
        <div class="card-header">
            <h5 class="mb-0">
                @(Model.Subject?.SubjectId > 0 ? Localizer.Get("Edit Subject") : Localizer.Get("Add Subject"))
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="SaveSubjectMaster" method="post">
                <input asp-for="Subject.SubjectId" type="hidden" />

                <div class="row g-3 align-items-end">
                    <!-- Subject Name -->
                    <div class="col-12 col-md-4 col-lg-3">
                        <label class="form-label">@Localizer.Get("Subject Name")</label>
                        <input asp-for="Subject.SubjectName" class="form-control required" placeholder="@Localizer.Get("Enter Subject Name")" />
                        <span asp-validation-for="Subject.SubjectName" class="text-danger"></span>
                    </div>

                    <!-- Language Subject Name -->
                    <div class="col-12 col-md-4 col-lg-3">
                        <label class="form-label">@Localizer.Get("Language Subject Name")</label>
                        <input asp-for="Subject.LanguageSubjectName" class="form-control" placeholder="@Localizer.Get("Enter Language Subject Name")" />
                    </div>

                    <!-- Is Language Subject -->
                    <div class="col-12 col-md-3 col-lg-2">
                        <label class="form-label">@Localizer.Get("Is Language Subject")</label>
                        <select asp-for="Subject.IsLanguageSubject" class="form-select select2">
                            <option value="false">@Localizer.Get("No")</option>
                            <option value="true">@Localizer.Get("Yes")</option>
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <div class="col-12 col-md-2 col-lg-3">
                        <permission controller="Masters" action="SubjectMaster" type="create">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="ti ti-device-floppy"></i>
                                @(Model.Subject?.SubjectId > 0 ? Localizer.Get("Update") : Localizer.Get("Save"))
                            </button>
                        </permission>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Subject List -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">@Localizer.Get("Subject List")</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle datatable">
                    <thead class="table-light">
                        <tr>
                            <th width="60">#</th>
                            <th>@Localizer.Get("Subject Name")</th>
                            <th>@Localizer.Get("Language Subject Name")</th>
                            <th>@Localizer.Get("Language Subject")</th>
                            <th style="min-width:100px;">@Localizer.Get("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SubjectList.Any())
                        {
                            foreach (var item in Model.SubjectList)
                            {
                                <tr>
                                    <td>@item.SubjectId</td>
                                    <td>@Localizer.Get(item.SubjectName)</td>
                                    <td>@(string.IsNullOrEmpty(item.LanguageSubjectName) ? "-" : Localizer.Get(item.LanguageSubjectName))</td>
                                    <td>
                                        @if (item.IsLanguageSubject)
                                        {
                                            <span class="badge bg-success">@Localizer.Get("Yes")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Localizer.Get("No")</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <permission controller="Masters" action="SubjectMaster" type="edit">
                                                <a asp-action="SubjectMaster" asp-route-id="@item.SubjectId" class="btn btn-warning btn-sm">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                            </permission>
                                            <permission controller="Masters" action="SubjectMaster" type="delete">
                                                <a asp-action="DeleteSubjectMaster" asp-route-id="@item.SubjectId" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            </permission>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    @Localizer.Get("No Records Found")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>