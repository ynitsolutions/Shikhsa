@model Shikhsa.ViewModels.ClassBatchSubjectVM
@{
    ViewData["Title"] = "Subject Class";
}

<div class="container-fluid">
    <!-- Form Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="SaveClassBatchSubjectMapping" method="post">
                <input asp-for="HeaderId" type="hidden" />

                <div class="row g-3">
                    <!-- Class -->
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Class")</label>
                        <select asp-for="ClassId" class="form-select select2">
                            <option value="">@Localizer.Get("Select Class")</option>
                            @foreach (var item in Model.Classes)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                    </div>

                    <!-- Batch -->
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Batch")</label>
                        <select asp-for="BatchId" class="form-select select2">
                            <option value="">@Localizer.Get("Select Batch")</option>
                            @foreach (var item in Model.Batches)
                            {
                                <option value="@item.BatchId">@item.AcademicYear</option>
                            }
                        </select>
                    </div>

                    <!-- Copy From Batch -->
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Copy From Batch")</label>
                        <select asp-for="CopyFromBatchId" class="form-select select2">
                            <option value="">@Localizer.Get("Select Batch")</option>
                            @foreach (var item in Model.Batches)
                            {
                                <option value="@item.BatchId">@item.AcademicYear</option>
                            }
                        </select>
                    </div>

                    <!-- Subjects (multi-select) -->
                    <div class="col-12">
                        <label class="form-label">@Localizer.Get("Subjects")</label>
                        <select asp-for="SubjectIds" class="form-select select2" multiple>
                            @foreach (var item in Model.Subjects)
                            {
                                <option value="@item.SubjectId">@item.SubjectName</option>
                            }
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-primary">
                                <i class="ti ti-device-floppy"></i>
                                @(Model.HeaderId > 0 ? Localizer.Get("Update") : Localizer.Get("Save"))
                            </button>
                            <a asp-action="ClassBatchSubjectMapping" class="btn btn-secondary">
                                @Localizer.Get("Reset")
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- List / Filter Card -->
    <div class="card shadow-sm">
        <!-- Filter Form -->
        <div class="card-body">
            <form method="get" class="mb-3">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Class")</label>
                        <select name="filterClassId" class="form-select select2">
                            <option value="">@Localizer.Get("All")</option>
                            @foreach (var item in Model.Classes)
                            {
                                if (Model.FilterClassId == item.DataListItemId)
                                {
                                    <option value="@item.DataListItemId" selected>@item.DataListItemText</option>
                                }
                                else
                                {
                                    <option value="@item.DataListItemId">@item.DataListItemText</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Batch")</label>
                        <select name="filterBatchId" class="form-select select2">
                            <option value="">@Localizer.Get("All")</option>
                            @foreach (var item in Model.Batches)
                            {
                                if (Model.FilterBatchId == item.BatchId)
                                {
                                    <option value="@item.BatchId" selected>@item.AcademicYear</option>
                                }
                                else
                                {
                                    <option value="@item.BatchId">@item.AcademicYear</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-primary">@Localizer.Get("Search")</button>
                            <a asp-action="ClassBatchSubjectMapping" class="btn btn-secondary">@Localizer.Get("Reset")</a>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle datatable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Localizer.Get("Class")</th>
                            <th>@Localizer.Get("Batch")</th>
                            <th>@Localizer.Get("Subjects")</th>
                            <th>@Localizer.Get("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sr = 1;
                        }
                        @foreach (var item in Model.ListData)
                        {
                            <tr>
                                <td>@sr</td>
                                <td>@item.ClassName</td>
                                <td>@item.BatchName</td>
                                <td>@item.Subjects</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <permission controller="Masters" action="ClassBatcheSubjectMapping" type="edit">
                                            <a asp-action="ClassBatchSubjectMapping" asp-route-headerId="@item.HeaderId" class="btn btn-warning btn-sm">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                        </permission>
                                        <permission controller="Masters" action="ClassBatcheSubjectMapping" type="edit">
                                            <a asp-action="DeleteClassBatchSubject" asp-route-id="@item.HeaderId" onclick="return confirm('Delete?')" class="btn btn-danger btn-sm">
                                                <i class="ti ti-trash"></i>
                                            </a>
                                        </permission>
                                    </div>
                                </td>
                            </tr>
                            sr++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>