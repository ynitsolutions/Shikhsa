@using Shikhsa.ViewModels
@model RolePermissionVM
@{
    ViewData["Title"] = "Role Permission Management";
}

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white">
        <h5 class="mb-0">Assign Permissions</h5>
    </div>

    <div class="card-body">

        <form asp-action="SaveRoleMenuPermission" method="post">

            <!-- FILTERS -->
            <div class="row">

                <!-- ROLE -->
                <div class="col-12 col-md-6 col-lg-4 mb-3">
                    <label class="form-label fw-semibold">Select Role</label>
                    <select asp-for="RoleId" class="form-select select2" id="RoleId">
                        <option value="">Select Role</option>
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Value" data-name="@role.Text">@role.Text</option>
                        }
                    </select>
                </div>

                <!-- STAFF (dynamic - sirf non-excluded roles ke liye dikhega) -->
                <div class="col-12 col-md-6 col-lg-4 mb-3" id="staffWrapper" style="display:none;">
                    <label class="form-label fw-semibold">Select Staff (optional)</label>
                    <select asp-for="UserId" class="form-select select2" id="UserId">
                        <option value="">-- Role Level (All Staff) --</option>
                    </select>
                    <small class="text-muted">Khaali chhodne par ye Role ke sabhi staff ke liye lagu hoga.</small>
                </div>

                <!-- MENU -->
                <div class="col-12 col-md-6 col-lg-4 mb-3">
                    <label class="form-label fw-semibold">Select Menu</label>
                    <select asp-for="MenuId" asp-items="Model.Menus" class="form-select select2" id="MenuId">
                        <option value="">Select Menu</option>
                    </select>
                </div>
                <!-- SUB MENU -->
