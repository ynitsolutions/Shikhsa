                    </select>
                </div> *@
                <div class="col-12 col-md-6 col-lg-4 mb-3">

                    <label class="form-label fw-semibold">

                        Select Sub Menu

                    </label>

                    <select id="SubMenuId"
                            asp-for="SubMenuId"
                            class="form-select">

                        <option value="">Select Sub Menu</option>

                    </select>

                </div>
                <div class="col-12 col-md-6 col-lg-4 mb-3">

                    <label class="form-label fw-semibold">

                        Select Tab

                    </label>

                    <select id="TabId"
                            asp-for="TabId"
                            class="form-select">

                        <option value="">Select Tab</option>

                    </select>

                </div>
                <!-- ADD NEW PERMISSION ITEM -->
                @* <div class="col-12 col-md-6 col-lg-4 mb-3 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addSubMenuModal">
                        <i class="ti ti-plus"></i> Add Permission Item
                    </button>
                </div> *@
                <div class="col-12 col-md-6 col-lg-4 mb-3 d-flex align-items-end">

                    <button type="button"
                            class="btn btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#menuModal">

                        <i class="ti ti-plus"></i>

                        Add Child

                    </button>

                </div>

            </div>

            <!-- SUBMENU PERMISSION TABLE -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    @* <thead class="table-light">
                        <tr>
                            <th width="35%">SubMenu</th>
                            <th class="text-center">View</th>
                            <th class="text-center">Create</th>
                            <th class="text-center">Update</th>
                            <th class="text-center">Delete</th>
                        </tr>
                    </thead> *@
                    <thead class="table-light">

                        <tr>

                            <th width="40%">
                                Name
                            </th>

                            <th class="text-center">
                                View
                            </th>

                            <th class="text-center">
                                Create
                            </th>

                            <th class="text-center">
                                Update
                            </th>

                            <th class="text-center">
                                Delete
                            </th>

                            <th width="120">
                                Action
                            </th>

                        </tr>

                    </thead>
                    <tbody id="permissionBody"></tbody>
                </table>
            </div>

            <!-- BUTTONS -->
            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy"></i> Save Permissions
                </button>
                <button type="reset" class="btn btn-secondary">
                    <i class="ti ti-refresh"></i> Reset
                </button>
            </div>

        </form>

    </div>
</div>

