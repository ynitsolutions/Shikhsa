<div class="modal fade"
     id="menuModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    Add Child

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="ParentId" />

                <div class="mb-3">

                    <label>Name</label>

                    <input id="ChildName"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label>Controller</label>

                    <input id="ControllerName"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label>Action</label>

                    <input id="ActionName"
                           class="form-control" />

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

                <button id="btnSaveChild"
                        type="button"
                        class="btn btn-primary">

                    Save

                </button>

            </div>

        </div>

    </div>

</div>
@section Scripts
{
    <script>

        const excludedRoles = ["Admin", "Developer", "YN IT Solutions"];

        //========================================
        // ROLE CHANGE
        //========================================

        $("#RoleId").change(function () {

            let roleId = $(this).val();
            let roleName = $("#RoleId option:selected").data("name");

            resetAll();

            if (!roleId)
                return;

            if (excludedRoles.includes(roleName)) {

                $("#staffWrapper").hide();

            }
            else {

                $("#staffWrapper").show();

                $.get('@Url.Action("GetStaffByRole")',
                    { roleId: roleId },
                    function (data) {

                        let html = '<option value="">-- Role Level (All Staff) --</option>';

                        $.each(data, function (i, item) {

                            html += `<option value="${item.value}">${item.text}</option>`;

                        });

                        $("#UserId").html(html);

                    });

            }

        });


        //========================================
        // MENU CHANGE
        //========================================

        $("#MenuId").change(function () {

            let menuId = $(this).val();

            $("#SubMenuId").html('<option value="">Select Sub Menu</option>');
            $("#TabId").html('<option value="">Select Tab</option>');
            $("#permissionBody").html("");

            if (!menuId)
                return;

            loadChildren(menuId, "#SubMenuId", "Select Sub Menu");

        });


        //========================================
        // SUBMENU CHANGE
        //========================================

        $("#SubMenuId").change(function () {
            debugger
            let subMenuId = $(this).val();

            $("#TabId").html('<option value="">Select Tab</option>');

            if (!subMenuId) {

                $("#permissionBody").html("");

                return;

            }

            $.get('@Url.Action("GetChildMenus")',
                { parentId: subMenuId },
                function (data) {

                    if (data.length == 0) {

                        loadPermission(subMenuId);

                        return;

                    }

                    let html = '<option value="">Select Tab</option>';

                    $.each(data, function (i, item) {

                        html += `<option value="${item.id}">${item.name}</option>`;

                    });

                    $("#TabId").html(html);

                });
                 loadPermission(subMenuId)

        });


        //========================================
        // TAB CHANGE
        //========================================

        $("#TabId").change(function () {

            let tabId = $(this).val();

            if (tabId)
                loadPermission(tabId);
            else
                $("#permissionBody").html("");

        });


        //========================================
        // STAFF CHANGE
        //========================================

        $("#UserId").change(function () {

            if ($("#TabId").val())
                loadPermission($("#TabId").val());

            else if ($("#SubMenuId").val())
                loadPermission($("#SubMenuId").val());

        });


        //========================================
        // LOAD CHILD
        //========================================

        function loadChildren(parentId, ddl, text) {

            $.get('@Url.Action("GetChildMenus")',
                { parentId: parentId },
                function (data) {

                    let html = `<option value="">${text}</option>`;

                    $.each(data, function (i, item) {

                        html += `<option value="${item.id}">${item.name}</option>`;

                    });

                    $(ddl).html(html);

                });

        loadPermission(parentId)
        }


        //========================================
        // LOAD PERMISSION
        //========================================

        function loadPermission(menuId) {
            debugger

            let roleId = $("#RoleId").val();

            let userId = $("#UserId").val() || "";

            if (!roleId || !menuId) {

                $("#permissionBody").html("");

                return;

            }

            $("#permissionBody").load(

                '@Url.Action("GetSubMenus")'

                + "?roleId=" + roleId

                + "&menuId=" + menuId

                + "&userId=" + userId

            );

        }


        //========================================
        // ADD CHILD
        //========================================

        $("#btnSaveChild").click(function () {

            let parentId = $("#TabId").val()
                || $("#SubMenuId").val()
                || $("#MenuId").val();

            if (!parentId) {

                alert("Please select Parent.");

                return;

            }

            $.post('@Url.Action("AddChildMenu")',
                {

                    parentId: parentId,

                    name: $("#ChildName").val(),

                    controllerName: $("#ControllerName").val(),

                    actionName: $("#ActionName").val()

                },
                function (res) {

                    if (!res.success) {

                        alert(res.message);

                        return;

                    }

                    $("#menuModal").modal("hide");

                    $("#ChildName").val("");
                    $("#ControllerName").val("");
                    $("#ActionName").val("");

                    if ($("#TabId").val()) {

                        loadChildren($("#SubMenuId").val(),
                            "#TabId",
                            "Select Tab");

                    }
                    else {

                        loadChildren($("#MenuId").val(),
                            "#SubMenuId",
                            "Select Sub Menu");

                    }

                });

        });


        //========================================
        // DELETE
        //========================================

        function deleteChild(id) {

            if (!confirm("Delete ?"))
                return;

            $.post('@Url.Action("DeleteChildMenu")',
                { id: id },
                function (res) {

                    if (!res.success) {

                        alert(res.message);

                        return;

                    }

                    if ($("#TabId").val())
                        loadPermission($("#TabId").val());

                    else if ($("#SubMenuId").val())
                        loadPermission($("#SubMenuId").val());

                });

        }


        //========================================
        // RESET
        //========================================

        function resetAll() {

            $("#permissionBody").html("");

            $("#UserId").html('<option value="">-- Role Level (All Staff) --</option>');

            $("#SubMenuId").html('<option value="">Select Sub Menu</option>');

            $("#TabId").html('<option value="">Select Tab</option>');

        }

    </script>
}