@model Shikhsa.ViewModels.DataListVM

@{
    ViewData["Title"] = "Create Data List";
}

<div class="container-fluid">

    <!-- FORM CARD -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h4 class="mb-0">
                        @(Model.DataList.DataListId == 0 ? Localizer.Get("Add Data List") : Localizer.Get("Update Data List"))
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="SaveDataList" method="post">

                        <!-- DataList header fields (hidden Id + Name / Description) -->
                        <div class="card p-3 mb-3">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <input asp-for="DataList.DataListId" type="hidden" />
                                    <label class="form-label">@Localizer.Get("List Name")</label>
                                    <input asp-for="DataList.DataListName" class="form-control" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">@Localizer.Get("Description")</label>
                                    <input asp-for="DataList.Description" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <!-- Items table -->
                        <div class="card p-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">@Localizer.Get("Items")</h5>
                                <button type="button" id="btnAdd" class="btn btn-primary btn-sm">
                                    @Localizer.Get("Add Row")
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover align-middle datatable" id="tblItems">
                                    <thead>
                                        <tr>
                                            <th>@Localizer.Get("Item Text")</th>
                                            <th>@Localizer.Get("Item Value")</th>
                                            <th>@Localizer.Get("Display Order")</th>
                                            <th style="min-width:100px;">@Localizer.Get("Active")</th>
                                            <th style="min-width:80px;">@Localizer.Get("Action")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Items.Count; i++)
                                        {
                                            bool isExisting = Model.Items[i].DataListItemId != 0;
                                            <tr>
                                                <td>
                                                    <input asp-for="Items[i].DataListItemText" class="form-control" />
                                                </td>
                                                <td>
                                                    <input asp-for="Items[i].DataListItemId" type="hidden" />
                                                    <input asp-for="Items[i].DataListItemValue" class="form-control" />
                                                </td>
                                                <td>
                                                    <input asp-for="Items[i].DisplayOrder" class="form-control" />
                                                </td>
                                                <td>
                                                    @if (isExisting)
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input toggleActive" type="checkbox" asp-for="Items[i].IsActive" />
                                                                <label class="form-check-label statusLabel">
                                                                    @(Model.Items[i].IsActive ? Localizer.Get("Active") : Localizer.Get("Inactive"))
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input asp-for="Items[i].IsActive" type="hidden" value="true" />
                                                        <span class="badge bg-info">@Localizer.Get("New")</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (isExisting)
                                                    {
                                                        <span class="text-muted small">—</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-danger btn-sm btnRemove">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-success">@Localizer.Get("Save")</button>
                                <a asp-action="DataList" class="btn btn-secondary">@Localizer.Get("Cancel")</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let index = @Model.Items.Count;

        $(document).ready(function() {
            $("#btnAdd").click(function() {
                let row = `
                            <tr>
                                <td>
                                    <input name="Items[${index}].DataListItemText" class="form-control" />
                                </td>
                                <td>
                                    <input name="Items[${index}].DataListItemValue" class="form-control" />
                                </td>
                                <td>
                                    <input name="Items[${index}].DisplayOrder" class="form-control" value="0" />
                                </td>
                                <td>
                                    <input type="checkbox" name="Items[${index}].IsActive" value="true" checked />
                                    <input type="hidden" name="Items[${index}].IsActive" value="false" />
                                    <span class="badge bg-info">@Localizer.Get("New")</span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm btnRemove">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </td>
                            </tr>`;
                $("#tblItems tbody").append(row);
                index++;
            });

            $(document).on("click", ".btnRemove", function() {
                $(this).closest("tr").remove();
            });
        });
    </script>
}