@using Shikhsa.Data
@model Menu

@{
    var subMenuList = ViewBag.SubMenuList as List<Menu>;
    ViewData["Title"] = Localizer.Get("Sub Menu Master");
}

<div class="container-fluid">

    <!-- FORM SECTION (full width, on top) -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        @(Model.Id == 0 ? Localizer.Get("Add SubMenu") : Localizer.Get("Update SubMenu"))
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="SaveSubMenus" method="post">
                        <input asp-for="Id" type="hidden" />

                        <div class="row g-3">
                            <!-- Parent Menu -->
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Localizer.Get("Parent Menu")</label>
                                <select asp-for="ParentId" asp-items="ViewBag.ParentMenus" class="form-select select2">
                                    <option value="">@Localizer.Get("Select Menu")</option>
                                </select>
                            </div>

                            <!-- SubMenu Name -->
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Localizer.Get("SubMenu Name")</label>
                                <input asp-for="Name" class="form-control" />
                            </div>

                            <!-- Controller Name -->
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Localizer.Get("Controller Name")</label>
                                <input asp-for="ControllerName" class="form-control" />
                            </div>

                            <!-- Action Name -->
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Localizer.Get("Action Name")</label>
                                <input asp-for="ActionName" class="form-control" />
                            </div>

                            <!-- Icon -->
                            <div class="col-12 col-md-2">
                                <label class="form-label">@Localizer.Get("Icon")</label>
                                <input asp-for="Icon" class="form-control" placeholder="ti ti-user" />
                            </div>

                            <!-- Display Order -->
                            <div class="col-12 col-md-2">
                                <label class="form-label">@Localizer.Get("Display Order")</label>
                                <input asp-for="DisplayOrder" class="form-control" />
                            </div>

                            <!-- Status -->
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Localizer.Get("Status")</label>
                                <select asp-for="IsActive" class="form-select select2">
                                    <option value="true">@Localizer.Get("Active")</option>
                                    <option value="false">@Localizer.Get("InActive")</option>
                                </select>
                            </div>

                            <!-- Buttons -->
                            <div class="col-12 d-flex flex-wrap gap-2 mt-2">
                                <permission controller="Masters" action="SubMenus" type="create">
                                    <button type="submit" class="btn btn-success">
                                        @(Model.Id == 0 ? Localizer.Get("Save") : Localizer.Get("Update"))
                                    </button>
                                </permission>
                                @if (Model.Id > 0)
                                {
                                    <a asp-action="SubMenus" class="btn btn-secondary">@Localizer.Get("Cancel")</a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- LIST SECTION (full width, below form) -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">@Localizer.Get("SubMenu List")</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tblSubMenu" class="table table-bordered table-hover align-middle datatable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@Localizer.Get("Parent Menu")</th>
                                    <th>@Localizer.Get("SubMenu")</th>
                                    <th>@Localizer.Get("URL")</th>
                                    <th>@Localizer.Get("Icon")</th>
                                    <th>@Localizer.Get("Order")</th>
                                    <th>@Localizer.Get("Status")</th>
                                    <th class="text-nowrap" style="min-width:150px;">@Localizer.Get("Action")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (subMenuList != null && subMenuList.Any())
                                {
                                    int i = 1;
                                    foreach (var item in subMenuList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@Localizer.Get(item.Parent?.Name)</td>
                                            <td>@Localizer.Get(item.Name)</td>
                                            <td style="max-width:250px; word-break:break-word;">
                                                @item.ControllerName/@item.ActionName
                                            </td>
                                            <td class="text-nowrap">
                                                <i class="@item.Icon"></i> @item.Icon
                                            </td>
                                            <td>@item.DisplayOrder</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">@Localizer.Get("Active")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@Localizer.Get("InActive")</span>
                                                }
                                            </td>
                                            <td class="text-nowrap">
                                                <div class="d-flex flex-wrap gap-1">
                                                    <permission controller="Masters" action="SubMenus" type="edit">
                                                        <a asp-action="SubMenus" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                                            @Localizer.Get("Edit")
                                                        </a>
                                                    </permission>
                                                    <permission controller="Masters" action="SubMenus" type="delete">
                                                        <a asp-action="DeleteSubMenus" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                                            @(item.IsActive ? Localizer.Get("InActive") : Localizer.Get("Active"))
                                                        </a>
                                                    </permission>
                                                </div>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">
                                            @Localizer.Get("No Record Found")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>