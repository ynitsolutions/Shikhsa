@model Shikhsa.Models.Certificates
@{
    bool preview = ViewData["Preview"] as bool? ?? false;

    string Slot(string key, string? value, string format = "")
    {
        if (preview)
        {
            return $"<span data-slot=\"{key}\">________________</span>";
        }

        if (format == "date" && !string.IsNullOrEmpty(value) && DateTime.TryParse(value, out var d))
        {
            value = d.ToString("dd MMM yyyy");
        }

        return System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(value) ? "________________" : value);
    }

    string DateVal(DateTime? d) => d.HasValue ? d.Value.ToString("dd MMM yyyy") : "";
}

<h1>Good Samaritan School</h1>
<p class="school-sub">Near Sector-8, Jasola, New Delhi-25</p>
<p class="school-sub">(Recognized by Directorate of Education) School ID No. 1925346</p>
<p class="school-sub">(Affiliated to C.B.S.E. New Delhi) Affiliation No. 2730569</p>

<div class="cert-title">CHARACTER CERTIFICATE</div>

<p style="font-size:14px; line-height:2; text-align:justify; margin-top:26px;">
    This is to certify that <strong>@Html.Raw(Slot("student_name", Model?.StudentName))</strong>,
    Son/Daughter of <strong>@Html.Raw(Slot("father_name", Model?.FatherName))</strong>,
    was a bonafide student of this school in Class <strong>@Html.Raw(Slot("last_class_words", Model?.LastClassWords))</strong>
    from <strong>@Html.Raw(Slot("first_admission_date", DateVal(Model?.FirstAdmissionDate)))</strong>
    to <strong>@Html.Raw(Slot("issue_date", DateVal(Model?.IssueDate)))</strong>.
</p>

<p style="font-size:14px; line-height:2; text-align:justify;">
    During this period, his/her general conduct and moral character were found to be
    <strong>@Html.Raw(Slot("general_conduct", Model?.GeneralConduct))</strong>.
</p>

<p style="font-size:14px; line-height:2; text-align:justify;">
    This certificate is issued on request for the purpose of
    <strong>@Html.Raw(Slot("purpose_of_issue", Model?.PurposeOfIssue))</strong>.
</p>

@if (preview)
{
    <p style="font-size:14px; line-height:2; text-align:justify;">@Html.Raw(Slot("character_remarks", Model?.CharacterRemarks))</p>
}
else if (!string.IsNullOrWhiteSpace(Model?.CharacterRemarks))
{
    <p style="font-size:14px; line-height:2; text-align:justify;">@Model.CharacterRemarks</p>
}

<div class="reg-row" style="margin-top:20px;">
    <span>Date of Issue: @Html.Raw(Slot("issue_date", DateVal(Model?.IssueDate)))</span>
</div>

<div class="sign-row">
    <div>Class Teacher</div>
    <div>&nbsp;</div>
    <div>Principal<br />SEAL</div>
</div>
