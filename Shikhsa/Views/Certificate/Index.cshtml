@model List<Shikhsa.Models.Certificates>
@{
    string type = ViewBag.Type as string ?? "tc";
    ViewData["Title"] = type == "tc" ? "Transfer Certificates" : "Character Certificates";
}

<div style="max-width:900px; margin:24px auto; font-family:sans-serif;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h2>@(type == "tc" ? "Transfer Certificates" : "Character Certificates")</h2>
        <a asp-action="Create" asp-route-type="@type"
           style="background:#2563eb;color:#fff;padding:8px 14px;border-radius:6px;text-decoration:none;font-size:14px;">
            + New @type.ToUpper()
        </a>
    </div>

    <table style="width:100%; border-collapse:collapse; font-size:14px;">
        <thead>
            <tr style="text-align:left; border-bottom:2px solid #e5e7eb;">
                <th style="padding:8px;">Admission No.</th>
                <th style="padding:8px;">Student Name</th>
                <th style="padding:8px;">Issue Date</th>
                <th style="padding:8px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" style="padding:16px;text-align:center;color:#6b7280;">No certificates issued yet.</td></tr>
            }
            else
            {
                foreach (var cert in Model)
                {
                    <tr style="border-bottom:1px solid #f0f0f0;">
                        <td style="padding:8px;">@(cert.AdmissionNo ?? "-")</td>
                        <td style="padding:8px;">@cert.StudentName</td>
                        <td style="padding:8px;">@(cert.IssueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td style="padding:8px;">
                            <a asp-action="Print" asp-route-id="@cert.Id">View / Print</a>
                            &nbsp;|&nbsp;
                            <form asp-action="Delete" asp-route-id="@cert.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Delete this certificate?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" style="border:none;background:none;color:#dc2626;cursor:pointer;">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
