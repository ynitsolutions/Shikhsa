@model Shikhsa.ViewModels.DataFilter.StudentReportPageVM

<div class="container-fluid mt-4">
    <h3 class="mb-3">@Localizer.Get("Student Credentials")</h3>

    <form asp-action="StudentsCredentials" method="post" class="card p-3 bg-light shadow-sm">
        <div class="row g-2 g-md-3">

            

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Student Name")</label>
                <input asp-for="Filter.StudentName" class="form-control form-control-sm" />
            </div>

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Father Name")</label>
                <input asp-for="Filter.FatherName" class="form-control form-control-sm" />
            </div>

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Mother Name")</label>
                <input asp-for="Filter.MotherName" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("User Name")</label>
                <input asp-for="Filter.MotherName" class="form-control form-control-sm" />
            </div>

            

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Email")</label>
                <input asp-for="Filter.Email" class="form-control form-control-sm" />
            </div>

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Class")</label>
                <select asp-for="Filter.RegClassId" class="form-control form-control-sm select2">
                    <option value="">@Localizer.Get("Select")</option>
                    @foreach (var item in ViewBag.ClassList)
                    {
                        <option value="@item.DataListItemId">@item.DataListItemText</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Section")</label>
                <select asp-for="Filter.SectionId" class="form-control form-control-sm select2">
                    <option value="">@Localizer.Get("Select")</option>
                    @foreach (var item in ViewBag.SectionList)
                    {
                        <option value="@item.DataListItemId">@item.DataListItemText</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Batch")</label>
                <select asp-for="Filter.AdmissionBatchId" class="form-control form-control-sm select2">
                    <option value="">@Localizer.Get("Select")</option>
                    @foreach (var item in ViewBag.BatchList)
                    {
                        <option value="@item.BatchId">@item.AcademicYear</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <label>@Localizer.Get("Status")</label>
                <select asp-for="Filter.StatusId" class="form-control form-control-sm select2">
                    <option value="">@Localizer.Get("Select")</option>
                    @foreach (var item in ViewBag.StatusList)
                    {
                        <option value="@item.DataListItemId">@item.DataListItemText</option>
                    }
                </select>
            </div>

            <!-- Removed action buttons from here -->
        </div>

        <div class="text-end mt-3">
            <a asp-action="Index" class="btn btn-sm btn-secondary">@Localizer.Get("Clear")</a>
            <button type="submit" class="btn btn-sm btn-primary px-4">@Localizer.Get("Search")</button>
        </div>
    </form>

    <!-- Grid Layout -->
    <div class="table-responsive mt-4 card p-2">
        <table class="table table-sm table-striped table-bordered text-nowrap datatable">
            <thead>
                <tr>
                  
                    <th>@Localizer.Get("Student Name")</th>
                    <th>@Localizer.Get("Class")</th>
                    <th>@Localizer.Get("Father Name")</th>
                    <th>@Localizer.Get("Mother Name")</th>
                    <th>@Localizer.Get("Email")</th>
                    <th>@Localizer.Get("UserName")</th>
                    <th>@Localizer.Get("Password")</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Students != null && Model.Students.Any())
                {
                    foreach (var student in Model.Students)
                    {
                        <tr>
                           
                            <td>@student.StudentName</td>
                            <td>@student.ClassName (@student.SectionName)</td>
                            <td>@student.FatherName</td>
                            <td>@student.MotherName</td>
                            
                            <td>@student.Email</td>
                            <td>@student.UserName</td>
                            <td>@student.Password</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">@Localizer.Get("No Records found.")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
