@using Shikhsa.ViewModels.DataFilter
@model StudentReportPageVM

@{
    ViewData["Title"] = "Student Promotion List";
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" asp-action="StudentPromotions">

                <!-- Filter Fields (responsive grid) -->
                <div class="row g-3">
                    <div class="col-12 col-md-4 col-lg-2">
                        <label class="form-label">@Localizer.Get("Application No")</label>
                        <input asp-for="Filter.ApplicationNo" class="form-control" />
                    </div>

                    <div class="col-12 col-md-4 col-lg-2">
                        <label class="form-label">@Localizer.Get("Student Name")</label>
                        <input asp-for="Filter.StudentName" class="form-control" />
                    </div>

                    <div class="col-12 col-md-4 col-lg-2">
                        <label class="form-label">@Localizer.Get("Father Name")</label>
                        <input asp-for="Filter.FatherName" class="form-control" />
                    </div>

                    <div class="col-12 col-md-4 col-lg-2">
                        <label class="form-label">@Localizer.Get("Mother Name")</label>
                        <input asp-for="Filter.MotherName" class="form-control" />
                    </div>

                    <div class="col-12 col-md-4 col-lg-2">
                        <label class="form-label">@Localizer.Get("Class")</label>
                        <select asp-for="Filter.RegClassId" class="form-control select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.ClassList)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-lg-2">
                        <label class="form-label">@Localizer.Get("Section")</label>
                        <select asp-for="Filter.SectionId" class="form-control select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.SectionList)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-lg-2">
                        <label class="form-label">@Localizer.Get("Batch")</label>
                        <select asp-for="Filter.AdmissionBatchId" class="form-control select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.BatchList)
                            {
                                <option value="@item.BatchId">@item.AcademicYear</option>
                            }
                        </select>
                    </div>

                    <!-- Action Buttons (responsive) -->
                    <div class="col-12 col-md-12 col-lg-4 d-flex flex-wrap align-items-end gap-2">
                        <button type="submit" class="btn btn-primary" title="@Localizer.Get("Search")">
                            <i class="ti ti-search"></i> @Localizer.Get("Search")
                        </button>

                        <button type="submit" formaction="@Url.Action("ExportExcel")" class="btn btn-success" title="@Localizer.Get("Export to Excel")">
                            <i class="ti ti-download"></i> @Localizer.Get("Export")
                        </button>

                        <button type="button" class="btn btn-info" id="btnBulkStatus" title="@Localizer.Get("Bulk Promote")">
                            <i class="ti ti-reload"></i> @Localizer.Get("Bulk Promote")
                        </button>
                    </div>
                </div>

                <hr />

                <!-- Grid Container (responsive table will be inside partial) -->
                <div id="gridContainer">
                    @await Html.PartialAsync("_StudentPromotions", Model)
                </div>

            </form>
        </div>
    </div>
</div>

<!-- Promotion Modal (if not already defined in layout or partial, include it here) -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer.Get("Promote Students")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="StudentIds" />

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Class")</label>
                        <select id="ClassId" class="form-select select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.ClassList)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Section")</label>
                        <select id="SectionId" class="form-select select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.SectionList)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer.Get("Batch")</label>
                        <select id="BatchId" class="form-select select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.BatchList)
                            {
                                <option value="@item.BatchId">@item.AcademicYear</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer.Get("Close")</button>
                <button type="button" class="btn btn-primary" id="btnSaveStatus">@Localizer.Get("Promote")</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('change', '#chkAll', function() {
            $('.student-checkbox').prop('checked', $(this).prop('checked'));
        });

        $(document).on('change', '.student-checkbox', function() {
            $('#chkAll').prop(
                'checked',
                $('.student-checkbox:checked').length === $('.student-checkbox').length
            );
        });

        // Single student promote (from the table action button)
        $(".btnStatus").click(function() {
            var studentId = $(this).data("studentid");
            $("#StudentIds").val(studentId);
            var modal = new bootstrap.Modal(document.getElementById('statusModal'));
            modal.show();
        });

        // Bulk promote
        $("#btnBulkStatus").click(function() {
            var ids = [];
            $("input[name='selectedStudents']:checked").each(function() {
                ids.push($(this).val());
            });
            if (ids.length == 0) {
                alert("@Localizer.Get("Select student first")");
                return;
            }
            $("#StudentIds").val(ids.join(','));
            var modal = new bootstrap.Modal(document.getElementById('statusModal'));
            modal.show();
        });

        // Save promotion
        $("#btnSaveStatus").click(function() {
            $.ajax({
                url: '/Students/PromoteStudents',
                type: 'POST',
                data: {
                    StudentIds: $("#StudentIds").val(),
                    ClassId: $("#ClassId").val(),
                    SectionId: $("#SectionId").val(),
                    BatchId: $("#BatchId").val()
                },
                success: function(res) {
                    if (res.success) {
                        alert("@Localizer.Get("Saved Successfully!")");
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        // Re‑initialise Select2 inside modal
        // $('#statusModal').on('shown.bs.modal', function() {
        //     $('#ClassId, #SectionId, #BatchId').select2({
        //         dropdownParent: $('#statusModal'),
        //         width: '100%'
        //     });
        // });
    </script>
}