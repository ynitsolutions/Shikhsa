                                    <option value="@item.DataListItemId">
                                        @item.DataListItemText
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="RegClassId" class="text-danger"></span>

                        </div>
                        <div class="col-12 col-md-6 col-lg-4">

                            <label class="form-label d-block">

                                @Localizer.Get("Is Handicap") ?

                            </label>

                            <div class="form-check form-switch">

                                <input asp-for="IsHandicap" class="form-check-input" type="checkbox" id="IsHandicap" />

                                <label class="form-check-label" for="IsHandicap">

                                    @Localizer.Get("Yes")

                                </label>

                            </div>

                        </div>
                        <div class="col-12 col-md-6 col-lg-4"
