                                @Localizer.Get("Handicap Details")

                            </label>

                            <input asp-for="HandicapDetails"class="form-control" maxlength="250" placeholder="Specify handicap details" />

                            <span asp-validation-for="HandicapDetails" class="text-danger"></span>

                        </div>
                        <!--Transport-->
                        <div class="col-12 col-md-6 col-lg-4">

                            <label class="form-label d-block">

                                @Localizer.Get("Tranport Facility") ?

                            </label>

                            <div class="form-check form-switch">

                                <input asp-for="IsTranspot" class="form-check-input" type="checkbox" id="IsTranspot" />

                                <label class="form-check-label" for="IsTranspot">

                                    @Localizer.Get("Yes")

                                </label>

                            </div>

                        </div>
                        <div class="col-12 col-md-6 col-lg-4"
