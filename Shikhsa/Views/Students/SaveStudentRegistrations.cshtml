@model Tbl_StudentsRegistrations
@{

    ViewData["Title"] = @Localizer.Get("Students Registration");
    var docs = ViewBag.Documents as List<Tbl_StudentDocument>;

}
<form asp-action="SaveStudentRegistrations" enctype="multipart/form-data" method="post" onsubmit="return ValidateStudentForm();">

    <input asp-for="StudentId" type="hidden" />

    <div class="card">

        <div class="card-header">
            <permission controller="Students" action="StudentRegistrations" type="create">

           <button type="submit" class="btn btn-primary">
    <i class="ti ti-device-floppy fs-3"></i>
    </button>
    </permission>
         @*    <button type="submit" class="btn btn-success">Save </button> *@
            <permission controller="Students" action="StudentRegistrations" type="view">
                <a asp-action="SaveStudentRegistrations" class="btn btn-secondary"> Back </a>
            </permission>
        </div>

        <div class="card-body">

            <ul class="nav nav-tabs">

                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#tabStudent">Student Details </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       data-bs-toggle="tab"
                       href="#tabParent">
                          @Localizer.Get("Parent Details")
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       data-bs-toggle="tab"
                       href="#tabPrevious" id="previousSchoolTabLi">
                          @Localizer.Get("Previous School")
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       data-bs-toggle="tab"
                       href="#tabDocuments">
                          @Localizer.Get("Documents")
                    </a>
                </li>

            </ul>

            <div class="tab-content mt-3">
                <div class="tab-pane fade show active"
                     id="tabStudent">

                    <div class="row">

                        <div class="col-md-4">
                            <label>  @Localizer.Get("First Name")</label>
                            <input asp-for="FirstName" class="form-control text-only required" />
                        </div>

                        <div class="col-md-4">
                            <label>  @Localizer.Get("Middle Name")</label>
                            <input asp-for="MiddleName"
                                   class="form-control text-only" />
                        </div>

                        <div class="col-md-4">
                            <label>  @Localizer.Get("Last Name")</label>
                            <input asp-for="LastName"
                                   class="form-control text-only required" />
                        </div>

                        @*  <div class="col-md-4 mt-2">
                            <label>DOB *</label>
                            <div class="input-group datepicker">
                                <input asp-for="DOB" class="form-control datepicker required" type="text" data-input />
                                <span class="input-group-text" data-toggle style="height: auto; align-self: stretch;">
                                    <i class="ti ti-calendar"></i>
                                </span>
                            </div>

                          
                        </div> *@
                        <div class="col-md-4 mt-2">
                            <label>  @Localizer.Get("DOB") </label>
                            <div class="input-group fp-date">

                                <input asp-for="DOB"
                                       class="form-control"
                                       type="text"
                                       data-input />

                                <span class="input-group-text" data-toggle style="height: auto; align-self: stretch;">
                                    <i class="ti ti-calendar"></i>
                                </span>

                            </div>
                        </div>
                        <div class="col-md-4 mt-2">

                            <label>  @Localizer.Get("Gender")</label>

                            <select asp-for="GenderId"
                                    class="form-control select2 required">

                                <option value="">Select</option>

                                @foreach (var item in ViewBag.GenderList)
                                {
                                    <option value="@item.DataListItemId">
                                        @item.DataListItemText
                                    </option>
                                }

                            </select>

                        </div>
                        <div class="col-md-4 mt-2">
                            <label>  @Localizer.Get("Email")</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>

                        <div class="col-md-4 mt-2">
                            <label>  @Localizer.Get("Contact No")</label>
                            <input asp-for="ContactNo" maxlength="10" class="form-control required" />
                        </div>

                        <div class="col-md-4 mt-2">
                            <label> @Localizer.Get("Aadhaar")</label>
                            <input asp-for="AadhaarNumber"
                                   maxlength="12"
                                   class="form-control" />
                        </div>

                        <div class="col-md-4 mt-2">
                            <label> @Localizer.Get("APAAR")</label>
                            <input asp-for="APAARId"
                                   maxlength="12"
                                   class="form-control" />
                        </div>

                        <div class="col-md-4 mt-2">
                            <label> @Localizer.Get("PEN")</label>
                            <input asp-for="PENNumber"
                                   maxlength="14"
                                   class="form-control" />
                        </div>
                        <div class="col-12 mt-2">

                            <div class="form-check">

                                <input type="checkbox"
                                       class="form-check-input"
                                       id="chkSameAddress" />

                                <label class="form-check-label"
                                       for="chkSameAddress">

                                     @Localizer.Get("Permanent Address Same As Local Address")

                                </label>

                            </div>

                        </div>

                        <div class="col-md-6 mt-2">
                            <label> @Localizer.Get("Local Address")</label>
                            <textarea asp-for="LocalAddress" class="form-control required"></textarea>
                        </div>

                        <div class="col-md-6 mt-2">
                            <label>@Localizer.Get("Permanent Address")</label>
                            <textarea asp-for="PermanentAddress" class="form-control required"></textarea>
                        </div>

                        <div class="col-md-4 mt-2">

                            <label>@Localizer.Get("Category")</label>

                            <select asp-for="CategoryId"
