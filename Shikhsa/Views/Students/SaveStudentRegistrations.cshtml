                                }

                            </select>
                            <span asp-validation-for="HostelId" class="text-danger"></span>

                        </div>
                        <!-- Identification Mark -->

                        <div class="col-12 col-md-6 col-lg-4">

                            <label asp-for="IdentificationMark"
