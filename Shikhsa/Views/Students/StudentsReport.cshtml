@using Shikhsa.ViewModels.DataFilter


@model StudentReportPageVM

@{
    ViewData["Title"] = "Students Report";
    var cols = Model.Filter.SelectedColumns ??
                 new List<string>();
}

<div class="card">


    <div class="card-body">

        <form method="post" asp-action="StudentsReport">

            <div class="row">

                <div class="col-md-2">
                    <label>Application No</label>
                    <input asp-for="Filter.ApplicationNo"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label>Student Name</label>
                    <input asp-for="Filter.StudentName"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label>Father Name</label>
                    <input asp-for="Filter.FatherName"
                           class="form-control" />
                </div>
                <div class="col-md-2">
                    <label>Mother Name</label>
                    <input asp-for="Filter.MotherName"
                           class="form-control" />
                </div>
                <div class="col-md-2">
                    <label>Guardian Name</label>
                    <input asp-for="Filter.GuardianName"
                           class="form-control" />
                </div>
                <div class="col-md-2">
                    <label>Mobile</label>
                    <input asp-for="Filter.MobileNo"
                           class="form-control" />
                </div>
                <div class="col-md-2">

                    <label>Class</label>

                    <select asp-for="Filter.RegClassId"
                            class="form-control select2">

                        <option value="">Select</option>

                        @foreach (var item in ViewBag.ClassList)
                        {
                            <option value="@item.DataListItemId">
                                @item.DataListItemText
                            </option>
                        }

                    </select>

                </div>
                <div class="col-md-2">

                    <label>Section</label>

                    <select asp-for="Filter.SectionId"
                            class="form-control select2">

                        <option value="">Select</option>

                        @foreach (var item in ViewBag.SectionList)
                        {
                            <option value="@item.DataListItemId">
                                @item.DataListItemText
                            </option>
                        }

                    </select>

                </div>
                <div class="col-md-2">

                    <label>Batch</label>

                    <select asp-for="Filter.AdmissionBatchId"
                            class="form-control select2">

                        <option value="">Select</option>

                        @foreach (var item in ViewBag.BatchList)
                        {
                            <option value="@item.BatchId">
                                @item.AcademicYear
                            </option>
                        }

                    </select>



                </div>
                <div class="col-md-2">

                    <label>Status</label>

                    <select asp-for="Filter.StatusId"
                            class="form-control select2">

                        <option value="">Select</option>

                        @foreach (var item in ViewBag.StatusList)
                        {
                            <option value="@item.DataListItemId">
                                @item.DataListItemText
                            </option>
                        }

                    </select>

                </div>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="ApplicationNo"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("ApplicationNo") == true)" />
                            Application No
                        </label>
                    </div>

                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="StudentName"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("StudentName") == true)" />
                            Student Name
                        </label>
                    </div>

                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="FatherName"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("FatherName") == true)" />
                            Father Name
                        </label>
                    </div>
                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="MotherName"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("MotherName") == true)" />
                            Mother Name
                        </label>
                    </div>
                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="GuardianName"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("GuardianName") == true)" />
                            Guardian Name
                        </label>
                    </div>
                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="LocalAddress"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("LocalAddress") == true)" />
                            Local Address
                        </label>
                    </div>
                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="PermanentAddress"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("PermanentAddress") == true)" />
                            Permanent Address
                        </label>
                    </div>

                        
                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="FatherMobile"
                                   checked="@(Model.Filter.SelectedColumns?.Contains("FatherMobile") == true)" />
                            Mobile
                        </label>
                    </div>

                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="DOB" checked="@(Model.Filter.SelectedColumns?.Contains("DOB") == true)" />
                            DOB
                        </label>
                    </div>

                    <div class="col-md-2">
                        <label>
                            <input type="checkbox"
                                   name="Filter.SelectedColumns"
                                   value="AadhaarNumber" checked="@(Model.Filter.SelectedColumns?.Contains("AadhaarNumer") == true)" />
                            Aadhaar
                        </label>
                    </div>

                       
                       
                </div>

            </div>

         

            <br />
         

            <button type="submit" class="border-0 bg-transparent p-0">
                <i class="ti ti-search fs-5"></i>
            </button>

            <button type="submit" formaction="@Url.Action("ExportExcel")" class="border-0 bg-transparent p-0">
                <i class="ti ti-download"></i>
            </button>
           
            <a href="javascript:void(0);" class="btnStatus" id="btnBulkStatus">
                <spam class="ti ti-reload"></spam>
            </a>

        </form>

        <hr />

        <div id="gridContainer">

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead>

                        <tr>
                            <th>
                                <input type="checkbox" name="All" value="All" />
                            </th>
                            @if (cols.Contains("ApplicationNo"))
                            {
                                <th>Application No</th>
                            }

                            @if (cols.Contains("StudentName"))
                            {
                                <th>Student Name</th>
                            }

                            @if (cols.Contains("FatherName"))
                            {
                                <th>Father Name</th>
                            }
                            @if (cols.Contains("MotherName"))
                            {
                                <th>Mother Name</th>
                            }
                            @if (cols.Contains("GuardianName"))
                            {
                                <th>Guardian Name</th>
                            }
                            @if (cols.Contains("LocalAddress"))
                            {
                                <th>Local Address</th>
                            }
                            @if (cols.Contains("PermanentAddress"))
                            {
                                <th>Permanent Address</th>
                            }

                            @*  @if (cols.Contains("LocalAddress"))
                {
                    <th>Local Address</th>
                } *@
                            @if (cols.Contains("FatherMobile"))
                            {
                                <th>Mobile</th>
                            }

                            @if (cols.Contains("DOB"))
                            {
                                <th>DOB</th>
                            }

                            @if (cols.Contains("AadhaarNumber"))
                            {
                                <th>Aadhaar</th>
                            }

                            <th width="120">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Students != null &&
                                    Model.Students.Any())
                        {
                            foreach (var item in Model.Students)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedStudents" value="@item.StudentId" />
                                    </td>
                                    @if (cols.Contains("ApplicationNo"))
                                    {
                                        <td>@item.ApplicationNo</td>
                                    }

                                    @if (cols.Contains("StudentName"))
                                    {
                                        <td>@item.StudentName</td>
                                    }
                                    @if (cols.Contains("FatherName"))
                                    {
                                        <td>@item.FatherName</td>
                                    }
                                    @if (cols.Contains("MotherName"))
                                    {
                                        <td>@item.MotherName</td>
                                    }
                                    @if (cols.Contains("GuardianName"))
                                    {
                                        <td>@item.GuardianName</td>
                                    }
                                    @if (cols.Contains("LocalAddress"))
                                    {
                                        <td>@item.LocalAddress</td>
                                    }
                                    @if (cols.Contains("PermanentAddress"))
                                    {
                                        <td>@item.PermanentAddress</td>
                                    }
                                    @if (cols.Contains("FatherMobile"))
                                    {
                                        <td>@item.FatherMobile</td>
                                    }

                                    @if (cols.Contains("DOB"))
                                    {
                                        <td>
                                            @item.DOB.ToString("dd/MM/yyyy")
                                        </td>
                                    }

                                    @if (cols.Contains("AadhaarNumber"))
                                    {
                                        <td>@item.AadhaarNumber</td>
                                    }

                                    <td>

                                        <permission controller="Students" action="StudentRegistrations" type="edit">
                                            <a asp-action="SaveStudentRegistrations" asp-route-id="@item.StudentId">
                                                <spam class="ti ti-pencil"></spam>
                                            </a>
                                        </permission>
                                        <permission controller="Students" action="StudentRegistrations" type="delete">
                                            <a asp-action="DeleteStudentRegistrations" asp-route-id="@item.StudentId">
                                                <spam class="ti ti-trash"></spam>
                                            </a>
                                        </permission>
                                        <permission controller="Students" action="StudentRegistrations" type="View">
                                            <a asp-action="Profile" asp-route-id="@item.StudentId">
                                                <spam class="ti ti-eye"></spam>
                                            </a>
                                        </permission>
                                        <a href="javascript:void(0);" class="btnStatus" data-studentid="@item.StudentId">
                                            <spam class="ti ti-reload"></spam>
                                        </a>
                                        @*    <button type="button" class="btn btn-primary btnStatus" data-studentid="@item.StudentId">
                                Change Status
                            </button> *@
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="20"
                                    class="text-center">

                                    No Records Found

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
            <!--Model PopUP-->
            <div class="modal fade"
                 id="statusModal"
                 tabindex="-1">

                <div class="modal-dialog">

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title">
                                Update Student Status
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal">
                            </button>

                        </div>

                        <div class="modal-body">

                            <input type="hidden"
                                   id="StudentIds" />

                            <div class="mb-3">

                                <label>Status</label>

                                <select id="StatusId" class="form-select ">

                                    <option value="">Select</option>
                                    @foreach (var item in ViewBag.StatusList)
                                    {
                                        <option value="@item.DataListItemId">
                                            @item.DataListItemText
                                        </option>
                                    }
                                </select>

                            </div>

                            <div id="admissionArea"
                                 style="display:none;">

                                <div class="mb-3">

                                    <label>Class</label>

                                    <select id="ClassId" class="form-select ">
                                        <option value="">Select</option>
                                        @foreach (var item in ViewBag.ClassList)
                                        {
                                            <option value="@item.DataListItemId">
                                                @item.DataListItemText
                                            </option>
                                        }
                                    </select>

                                </div>

                                <div class="mb-3">

                                    <label>Section</label>

                                    <select id="SectionId" class="form-select">
                                        <option value="">Select</option>
                                        @foreach (var item in ViewBag.SectionList)
                                        {
                                            <option value="@item.DataListItemId">
                                                @item.DataListItemText
                                            </option>
                                        }
                                    </select>

                                </div>

                                <div class="mb-3">

                                    <label>Batch</label>

                                    <select id="BatchId" class="form-select ">
                                        <option value="">Select</option>

                                        @foreach (var item in ViewBag.BatchList)
                                        {
                                            <option value="@item.BatchId">
                                                @item.AcademicYear
                                            </option>
                                        }
                                    </select>

                                </div>

                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-success"
                                    id="btnSaveStatus">
                                Save
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@section Scripts
{
    <script>
        $("#StatusId").change(function() {
            debugger
            var statusId = $(this).val();
            var modal = new bootstrap.Modal(document.getElementById('admissionArea')
            );
            if (statusId == "27") // Admitted
            {
                // $("#admissionArea").show();
                modal.show();
            }
            else {
                modal.hide();
                // $("#admissionArea").hide();
            }
        });

        $(".btnStatus").click(function() {

            var studentId = $(this).data("studentid");

            $("#StudentIds").val(studentId);
            var modal = new bootstrap.Modal(document.getElementById('statusModal')
            );
            //$("#statusModal").modal("show");
            modal.show();
        });
        $("#btnBulkStatus").click(function() {

            var ids = [];

            $("input[name='selectedStudents']:checked")
                .each(function() {

                    ids.push($(this).val());

                });

            if (ids.length == 0) {
                alert("Select student first");
                return;
            }

            $("#StudentIds").val(ids.join(','));
            var modal =
                new bootstrap.Modal(
                    document.getElementById('statusModal')
                );
            modal.show();

        });
        $("#btnSaveStatus").click(function() {

            $.ajax({
                url: '/Students/UpdateStudentStatus',
                type: 'POST',
                data: {
                    StudentIds: $("#StudentIds").val(),
                    StatusId: $("#StatusId").val(),
                    ClassId: $("#ClassId").val(),
                    SectionId: $("#SectionId").val(),
                    BatchId: $("#BatchId").val()
                },
                success: function(res) {

                    if (res.success) {
                        alert("Saved Successfully!")
                        // Swal.fire(
                        //     'Success',
                        //     res.message,
                        //     'success'
                        // ).then(() => {

                        //     location.reload();

                        // });
                    }
                    else {
                        alert(res.message);
                        // Swal.fire(
                        //     'Error',
                        //     res.message,
                        //     'error');
                    }
                }
            });

        });
    </script>
}
