@using Shikhsa.ViewModels.DataFilter
@model StudentReportPageVM

@{
    var cols = Model.Filter.SelectedColumns ?? new List<string>();
}

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover datatable mb-0" id="studentTable">
        <thead class="table-light">
            <tr>
                <th style="width:40px;">
                    <input type="checkbox" id="selectAll" />
                </th>
                @if (cols.Contains("ApplicationNo"))
                {
                    <th>@Localizer.Get("Application No")</th>
                }
                @if (cols.Contains("StudentName"))
                {
                    <th>@Localizer.Get("Student Name")</th>
                }
                @if (cols.Contains("FatherName"))
                {
                    <th>@Localizer.Get("Father Name")</th>
                }
                @if (cols.Contains("MotherName"))
                {
                    <th>@Localizer.Get("Mother Name")</th>
                }
                @if (cols.Contains("GuardianName"))
                {
                    <th>@Localizer.Get("Guardian Name")</th>
                }
                @if (cols.Contains("LocalAddress"))
                {
                    <th>@Localizer.Get("Local Address")</th>
                }
                @if (cols.Contains("PermanentAddress"))
                {
                    <th>@Localizer.Get("Permanent Address")</th>
                }
                @if (cols.Contains("FatherMobile"))
                {
                    <th>@Localizer.Get("Mobile")</th>
                }
                @if (cols.Contains("DOB"))
                {
                    <th>@Localizer.Get("DOB")</th>
                }
                @if (cols.Contains("AadhaarNumber"))
                {
                    <th>@Localizer.Get("Aadhaar")</th>
                }
                <th style="min-width:120px;">@Localizer.Get("Action")</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Students != null && Model.Students.Any())
            {
                foreach (var item in Model.Students)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="studentCheckbox" name="selectedStudents" value="@item.StudentId" />
                        </td>
                        @if (cols.Contains("ApplicationNo"))
                        {
                            <td>@item.ApplicationNo</td>
                        }
                        @if (cols.Contains("StudentName"))
                        {
                            <td>@item.StudentName</td>
                        }
                        @if (cols.Contains("FatherName"))
                        {
                            <td>@item.FatherName</td>
                        }
                        @if (cols.Contains("MotherName"))
                        {
                            <td>@item.MotherName</td>
                        }
                        @if (cols.Contains("GuardianName"))
                        {
                            <td>@item.GuardianName</td>
                        }
                        @if (cols.Contains("LocalAddress"))
                        {
                            <td>@item.LocalAddress</td>
                        }
                        @if (cols.Contains("PermanentAddress"))
                        {
                            <td>@item.PermanentAddress</td>
                        }
                        @if (cols.Contains("FatherMobile"))
                        {
                            <td>@item.FatherMobile</td>
                        }
                        @if (cols.Contains("DOB"))
                        {
                            <td>@item.DOB.ToString("dd/MM/yyyy")</td>
                        }
                        @if (cols.Contains("AadhaarNumber"))
                        {
                            <td>@item.AadhaarNumber</td>
                        }
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <permission controller="Students" action="StudentRegistrations" type="edit">
                                    <a asp-action="SaveStudentRegistrations" asp-route-id="@item.StudentId" class="btn btn-warning btn-sm" title="@Localizer.Get("Edit")">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                </permission>
                                <permission controller="Students" action="StudentRegistrations" type="delete">
                                    <a asp-action="DeleteStudentRegistrations" asp-route-id="@item.StudentId" class="btn btn-danger btn-sm" title="@Localizer.Get("Delete")" onclick="return confirm('@Localizer.Get("Are you sure?")')">
                                        <i class="ti ti-trash"></i>
                                    </a>
                                </permission>
                                <button type="button" class="btn btn-info btn-sm btnStatus" data-studentid="@item.StudentId" title="@Localizer.Get("Change Status")">
                                    <i class="ti ti-reload"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="20" class="text-center text-muted">
                        @Localizer.Get("No Records Found")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Status Update Modal (responsive) -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer.Get("Update Student Status")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="StudentIds" />

                <!-- Status Dropdown -->
                <div class="mb-3">
                    <label class="form-label">@Localizer.Get("Status")</label>
                    <select id="StatusId" class="form-select">
                        <option value="">@Localizer.Get("Select")</option>
                        @foreach (var item in ViewBag.StatusList)
                        {
                            <option value="@item.DataListItemId">@item.DataListItemText</option>
                        }
                    </select>
                </div>

                <!-- Admission Details (hidden initially) -->
                <div id="admissionArea" style="display:none;">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Class")</label>
                            <select id="ClassId" class="form-select">
                                <option value="">@Localizer.Get("Select")</option>
                                @foreach (var item in ViewBag.ClassList)
                                {
                                    <option value="@item.DataListItemId">@item.DataListItemText</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Section")</label>
                            <select id="SectionId" class="form-select">
                                <option value="">@Localizer.Get("Select")</option>
                                @foreach (var item in ViewBag.SectionList)
                                {
                                    <option value="@item.DataListItemId">@item.DataListItemText</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Batch")</label>
                            <select id="BatchId" class="form-select">
                                <option value="">@Localizer.Get("Select")</option>
                                @foreach (var item in ViewBag.BatchList)
                                {
                                    <option value="@item.BatchId">@item.AcademicYear</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer.Get("Close")</button>
                <button type="button" class="btn btn-success" id="btnSaveStatus">@Localizer.Get("Save")</button>
            </div>
        </div>
    </div>
</div>

