@using Shikhsa.ViewModels.DataFilter
@model StudentReportPageVM

@{
    var cols = Model.Filter.SelectedColumns ?? new List<string>();
}

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle" id="studentTable">
        <thead class="table-light">
            <tr>
                <th style="width:40px;">
                    <input type="checkbox" id="chkAll" />
                </th>
                <th>@Localizer.Get("Student Name")</th>
                <th>@Localizer.Get("Father Name")</th>
                <th>@Localizer.Get("Mother Name")</th>
                <th>@Localizer.Get("Class")</th>
                <th>@Localizer.Get("Section")</th>
                <th>@Localizer.Get("Batch")</th>
                <th style="min-width:80px;">@Localizer.Get("Action")</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Students != null && Model.Students.Any())
            {
                foreach (var item in Model.Students)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="student-checkbox" name="selectedStudents" value="@item.StudentId" />
                        </td>
                        <td>@item.StudentName</td>
                        <td>@item.FatherName</td>
                        <td>@item.MotherName</td>
                        <td>@item.ClassName</td>
                        <td>@item.SectionName</td>
                        <td>@item.BatchName</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-info btn-sm btnStatus" data-studentid="@item.StudentId" title="@Localizer.Get("Promote")">
                                    <i class="ti ti-reload"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        @Localizer.Get("No Records Found")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Promotion Modal -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer.Get("Promote Student")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="StudentIds" />

                <div id="admissionArea">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Class")</label>
                            <select id="ClassId" class="form-select select2">
                                <option value="">@Localizer.Get("Select")</option>
                                @foreach (var item in ViewBag.ClassList)
                                {
                                    <option value="@item.DataListItemId">@item.DataListItemText</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Section")</label>
                            <select id="SectionId" class="form-select select2">
                                <option value="">@Localizer.Get("Select")</option>
                                @foreach (var item in ViewBag.SectionList)
                                {
                                    <option value="@item.DataListItemId">@item.DataListItemText</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Batch")</label>
                            <select id="BatchId" class="form-select select2">
                                <option value="">@Localizer.Get("Select")</option>
                                @foreach (var item in ViewBag.BatchList)
                                {
                                    <option value="@item.BatchId">@item.AcademicYear</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer.Get("Close")</button>
                <button type="button" class="btn btn-success" id="btnSaveStatus">@Localizer.Get("Save")</button>
            </div>
        </div>
    </div>
</div>

