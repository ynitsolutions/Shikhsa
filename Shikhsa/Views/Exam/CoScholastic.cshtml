@model Shikhsa.ViewModels.CoScholasticPageVM

@{
    ViewData["Title"] = "Co-Scholastic Master";
}

<div class="card mb-4 shadow">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            @(Model.CoScholastic.CoScholasticId == 0 ? Localizer.Get("Add Co-Scholastic") : Localizer.Get("Edit Co-Scholastic"))
        </h5>
    </div>

    <div class="card-body">

        <form asp-action="SaveCoScholastic" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="CoScholastic.CoScholasticId" type="hidden" />

            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <label asp-for="CoScholastic.Title" class="form-label"></label>
                    <input asp-for="CoScholastic.Title"
                           class="form-control form-control-sm required nospecialchars" />
                    <span asp-validation-for="CoScholastic.Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="CoScholastic.SubjectNameInLanguage" class="form-label"></label>
                    <input asp-for="CoScholastic.SubjectNameInLanguage"
                           class="form-control form-control-sm required textspaceonly" />
                    <span asp-validation-for="CoScholastic.SubjectNameInLanguage" class="text-danger small"></span>
                </div>

            </div>

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1">
                    <i class="fa fa-save"></i>
                    @(Model.CoScholastic.CoScholasticId == 0 ? Localizer.Get("Save") : Localizer.Get("Update"))
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-sm d-flex align-items-center gap-1">
                    <i class="fa fa-undo"></i> @Localizer.Get("Reset")
                </a>
            </div>

        </form>

    </div>

</div>

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@Localizer.Get("Co-Scholastic List")</h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0 datatable">
                <thead class="table-primary">
                    <tr>
                        <th style="width:60px;">#</th>
                        <th style="min-width:120px;">@Localizer.Get("Title")</th>
                        <th style="min-width:120px;">@Localizer.Get("Regional Name")</th>
                        <th style="min-width:100px;">@Localizer.Get("Status")</th>
                        <th style="min-width:150px;">@Localizer.Get("Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sr = 1;
                    }
                    @foreach (var item in Model.CoScholasticList)
                    {
                        <tr>
                            <td class="text-center">@sr</td>
                            <td>@item.Title</td>
                            <td>@item.SubjectNameInLanguage</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">@Localizer.Get("Active")</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@Localizer.Get("Inactive")</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                     <permission controller="Exam" action="CoScholastic" type="edit">
                                        <a asp-action="CoScholastic"
                                           asp-route-id="@item.CoScholasticId"
                                           class="btn btn-warning btn-sm d-flex align-items-center gap-1">
                                            <i class="ti ti-pencil"></i> @Localizer.Get("Edit")
                                        </a>
                                    </permission>
                                    <permission controller="Exam" action="CoScholastic" type="delete">
                                        <a asp-action="DeleteCoScholastic"
                                           asp-route-id="@item.CoScholasticId"
                                           class="btn btn-danger btn-sm d-flex align-items-center gap-1"
                                           onclick="return confirm('@Localizer.Get("Delete this record?")')">
                                            <i class="ti ti-trash"></i> @Localizer.Get("Delete")
                                        </a>
                                    </permission>
                                </div>
                            </td>
                        </tr>
                        sr++;
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}