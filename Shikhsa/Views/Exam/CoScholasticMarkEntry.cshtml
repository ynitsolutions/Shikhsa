@model Shikhsa.ViewModels.CoScholasticGradeEntryVM

@{
    ViewData["Title"] = "Co-Scholastic Grade Entry";
}

<form id="frmCoScholastic" asp-controller="Exam" asp-action="CoScholasticMarkEntry" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- Responsive Filter Row -->
            <div class="row g-2 g-md-3 align-items-end">

                <partial name="~/Views/Shared/_StudentFilterPartial.cshtml" model="Model" />

                <!-- Term -->
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <label asp-for="ExamCategoryId" class="form-label">@Localizer.Get("Term")</label>
                    <select asp-for="ExamCategoryId"
                            class="form-select form-select-sm select2"
                            asp-items="@(new SelectList(Model.ExamCategories, "ExamCategoryId", "ExamCategoryName"))">
                        <option value="">@Localizer.Get("Select Term")</option>
                    </select>
                </div>

                <!-- Load Button -->
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <button type="submit" class="btn btn-primary w-100 btn-sm" id="btnLoadStudents">
                        <i class="fa fa-search"></i> @Localizer.Get("Load Students")
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Co-Scholastic Table Container -->
    <div id="coScholasticContainer">
        <partial name="_ExamCoScholasticMarkTable" model="Model" />
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/teacher-filter.js"></script>

    <!-- ✅ Only page‑specific CSS (sticky header & grade color) – rest is in site.css -->
    <style>
        /* Sticky header – page‑specific, not in common site.css */
        .table-scroll thead th {
            position: sticky;
            top: 0;
            z-index: 20;
            background: #212529; /* matches .table-dark */
            white-space: nowrap;
            text-align: center;
            vertical-align: middle;
        }

        /* Grade select border color – page‑specific feature */
        .form-select-sm {
            min-width: 80px;
            text-align: center;
        }

        /* Grade colour coding */
        .border-success {
            border: 2px solid #28a745;
        }

        .border-primary {
            border: 2px solid #0d6efd;
        }

        .border-warning {
            border: 2px solid #ffc107;
        }

        .border-danger {
            border: 2px solid #dc3545;
        }

        /* Responsive tweaks for small screens */
        @@media (max-width: 768px) {
            .form-select-sm {
                min-width: 60px;
                font-size: 0.75rem;
                padding: 0.2rem 0.3rem;
            }

            .btn-sm {
                font-size: 0.8rem;
                padding: 0.3rem 0.6rem;
            }
        }

        @@media (max-width: 576px) {
            .form-select-sm {
                min-width: 50px;
                font-size: 0.7rem;
                padding: 0.15rem 0.2rem;
            }

            .freeze-icon {
                font-size: 1rem !important;
            }
        }
    </style>

    <script>
     

        // ── Load students via AJAX ─────────────────────────────
        $("#btnLoadStudents").click(function(e) {
            e.preventDefault();
            $.ajax({
                url: "/Exam/LoadCoScholasticStudents",
                type: "POST",
                data: $("#frmCoScholastic").serialize(),
                beforeSend: function() {
                    $("#btnLoadStudents")
                        .prop("disabled", true)
                        .html('<i class="fa fa-spinner fa-spin"></i> Loading...');
                },
                success: function(html) {
                    $("#coScholasticContainer").html(html);
                    if ($.fn.DataTable.isDataTable("#tblMarks")) {
                        $("#tblMarks").DataTable().destroy();
                    }
                    $("#tblMarks").DataTable({
                        paging: true,
                        searching: true,
                        ordering: true,
                        info: false,
                        scrollX: true
                    });
                    // Re-apply freeze states
                    $("#tblMarks tbody tr").each(function() {
                        var freeze = $(this).find(".freeze-value").val();
                        freeze = (freeze === "True" || freeze === "true");
                        setFreezeRow($(this), freeze);
                    });
                    updateHeaderFreezeIcon();
                },
                complete: function() {
                    $("#btnLoadStudents")
                        .prop("disabled", false)
                        .html('<i class="fa fa-search"></i> Load Students');
                },
                error: function(xhr) {
                    console.log(xhr.responseText);
                }
            });
        });

        // ── Grade dropdown colour coding ──────────────────────
        document.addEventListener("DOMContentLoaded", function() {
            const selects = document.querySelectorAll("select.form-select-sm");
            selects.forEach(function(ddl) {
                setColor(ddl);
                ddl.addEventListener("change", function() {
                    setColor(this);
                });
            });

            function setColor(control) {
                control.classList.remove("border-success", "border-primary", "border-warning", "border-danger");
                switch (control.value) {
                    case "A+":
                    case "A": control.classList.add("border-success"); break;
                    case "B+":
                    case "B": control.classList.add("border-primary"); break;
                    case "C": control.classList.add("border-warning"); break;
                    case "D":
                    case "E": control.classList.add("border-danger"); break;
                }
            }
        });

        // ── Freeze / Unfreeze functions ────────────────────────
        function updateHeaderFreezeIcon() {
            var total = $(".freeze-value").length;
            if (total === 0) return;
            var freezeCount = $(".freeze-value").filter(function() {
                return $(this).val() == "True" || $(this).val() == "true";
            }).length;
            var icon = $("#toggleAllFreezeIcon");
            if (freezeCount === total) {
                icon.removeClass("fa-lock-open text-success").addClass("fa-lock text-danger");
            } else {
                icon.removeClass("fa-lock text-danger").addClass("fa-lock-open text-success");
            }
        }

        function setFreezeRow(tr, freeze) {
            tr.find(".freeze-value").val(freeze);
            // Disable radio buttons visually (pointer-events)
            tr.find("input[type=radio]")
                .css("pointer-events", freeze ? "none" : "auto")
                .css("cursor", freeze ? "not-allowed" : "pointer")
                .css("opacity", freeze ? "0.6" : "1");
            tr.toggleClass("table-secondary", freeze);
            var icon = tr.find(".freeze-icon");
            if (freeze) {
                icon.removeClass("fa-lock-open text-success").addClass("fa-lock text-danger");
            } else {
                icon.removeClass("fa-lock text-danger").addClass("fa-lock-open text-success");
            }
        }

        $(document).on("click", ".toggle-freeze", function() {
            var tr = $(this).closest("tr");
            var freeze = tr.find(".freeze-value").val();
            freeze = (freeze === "True" || freeze === "true");
            setFreezeRow(tr, !freeze);
            updateHeaderFreezeIcon();
        });

        $(document).on("click", "#toggleAllFreeze", function() {
            var freezeAll = !$("#toggleAllFreezeIcon").hasClass("fa-lock");
            $("#tblMarks tbody tr").each(function() {
                setFreezeRow($(this), freezeAll);
            });
            updateHeaderFreezeIcon();
        });

        // ── Initialise freeze states on page load ─────────────
        $(function() {
            $("tbody tr").each(function() {
                var freeze = $(this).find(".freeze-value").val();
                freeze = (freeze === "True" || freeze === "true");
                setFreezeRow($(this), freeze);
            });
            updateHeaderFreezeIcon();
        });
    </script>
}