@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <style>

        .table-scroll {
            width: 100%;
            overflow-x: auto;
            overflow-y: auto;
            max-height: 70vh;
        }

            .table-scroll table {
                width: max-content;
                min-width: 100%;
            }

        table thead th {
            position: sticky;
            top: 0;
            z-index: 20;
            white-space: nowrap;
            text-align: center;
            vertical-align: middle;
        }

        table tbody td {
            vertical-align: middle;
            white-space: nowrap;
        }

        /* Sticky Columns */

/*         table th:nth-child(1),
        table td:nth-child(1) {
            position: sticky;
            left: 0;
            z-index: 10;
            background: white;
            text-align: center;
            min-width: 60px;
        }

        table th:nth-child(2),
        table td:nth-child(2) {
            position: sticky;
            left: 60px;
            z-index: 10;
            background: white;
            min-width: 120px;
        }

        table th:nth-child(3),
        table td:nth-child(3) {
            position: sticky;
            left: 180px;
            z-index: 10;
            background: white;
            min-width: 220px;
        }

        table thead th:nth-child(1),
        table thead th:nth-child(2),
        table thead th:nth-child(3) {
            z-index: 30;
        } */

        .form-select-sm {
            min-width: 80px;
            text-align: center;
        }

        .card-header h5,
        .card-header h6 {
            margin-bottom: 0;
        }

        .badge {
            font-size: .75rem;
        }

        .table-hover tbody tr:hover {
            background: #f8f9fa;
        }

        .btn {
            min-width: 120px;
        }

    </style>

    <script>
         $(document).ready(function () {
            $('#tblMarks').DataTable({
                paging: true,
                ordering: true,
                searching: true,
                info: false
            });
        });
        document.addEventListener("DOMContentLoaded", function () {

            const selects = document.querySelectorAll("select.form-select-sm");

            selects.forEach(function (ddl) {

                setColor(ddl);

                ddl.addEventListener("change", function () {

                    setColor(this);

                });

            });

            function setColor(control) {

                control.classList.remove(
                    "border-success",
                    "border-primary",
                    "border-warning",
                    "border-danger"
                );

                switch (control.value) {

                    case "A+":
                    case "A":
                        control.classList.add("border-success");
                        break;

                    case "B+":
                    case "B":
                        control.classList.add("border-primary");
                        break;

                    case "C":
                        control.classList.add("border-warning");
                        break;

                    case "D":
                    case "E":
                        control.classList.add("border-danger");
                        break;
                }

            }

        });
          function updateHeaderFreezeIcon() {

            var total = $(".freeze-value").length;

            var freeze = $(".freeze-value").filter(function () {
                return $(this).val() == "True" || $(this).val() == "true";
            }).length;

            if (freeze == total && total > 0) {

                $("#toggleAllFreezeIcon")
                    .removeClass("fa-lock-open text-success")
                    .addClass("fa-lock text-danger");

            }
            else {

                $("#toggleAllFreezeIcon")
                    .removeClass("fa-lock text-danger")
                    .addClass("fa-lock-open text-success");

            }
        }

         function setFreezeRow(tr, freeze) 
         {

            tr.find(".freeze-value").val(freeze);

            // Radio disable mat karo, sirf click rok do
            tr.find("input[type=radio]")
                .css("pointer-events", freeze ? "none" : "auto")
                .css("cursor", freeze ? "not-allowed" : "pointer")
                .css("opacity", freeze ? "0.6" : "1");

            tr.toggleClass("table-secondary", freeze);

            var icon = tr.find(".freeze-icon");

            if (freeze) {

                icon.removeClass("fa-lock-open text-success")
                    .addClass("fa-lock text-danger");

            }
            else {

                icon.removeClass("fa-lock text-danger")
                    .addClass("fa-lock-open text-success");

            }
        }
        $(document).on("click", ".toggle-freeze", function () 
        {

            var tr = $(this).closest("tr");

            var freeze = tr.find(".freeze-value").val();

            freeze = (freeze === "True" || freeze === "true");

            freeze = !freeze;

            setFreezeRow(tr, freeze);

            updateHeaderFreezeIcon();

        });
         $(document).on("click", "#toggleAllFreeze", function () {

            var freezeAll = !$("#toggleAllFreezeIcon").hasClass("fa-lock");

            $("tbody tr").each(function () {

                setFreezeRow($(this), freezeAll);

            });

            updateHeaderFreezeIcon();

        });
        function updateHeaderFreezeIcon() 
        {

            var rows = $(".freeze-value");

            if (rows.length === 0)
                return;

            var total = rows.length;

            var freezeCount = rows.filter(function () {

                return $(this).val() === "True" || $(this).val() === "true";

            }).length;

            var icon = $("#toggleAllFreezeIcon");

            if (freezeCount === total) {

                icon.removeClass("fa-lock-open text-success")
                    .addClass("fa-lock text-danger");

            }
            else {

                icon.removeClass("fa-lock text-danger")
                    .addClass("fa-lock-open text-success");

            }
        }
         $(function () {

            $("tbody tr").each(function () {

                var freeze = $(this).find(".freeze-value").val();

                freeze = (freeze === "True" || freeze === "true");

                setFreezeRow($(this), freeze);

            });

            updateHeaderFreezeIcon();

        });
    </script>

}