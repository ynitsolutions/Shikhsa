@model Shikhsa.ViewModels.CoScholasticGradeEntryVM

@{
    ViewData["Title"] = "Co-Scholastic Grade Entry";
}

<div class="container-fluid">

    <form method="post" asp-action="LoadCoScholasticStudents">

        @Html.AntiForgeryToken()

        <div class="card shadow-sm mb-3">

            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fa fa-graduation-cap"></i>
                    Co-Scholastic Grade Entry
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Batch -->

                    <div class="col-md-2 mb-3">

                        <label class="form-label"> @Localizer.Get("Batch")</label>

                        <select asp-for="BatchId"
                                class="form-select select2"
                                asp-items="@(new SelectList(Model.Batches, "BatchId", "AcademicYear"))">

                            <option value="">Select Batch</option>

                        </select>

                    </div>

                    <!-- Staff -->

                    <div class="col-md-2 mb-3">

                        <label class="form-label">@Localizer.Get("Staff")</label>


                        <select asp-for="StaffId"
                                class="form-select select2" onchange="this.form.action='@Url.Action("CoScholasticBatchChanged", "Exam")';this.form.submit();"
                                asp-items="@(new SelectList(Model.Staffs, "StaffId", "FullName"))">

                            <option value="">@Localizer.Get("Select")</option>

                        </select>

                    </div>

                    <!-- Class -->

                    <div class="col-md-2 mb-3">

                        <label class="form-label">@Localizer.Get("Class")</label>

                        <select asp-for="ClassId"
                                class="form-select select2" onchange="this.form.action='@Url.Action("CoScholasticClassChanged", "Exam")';this.form.submit();"
                                asp-items="@(new SelectList(Model.Classes, "DataListItemId", "DataListItemText"))">

                            <option value="">@Localizer.Get("Select")</option>

                        </select>

                    </div>

                    <!-- Section -->

                    <div class="col-md-2 mb-3">

                        <label class="form-label">@Localizer.Get("Section")</label>

                        <select asp-for="SectionId"
                                class="form-select select2" onchange="this.form.action='@Url.Action("CoScholasticSectionChanged", "Exam")';this.form.submit();"
                                asp-items="@(new SelectList(Model.Sections, "DataListItemId", "DataListItemText"))">

                            <option value="">@Localizer.Get("Select Section")</option>

                        </select>

                    </div>
                    <!-- Term -->

                    <div class="col-md-2 mb-3">

                        <label asp-for="ExamCategoryId" class="form-label">
                            @Localizer.Get("Term")
                        </label>

                        <select asp-for="ExamCategoryId"
                                class="form-select select2"
                                asp-items="@(new SelectList(Model.ExamCategories, "ExamCategoryId", "ExamCategoryName"))">

                            <option value="">@Localizer.Get("Select")</option>

                        </select>

                    </div>

                    <!-- Exam Type -->
                    <!-- Load Button -->

                    <div class="col-md-2 mb-3 d-flex align-items-end">

                        <button type="submit"
                                asp-action="LoadCoScholasticStudents"
                                class="btn btn-success w-100">

                            <i class="fa fa-search"></i>

                            Load Students

                        </button>

                    </div>

                </div>

            </div>

        </div>
