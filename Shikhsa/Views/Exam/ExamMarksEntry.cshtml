        <script>

            $(function () {

                calculateAll();

                $(document).on("keyup change", ".mark-input", function () {

                    calculateRow($(this).closest("tr"));

                    calculateRank();

                });

            });


            function calculateAll() {

                $("#tblMarks tbody tr").each(function () {

                    calculateRow($(this));

                });

                calculateRank();

            }


            function calculateRow(row) {

                var total = 0;

                var maxMarks = 0;

                row.find(".mark-input").each(function () {

                    var mark = parseFloat($(this).val());
                   var max = Number(this.dataset.max);

                    if (isNaN(mark))
                        mark = 0;

                    if (mark > max)
                        mark = max;

                    total += mark;

                    maxMarks += max;

                });

                var percent = 0;

                if (maxMarks > 0)
                    percent = (total * 100) / maxMarks;
                            console.log("Total :", total);
            console.log("Max :", maxMarks);
            console.log("Percent :", percent);

                row.find(".total").val(total.toFixed(2));

                row.find(".percent").val(percent.toFixed(2));

                row.find(".grade").val(getGrade(percent));

            }


            function getGrade(percent) {

                for (var i = 0; i < grades.length; i++) {

                    if (percent >= grades[i].min &&
                        percent <= grades[i].max) {

                        return grades[i].grade;

                    }

                }

                return "";

            }


            function calculateRank() {

                var students = [];

                $("#tblMarks tbody tr").each(function () {

                    students.push({

                        row: $(this),

                        total: parseFloat($(this).find(".total").val()) || 0

                    });

                });

                students.sort(function (a, b) {

                    return b.total - a.total;

                });

                var rank = 1;

                for (var i = 0; i < students.length; i++) {

                    if (i > 0 &&
                        students[i].total < students[i - 1].total) {

                        rank = i + 1;

                    }

                    students[i].row.find(".rank").val(rank);

                }

            }

            const grades = [

                { min: 91, max: 100, grade: "A1" },
                { min: 81, max: 90, grade: "A2" },
                { min: 71, max: 80, grade: "B1" },
                { min: 61, max: 70, grade: "B2" },
                { min: 51, max: 60, grade: "C1" },
                { min: 41, max: 50, grade: "C2" },
                { min: 33, max: 40, grade: "D" },
                { min: 0, max: 32, grade: "E" }

            ];
            $(function () {

                updateHeaderFreezeIcon();

                // Individual Freeze/Unfreeze
                $(document).on("click", ".toggle-freeze", function () {

                    toggleFreeze($(this).closest("tr"));

                    updateHeaderFreezeIcon();
                });

                // Header Freeze/Unfreeze
                $("#toggleAllFreeze").on("click", function () {

                    let allFreeze = $(".freeze-value").length > 0 &&
                                    $(".freeze-value").filter(function () {
                                        return $(this).val() === "True" || $(this).val() === "true";
                                    }).length === $(".freeze-value").length;

                    // Agar sab freeze hain to unfreeze karo
                    // warna sab freeze karo
                    let newValue = !allFreeze;

                    $("#tblMarks tbody tr").each(function () {
                        setFreeze($(this), newValue);
                    });

                    updateHeaderFreezeIcon();
                });

            });

            function toggleFreeze(row) {

                let hidden = row.find(".freeze-value");

                let value = hidden.val() === "True" || hidden.val() === "true";

                setFreeze(row, !value);
            }

            function setFreeze(row, freeze) {

                row.find(".freeze-value").val(freeze);

                row.find(".freeze-icon")
                    .removeClass("fa-lock fa-lock-open text-danger text-success")
                    .addClass(freeze
                        ? "fa-lock text-danger"
                        : "fa-lock-open text-success");

                row.find(".mark-input,.remark-input")
                    .prop("readonly", freeze);

                row.find(".absent-input")
                    .prop("disabled", freeze);
            }

            function updateHeaderFreezeIcon() {

                let total = $(".freeze-value").length;

                if (total === 0)
                    return;

                let freezeCount = $(".freeze-value").filter(function () {
                    return $(this).val() === "True" || $(this).val() === "true";
                }).length;

                $("#headerFreezeIcon")
                    .removeClass("fa-lock fa-lock-open text-danger text-success");

                if (freezeCount === total) {

                    // Sab Freeze
                    $("#headerFreezeIcon")
                        .addClass("fa-lock text-danger");

                } else {

                    // Sab Unfreeze ya Mixed
                    $("#headerFreezeIcon")
                        .addClass("fa-lock-open text-success");
                }
            }
        </script>
