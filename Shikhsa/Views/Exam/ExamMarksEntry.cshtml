    @model Shikhsa.ViewModels.ExamMarksEntryVM

    @{
        ViewData["Title"] = "Exam Marks Entry";
    }
    <style>
        .table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: auto;
        max-height: 600px;   /* Vertical Scroll */
        white-space: nowrap;
    }

    .table-scroll table {
        width: max-content;
        min-width: 100%;
    }

    .card,
    .card-body {
        overflow: hidden;
    }

        .toggle-freeze {
            border: none;
            background: none;
            padding: 0;
        }

            .toggle-freeze i {
                font-size: 20px;
                cursor: pointer;
                transition: .2s;
            }

                .toggle-freeze i:hover {
                    transform: scale(1.15);
                }
    </style>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }
