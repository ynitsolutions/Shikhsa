@model Shikhsa.ViewModels.ExamMarksEntryVM

@{
    ViewData["Title"] = "Exam Marks Entry";
}


<form id="frmMarks" asp-controller="Exam" asp-action="ExamMarksEntry" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- Responsive Filter Row -->
            <div class="row g-2 g-md-3 align-items-end">

                <partial name="~/Views/Shared/_StudentFilterPartial.cshtml" model="Model" />

                <!-- Term -->
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <label asp-for="ExamCategoryId" class="form-label">@Localizer.Get("Term")</label>
                    <select asp-for="ExamCategoryId"
                            class="form-select form-select-sm select2"
                            asp-items="@(new SelectList(Model.ExamCategories, "ExamCategoryId", "ExamCategoryName"))">
                        <option value="">@Localizer.Get("Select Term")</option>
                    </select>
                </div>

                <!-- Load Button -->
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <button type="submit" class="btn btn-primary w-100 btn-sm" id="btnLoadStudents">
                        <i class="fa fa-search"></i> @Localizer.Get("Load Students")
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Marks Table Container -->
    <div id="marksContainer">
        <partial name="_ExamMarksTable" model="Model" />
    </div>
</form>

@section Scripts {
    <script src="~/js/teacher-filter.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#tblMarks').DataTable({
                paging: true,
                ordering: true,
                searching: true,
                info: false,
                scrollX: true,
                scrollCollapse: true
            });
        });

        $(document).on("click", "#btnLoadStudents", function (e) {
            e.preventDefault();

            $.ajax({
                url: "/Exam/LoadStudents",
                type: "POST",
                data: $("#frmMarks").serialize(),
                beforeSend: function () {
                    $("#btnLoadStudents")
                        .prop("disabled", true)
                        .html('<i class="fa fa-spinner fa-spin"></i> Loading...');
                },
                success: function (html) {
                    $("#marksContainer").html(html);
                    calculateAll();
                    updateHeaderFreezeIcon();
                },
                complete: function () {
                    $("#btnLoadStudents")
                        .prop("disabled", false)
                        .html('<i class="fa fa-search"></i> Load Students');
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                }
            });
        });

        // ---- Marks calculation & ranking ----
        $(function () {
            calculateAll();

            $(document).on("keyup change", ".mark-input", function () {
                calculateRow($(this).closest("tr"));
                calculateRank();
            });
        });

        function calculateAll() {
            $("#tblMarks tbody tr").each(function () {
                calculateRow($(this));
            });
            calculateRank();
        }

        function calculateRow(row) {
            var total = 0;
            var maxMarks = 0;

            row.find(".mark-input").each(function () {
                var mark = parseFloat($(this).val()) || 0;
                var max = Number(this.dataset.max) || 0;
                if (mark > max) mark = max;
                total += mark;
                maxMarks += max;
            });

            var percent = maxMarks > 0 ? (total * 100) / maxMarks : 0;

            row.find(".total").val(total.toFixed(2));
            row.find(".percent").val(percent.toFixed(2));
            row.find(".grade").val(getGrade(percent));
        }

        function getGrade(percent) {
            var grades = [
                { min: 91, max: 100, grade: "A1" },
                { min: 81, max: 90, grade: "A2" },
                { min: 71, max: 80, grade: "B1" },
                { min: 61, max: 70, grade: "B2" },
                { min: 51, max: 60, grade: "C1" },
                { min: 41, max: 50, grade: "C2" },
                { min: 33, max: 40, grade: "D" },
                { min: 0, max: 32, grade: "E" }
            ];
            for (var i = 0; i < grades.length; i++) {
                if (percent >= grades[i].min && percent <= grades[i].max)
                    return grades[i].grade;
            }
            return "";
        }

        function calculateRank() {
            var students = [];
            $("#tblMarks tbody tr").each(function () {
                students.push({
                    row: $(this),
                    total: parseFloat($(this).find(".total").val()) || 0
                });
            });

            students.sort(function (a, b) { return b.total - a.total; });

            var rank = 1;
            for (var i = 0; i < students.length; i++) {
                if (i > 0 && students[i].total < students[i - 1].total) {
                    rank = i + 1;
                }
                students[i].row.find(".rank").val(rank);
            }
        }

        // ---- Freeze / Unfreeze logic ----
        $(function () {
            updateHeaderFreezeIcon();

            $(document).on("click", ".toggle-freeze", function () {
                toggleFreeze($(this).closest("tr"));
                updateHeaderFreezeIcon();
            });

            $("#toggleAllFreeze").on("click", function () {
                var allFreeze = $(".freeze-value").length > 0 &&
                    $(".freeze-value").filter(function () {
                        return $(this).val() === "True" || $(this).val() === "true";
                    }).length === $(".freeze-value").length;

                var newValue = !allFreeze;
                $("#tblMarks tbody tr").each(function () {
                    setFreeze($(this), newValue);
                });
                updateHeaderFreezeIcon();
            });
        });

        function toggleFreeze(row) {
            var hidden = row.find(".freeze-value");
            var value = hidden.val() === "True" || hidden.val() === "true";
            setFreeze(row, !value);
        }

        function setFreeze(row, freeze) {
            row.find(".freeze-value").val(freeze);
            row.find(".freeze-icon")
                .removeClass("fa-lock fa-lock-open text-danger text-success")
                .addClass(freeze ? "fa-lock text-danger" : "fa-lock-open text-success");

            row.find(".mark-input,.remark-input").prop("readonly", freeze);
            row.find(".absent-input").prop("disabled", freeze);
        }

        function updateHeaderFreezeIcon() {
            var total = $(".freeze-value").length;
            if (total === 0) return;

            var freezeCount = $(".freeze-value").filter(function () {
                return $(this).val() === "True" || $(this).val() === "true";
            }).length;

            $("#headerFreezeIcon")
                .removeClass("fa-lock fa-lock-open text-danger text-success")
                .addClass(freezeCount === total ? "fa-lock text-danger" : "fa-lock-open text-success");
        }
    </script>
}