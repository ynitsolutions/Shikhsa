@model Shikhsa.ViewModels.ExamMarksEntryVM

@if (Model.Columns != null && Model.Columns.Any())
{
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-scroll">

                <table id="tblMarks"
                       class="table table-bordered table-striped table-hover align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th style="min-width:50px;">#</th>
                            <th style="min-width:120px;">@Localizer.Get("Application No")</th>
                            <th style="min-width:200px;">@Localizer.Get("Student") @Localizer.Get("Name")</th>

                            @for (int c = 0; c < Model.Columns.Count; c++)
                            {
                                <th class="text-center" style="min-width:150px;">
                                    <div class="fw-bold">@Model.Columns[c].SubjectName</div>
                                    <small>@Model.Columns[c].ExamName</small>
                                    <br />
                                    <span class="badge bg-primary">@Localizer.Get("Max") : @Model.Columns[c].MaxMarks</span>
                                    <input type="hidden" asp-for="Columns[c].ExamId" />
                                    <input type="hidden" asp-for="Columns[c].SubjectId" />
                                    <input type="hidden" asp-for="Columns[c].MaxMarks" />
                                </th>
                            }

                            <th style="min-width:150px;">@Localizer.Get("Remarks")</th>
                            <th style="min-width:100px;">@Localizer.Get("Total")</th>
                            <th style="min-width:80px;">%</th>
                            <th style="min-width:120px;">@Localizer.Get("Rank in Class")</th>

                            @if (Model.IsClassTeacher.GetValueOrDefault())
                            {
                                <th style="min-width:80px;" class="text-center">
                                    @Localizer.Get("Freeze")
                                    <br />
                                    <button type="button" id="toggleAllFreeze" class="btn btn-sm btn-link p-0">
                                        <i id="headerFreezeIcon" class="fa-solid fa-lock-open text-success fs-5"></i>
                                    </button>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Students != null && Model.Students.Any())
                        {
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @(i + 1)
                                        <input type="hidden" asp-for="Students[i].StudentId" />
                                        <input type="hidden" asp-for="Students[i].RollNo" />
                                        <input type="hidden" asp-for="Students[i].AdmissionNo" />
                                        <input type="hidden" asp-for="Students[i].StudentName" />
                                    </td>

                                    <td>@Model.Students[i].AdmissionNo</td>
                                    <td>@Model.Students[i].StudentName</td>

                                    @for (int j = 0; j < Model.Columns.Count; j++)
                                    {
                                        <td>
                                            <input type="hidden" asp-for="Students[i].Marks[j].ExamObtainedMarkId" />
                                            <input type="hidden" asp-for="Students[i].Marks[j].ExamId" />
                                            <input type="hidden" asp-for="Students[i].Marks[j].SubjectId" />

                                            @if (Model.Students[i].IsFreeze)
                                            {
                                                <input asp-for="Students[i].Marks[j].Marks"
                                                       class="form-control form-control-sm text-end mark-input decimal"
                                                       data-max="@Model.Columns[j].MaxMarks"
                                                       readonly />
                                                <div class="form-check mt-1">
                                                    <input asp-for="Students[i].Marks[j].IsAbsent"
                                                           class="form-check-input"
                                                           disabled />
                                                    <label class="form-check-label">AB</label>
                                                </div>
                                                <input type="hidden" asp-for="Students[i].Marks[j].IsAbsent" />
                                            }
                                            else
                                            {
                                                <input asp-for="Students[i].Marks[j].Marks"
                                                       type="number"
                                                       min="0"
                                                       max="@Model.Columns[j].MaxMarks"
                                                       data-max="@Model.Columns[j].MaxMarks"
                                                       step="0.01"
                                                       class="form-control form-control-sm text-end mark-input decimal" />
                                                <div class="form-check mt-1">
                                                    <input asp-for="Students[i].Marks[j].IsAbsent"
                                                           class="form-check-input absent-input" />
                                                    <label class="form-check-label">AB</label>
                                                </div>
                                                <input type="hidden" asp-for="Students[i].Marks[j].IsFreeze" />
                                            }
                                        </td>
                                    }

                                    <td>
                                        <input asp-for="Students[i].Remarks"
                                               class="form-control form-control-sm"
                                               placeholder="Remarks"
                                               readonly="@(Model.Students[i].IsFreeze ? "readonly" : null)" />
                                    </td>
                                    <td>
                                        <input asp-for="Students[i].Total"
                                               class="form-control form-control-sm total"
                                               placeholder="total"
                                               readonly />
                                    </td>
                                    <td>
                                        <input asp-for="Students[i].Percent"
                                               class="form-control form-control-sm percent"
                                               placeholder="Percent"
                                               readonly />
                                    </td>
                                    <td>
                                        <input asp-for="Students[i].RankInClass"
                                               class="form-control form-control-sm rank"
                                               placeholder="Rank In Class"
                                               readonly />
                                    </td>

                                    @if (Model.IsClassTeacher.GetValueOrDefault())
                                    {
                                        <td class="text-center">
                                            <input asp-for="Students[i].IsFreeze" class="freeze-value" type="hidden" />
                                            <button type="button" class="btn btn-sm btn-link toggle-freeze p-0">
                                                <i class="freeze-icon fa-solid @(Model.Students[i].IsFreeze ? "fa-lock text-danger" : "fa-lock-open text-success") fs-5"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>

                </table>

            </div>

        </div>

        <!-- Footer Actions – responsive with flex-wrap -->
        <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
            <button type="submit"
                    formaction="@Url.Action("ExamMarksEntry", "Exam")"
                    class="btn btn-success btn-sm d-flex align-items-center gap-1">
                <i class="fa fa-save"></i> @Localizer.Get("Save Marks")
            </button>
            <button type="submit"
                    formaction="@Url.Action("ExportExcel", "Exam")"
                    class="btn btn-success btn-sm d-flex align-items-center gap-1">
                <i class="fa fa-file-excel"></i> @Localizer.Get("Export Excel")
            </button>
        </div>

    </div>
}
else
{
    <div class="alert alert-warning mt-3">
        @Localizer.Get("Please select Batch, Staff, Class, Section and Term then click")
        <strong>@Localizer.Get("Load Students")</strong>.
    </div>
}

