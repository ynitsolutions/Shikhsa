@model Shikhsa.ViewModels.CoScholasticAreaVM

@{
    ViewData["Title"] = "Co-Scholastic Area";
    var list = ViewBag.List as IEnumerable<dynamic>;
}

<div class="container-fluid">

    <!-- Form -->
    <div class="card shadow-sm mb-3">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                @(Model.CoScholasticArea.CoScholasticAreaId == 0 ? Localizer.Get("Add Co-Scholastic Area") : Localizer.Get("Edit Co-Scholastic Area"))
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="SaveCoScholasticArea" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="CoScholasticArea.CoScholasticAreaId" type="hidden" />

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-5">
                        <label asp-for="CoScholasticArea.CoScholasticId" class="form-label"></label>
                        <select asp-for="CoScholasticArea.CoScholasticId"
                                asp-items="Model.CoScholasticList"
                                class="form-control form-control-sm select2 required">
                            <option value="">@Localizer.Get("Select")</option>
                        </select>
                        <span asp-validation-for="CoScholasticArea.CoScholasticId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-5">
                        <label asp-for="CoScholasticArea.ClassId" class="form-label"></label>
                        <select asp-for="CoScholasticArea.ClassId" class="form-control form-control-sm select2 required">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in Model.ClassList)
                            {
                                <option value="@item.DataListItemId" data-name="@item.DataListItemText">@item.DataListItemText</option>
                            }
                        </select>
                        <span asp-validation-for="CoScholasticArea.ClassId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-success w-100 btn-sm d-flex align-items-center justify-content-center gap-1">
                            <i class="fa fa-save"></i>
                            @(Model.CoScholasticArea.CoScholasticAreaId == 0 ? Localizer.Get("Save") : Localizer.Get("Update"))
                        </button>
                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Filter & List -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Localizer.Get("Search")</h5>
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-5">
                        <label class="form-label">@Localizer.Get("Co-Scholastic")</label>
                        <select asp-for="SearchCoScholasticId"
                                asp-items="Model.CoScholasticList"
                                class="form-control form-control-sm select2">
                            <option value="">@Localizer.Get("All")</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-5">
                        <label class="form-label">@Localizer.Get("Class")</label>
                        <select asp-for="SearchClassId" class="form-control form-control-sm select2">
                            <option value="">@Localizer.Get("All")</option>
                            @foreach (var item in Model.ClassList)
                            {
                                <option value="@item.DataListItemId" data-name="@item.DataListItemText">@item.DataListItemText</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-2">
                        <button class="btn btn-primary w-100 btn-sm d-flex align-items-center justify-content-center gap-1">
                            <i class="fa fa-search"></i> @Localizer.Get("Search")
                        </button>
                    </div>

                </div>

            </form>

            <hr />

            <!-- Responsive Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0 datatable">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">#</th>
                            <th style="min-width:150px;">@Localizer.Get("Co-Scholastic")</th>
                            <th style="min-width:120px;">@Localizer.Get("Class")</th>
                            <th style="min-width:100px;">@Localizer.Get("Status")</th>
                            <th style="min-width:180px;">@Localizer.Get("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (list != null && list.Any())
                        {
                            int sr = 1;
                            foreach (var item in list)
                            {
                                <tr>
                                    <td class="text-center">@sr</td>
                                    <td>@item.CoScholastic</td>
                                    <td>@item.ClassName</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">@Localizer.Get("Active")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@Localizer.Get("Inactive")</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                             <permission controller="Exam" action="CoScholasticArea" type="delete">
                                                <a asp-action="CoScholasticArea"
                                                   asp-route-id="@item.CoScholasticAreaId"
                                                   asp-route-searchClassId="@Model.SearchClassId"
                                                   asp-route-searchCoScholasticId="@Model.SearchCoScholasticId"
                                                   class="btn btn-warning btn-sm d-flex align-items-center gap-1">
                                                    <i class="ti ti-pencil"></i> @Localizer.Get("Edit")
                                                </a>
                                            </permission>
                                             <permission controller="Exam" action="CoScholasticArea" type="delete">
                                                <form asp-action="DeleteCoScholasticArea"
                                                      class="d-inline"
                                                      onsubmit="return confirm('@Localizer.Get("Delete this record?")')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.CoScholasticAreaId" />
                                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success") d-flex align-items-center gap-1">
                                                        <i class="ti ti-trash"></i>
                                                        @(item.IsActive ? Localizer.Get("Delete") : Localizer.Get("Activate"))
                                                    </button>
                                                </form>
                                            </permission>
                                        </div>
                                    </td>
                                </tr>
                                sr++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">@Localizer.Get("No Record Found")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}