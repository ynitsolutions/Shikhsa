@model Shikhsa.ViewModels.CoScholasticGradeEntryVM

@if (Model != null)
{
    @if (Model.Students != null && Model.Students.Any())
    {
        <div class="card shadow">

            <div class="card-header text-white">

            </div>

            <div class="card-body p-0">

                <div class="table-scroll">

                    <table class="table table-bordered table-striped table-hover align-middle mb-0"
                           id="tblMarks">

                        <thead class="table-dark">

                            <tr>

                                <th style="width:70px">
                                    Sr.
                                </th>

                                <th style="width:130px">
                                    Admission No
                                </th>

                                <th style="min-width:220px">
                                    Student Name
                                </th>

                                @for (int c = 0; c < Model.Columns.Count; c++)
                                {
                                    <th class="text-center" style="min-width:170px">

                                        @Model.Columns[c].Title

                                        <br />

                                        <small class="text-warning">

                                            @Model.Columns[c].SubjectNameInLanguage

                                        </small>

                                    </th>
                                }

                                <th class="text-center" style="min-width:170px">

                                    @if (Model.IsClassTeacher.GetValueOrDefault())
                                    {
                                        <button type="button"
                                                class="btn btn-link btn-sm p-0"
                                                id="toggleAllFreeze"
                                                title="Freeze / Unfreeze All">

                                            <i id="toggleAllFreezeIcon"
                                               class="fa-solid fa-lock-open text-success fs-5"></i>

                                        </button>
                                    }
                                    else
                                    {
                                        <span>Action</span>
                                    }

                                </th>

                            </tr>

                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>

                                    <td class="text-center">

                                        @(i + 1)

                                        <input type="hidden"
                                               asp-for="Students[i].StudentId" />

                                    </td>

                                    <td>

                                        @Model.Students[i].AdmissionNo

                                    </td>

                                    <td>

                                        @Model.Students[i].StudentName

                                    </td>

                                    @for (int j = 0; j < Model.Columns.Count; j++)
                                    {
                                        @*  <td>

                                                <input type="hidden"
                                                       asp-for="Students[i].Grades[j].GradeEntryId" />

                                                <input type="hidden"
                                                       asp-for="Students[i].Grades[j].CoScholasticAreaId" />

                                                <select asp-for="Students[i].Grades[j].Grade"
                                                        class="form-select form-select-sm"
                                                        disabled="@Model.Students[i].IsFreeze">

                                                    <option value="">Select</option>

                                                    <option value="A+">A+</option>

                                                    <option value="A">A</option>

                                                    <option value="B+">B+</option>

                                                    <option value="B">B</option>

                                                    <option value="C">C</option>

                                                    <option value="D">D</option>

                                                    <option value="E">E</option>

                                                </select>

                                            </td> *@ 
                                                                 <td style="min-width:170px">
                                            <input type="hidden" asp-for="Students[i].Grades[j].GradeEntryId" />
                                            <input type="hidden" asp-for="Students[i].Grades[j].CoScholasticAreaId" />

                                            <div class="d-flex justify-content-center gap-2">

                                                @* @foreach (var grade in new[] { "A", "B", "C", "D" })
                                                        {
                                                            if (Model.Students[i].Grades[j].Grade == grade)
                                                            {
                                                                <input type="radio"
                                                                       name="Students[@i].Grades[@j].Grade"
                                                                       value="@grade"
                                                                       checked />
                                                            }
                                                            else
                                                            {
                                                                <input type="radio"
                                                                       name="Students[@i].Grades[@j].Grade"
                                                                       value="@grade" />
                                                            }

                                                            <label>@grade</label>
                                                        } *@
                                                @foreach (var grade in new[] { "A", "B", "C", "D" })
                                                {
                                                    var id = $"g_{i}_{j}_{grade}";

                                                    <input type="radio"
                                                           id="@id"
                                                           name="Students[@i].Grades[@j].Grade"
                                                           value="@grade"
                                                           checked="@(Model.Students[i].Grades[j].Grade == grade)" />

                                                    <label for="@id">@grade</label>
                                                }
                                            </div>

                                        </td>
                                    }

                                    @*     <td class="text-center">

                                            @if (Model.Students[i].IsFreeze)
                                            {
                                                <span class="badge bg-danger">

                                                    <i class="fa fa-lock"></i>

                                                    Un-Freeze

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">

                                                    <i class="fa fa-unlock"></i>

                                                   Freeze

                                                </span>
                                            }

                                        </td> *@
                                    <td class="text-center">

                                        @if (Model.IsClassTeacher.GetValueOrDefault())
                                        {
                                            <input asp-for="Students[i].IsFreeze" class="freeze-value" type="hidden" />

                                            @*  <button type="button" class="btn btn-sm btn-link toggle-freeze p-0">

                                                        <i class="freeze-icon fa-solid @(Model.Students[i].IsFreeze ? "fa-lock text-danger" : "fa-lock-open text-success") fs-5"></i>

                                                    </button> *@
                                            <button type="button"
                                                    class="btn btn-sm btn-link toggle-freeze p-0">

                                                <i class="freeze-icon fa-solid @(Model.Students[i].IsFreeze ? "fa-lock text-danger" : "fa-lock-open text-success") fs-5"></i>

                                            </button>
                                        }
                                        else
                                        {
                                            @Html.HiddenFor(x => x.Students[i].IsFreeze)

                                            @*  <i class="fa-solid @(Model.Students[i].IsFreeze ? "fa-lock text-danger" : "fa-lock-open text-success") fs-5"></i> *@
                                        }

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            @*     <div class="card-footer text-end">

                    <button type="submit"
                                asp-action="CoScholasticMarkEntry"
                            class="btn btn-primary">

                        <i class="fa fa-save"></i>

                        Save Grades

                    </button>

                </div> *@
            <div class="card-footer d-flex justify-content-end gap-2">

                <button type="submit"
                        asp-action="ExportCoScholasticExcel"
                        class="btn btn-success">

                    <i class="fa fa-file-excel"></i>
                    Export Excel

                </button>

                <button type="submit"
                        asp-action="CoScholasticMarkEntry"
                        class="btn btn-primary">

                    <i class="fa fa-save"></i>
                    Save Grades

                </button>

            </div>

        </div>
    }
}
