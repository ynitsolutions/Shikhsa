@model Shikhsa.ViewModels.CoScholasticGradeEntryVM

@if (Model != null && Model.Students != null && Model.Students.Any())
{
    <div class="card shadow">

        <div class="card-header text-white">
            <!-- Optional header content -->
        </div>

        <div class="card-body p-0">

            <div class="table-scroll">

                <table class="table table-bordered table-striped table-hover align-middle mb-0 datatable"
                       id="tblMarks">

                    <thead class="table-dark">
                        <tr>
                            <th style="width:70px; min-width:50px;">#</th>
                            <th style="min-width:130px;">@Localizer.Get("Admission No")</th>
                            <th style="min-width:200px;">@Localizer.Get("Student") @Localizer.Get("Name")</th>

                            @for (int c = 0; c < Model.Columns.Count; c++)
                            {
                                <th class="text-center" style="min-width:160px;">
                                    @Model.Columns[c].Title
                                    <br />
                                    <small class="text-warning">@Model.Columns[c].SubjectNameInLanguage</small>
                                </th>
                            }

                            <th class="text-center" style="min-width:120px;">
                                @if (Model.IsClassTeacher.GetValueOrDefault())
                                {
                                    <button type="button"
                                            class="btn btn-link btn-sm p-0"
                                            id="toggleAllFreeze"
                                            title="Freeze / Unfreeze All">
                                        <i id="toggleAllFreezeIcon"
                                           class="fa-solid fa-lock-open text-success fs-5"></i>
                                    </button>
                                }
                                else
                                {
                                    <span>@Localizer.Get("Action")</span>
                                }
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.Students.Count; i++)
                        {
                            <tr>
                                <td class="text-center">
                                    @(i + 1)
                                    <input type="hidden" asp-for="Students[i].StudentId" />
                                </td>

                                <td>@Model.Students[i].AdmissionNo</td>

                                <td>@Model.Students[i].StudentName</td>

                                @for (int j = 0; j < Model.Columns.Count; j++)
                                {
                                    <td style="min-width:160px;">
                                        <input type="hidden" asp-for="Students[i].Grades[j].GradeEntryId" />
                                        <input type="hidden" asp-for="Students[i].Grades[j].CoScholasticAreaId" />

                                        <!-- Grade radio buttons – wrapped and spaced for small screens -->
                                        <div class="d-flex flex-wrap justify-content-center gap-1 gap-sm-2 grade-group">
                                            @foreach (var grade in new[] { "A", "B", "C", "D" })
                                            {
                                                var id = $"g_{i}_{j}_{grade}";
                                                <div class="form-check form-check-inline m-0">
                                                    <input type="radio"
                                                           id="@id"
                                                           name="Students[@i].Grades[@j].Grade"
                                                           value="@grade"
                                                           class="form-check-input"
                                                           checked="@(Model.Students[i].Grades[j].Grade == grade)" />
                                                    <label class="form-check-label small" for="@id">@grade</label>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                }

                                <!-- Freeze/Unfreeze column -->
                                <td class="text-center">
                                    @if (Model.IsClassTeacher.GetValueOrDefault())
                                    {
                                        <input asp-for="Students[i].IsFreeze" class="freeze-value" type="hidden" />
                                        <button type="button" class="btn btn-sm btn-link toggle-freeze p-0">
                                            <i class="freeze-icon fa-solid @(Model.Students[i].IsFreeze ? "fa-lock text-danger" : "fa-lock-open text-success") fs-5"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        @Html.HiddenFor(x => x.Students[i].IsFreeze)
                                        <i class="fa-solid @(Model.Students[i].IsFreeze ? "fa-lock text-danger" : "fa-lock-open text-success") fs-5"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

        <!-- Footer Actions – responsive with flex-wrap -->
        <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
            <button type="submit"
                    asp-action="ExportCoScholasticExcel"
                    class="btn btn-success btn-sm d-flex align-items-center gap-1">
                <i class="fa fa-file-excel"></i> @Localizer.Get("Export Excel")
            </button>
            <button type="submit"
                    asp-action="CoScholasticMarkEntry"
                    class="btn btn-primary btn-sm d-flex align-items-center gap-1">
                <i class="fa fa-save"></i> @Localizer.Get("Save Grades")
            </button>
        </div>

    </div>
}

