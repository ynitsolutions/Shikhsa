@model Shikhsa.ViewModels.GradingCriteriaVM

@{
    ViewData["Title"] = "Manage Grading Criteria";
}

<div class="container-fluid mt-4">

    <div class="page-card">

        <div class="page-header">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h3>
                        <i class="bi bi-list-check"></i>
                        @Localizer.Get("Manage Grading Criteria")
                    </h3>
                    <small>
                        @Localizer.Get("Define and manage grading criteria for student evaluations.")
                    </small>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#bulkModal">
                        <i class="bi bi-stack"></i>
                        @Localizer.Get("Bulk Create")
                    </button>
                    <button class="btn btn-light btn-sm">
                        <i class="bi bi-download"></i>
                        @Localizer.Get("Export CSV")
                    </button>
                </div>
            </div>
        </div>

        <div class="form-card">
            <form asp-action="SaveGradingCriteria" method="post">
                <input asp-for="Criteria.GradingCriteriaId" type="hidden" />

                <div class="section-title">
                    <i class="bi bi-plus-circle-fill text-primary"></i>
                    @Localizer.Get("Add New Grading Criteria")
                </div>

                <div class="row g-3">
                    <!-- Term -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Select Term")</label>
                        <select asp-for="Criteria.TermId"
                                asp-items="Model.Terms"
                                class="form-control select2 required">
                            <option value="">@Localizer.Get("Select Term")</option>
                        </select>
                        <span asp-validation-for="Criteria.TermId" class="text-danger"></span>
                    </div>

                    <!-- Class -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Class")</label>
                        <select asp-for="Criteria.ClassId" class="form-control select2 required">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in Model.Classes)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                        <span asp-validation-for="Criteria.ClassId" class="text-danger"></span>
                    </div>

                    <!-- Batch -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Batch")</label>
                        <select asp-for="Criteria.BatchId" class="form-control select2 required">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in Model.Batches)
                            {
                                <option value="@item.BatchId">@item.AcademicYear</option>
                            }
                        </select>
                        <span asp-validation-for="Criteria.BatchId" class="text-danger"></span>
                    </div>

                    <!-- Min % -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Minimum Percentage")</label>
                        <input asp-for="Criteria.MinPercentage"
                               class="form-control required"
                               placeholder="@Localizer.Get("Enter Min %")" />
                        <span asp-validation-for="Criteria.MinPercentage" class="text-danger"></span>
                    </div>

                    <!-- Max % -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Maximum Percentage")</label>
                        <input asp-for="Criteria.MaxPercentage"
                               class="form-control required"
                               placeholder="@Localizer.Get("Enter Max %")" />
                        <span asp-validation-for="Criteria.MaxPercentage" class="text-danger"></span>
                    </div>

                    <!-- Grade -->
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer.Get("Grade")</label>
                        <input asp-for="Criteria.Grade"
                               class="form-control required"
                               placeholder="A+, A, B, C..." />
                        <span asp-validation-for="Criteria.Grade" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label">@Localizer.Get("Grade Description")</label>
                        <textarea asp-for="Criteria.Description"
                                  class="form-control required textspaceonly"
                                  rows="2"
                                  placeholder="@Localizer.Get("Enter grade description")"></textarea>
                    </div>
                </div>

                <div class="text-end mt-3">
                    <button class="btn btn-purple px-5">
                        <i class="bi bi-check-circle"></i>
                        @Localizer.Get("Submit")
                    </button>
                </div>
            </form>

            <!-- List Grid -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-white">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="mb-0">
                            <i class="bi bi-table"></i>
                            @Localizer.Get("Grading Criteria List")
                        </h5>
                        <button class="btn btn-success btn-sm" id="btnRefresh">
                            <i class="bi bi-arrow-clockwise"></i>
                            @Localizer.Get("Refresh")
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="gridContainer">
                        @await Html.PartialAsync("_Grid", Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Modal -->
<div class="modal fade" id="bulkModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="BulkCreate" asp-controller="Grading" method="post" id="bulkForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer.Get("Bulk Create Grading Criteria")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Batch")</label>
                            <select asp-for="Criteria.BatchId"
                                    asp-items="@(new SelectList(Model.Batches, "BatchId", "AcademicYear"))"
                                    class="form-control select2 required">
                                <option value="">@Localizer.Get("Select Batch")</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Class")</label>
                            <select asp-for="Criteria.ClassId" class="form-control select2 required">
                                <option value="">@Localizer.Get("Select")</option>
                                @foreach (var item in Model.Classes)
                                {
                                    <option value="@item.DataListItemId">@item.DataListItemText</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer.Get("Term")</label>
                            <select asp-for="Criteria.TermId"
                                    asp-items="Model.Terms"
                                    class="form-control select2 required">
                                <option value="">@Localizer.Get("Select Term")</option>
                            </select>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered" id="tblBulk">
                            <thead>
                                <tr>
                                    <th>@Localizer.Get("Min %")</th>
                                    <th>@Localizer.Get("Max %")</th>
                                    <th>@Localizer.Get("Grade")</th>
                                    <th>@Localizer.Get("Description")</th>
                                    <th style="width:60px;">
                                        <button type="button" id="btnAddRow" class="btn btn-success btn-sm">+</button>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><input asp-for="GradeRanges[0].MinPercentage" class="form-control required" /></td>
                                    <td><input asp-for="GradeRanges[0].MaxPercentage" class="form-control required" /></td>
                                    <td><input asp-for="GradeRanges[0].Grade" class="form-control required" /></td>
                                    <td><input asp-for="GradeRanges[0].Description" class="form-control required" /></td>
                                    <td>
                                        <button type="button" class="btn btn-danger btnRemove">X</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer.Get("Close")</button>
                    <button type="submit" class="btn btn-primary">@Localizer.Get("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
       

        // Edit button handler
        $(document).on("click", ".btnEdit", function() {
            var id = $(this).data("id");
            $.get("/Grading/SaveGradingCriteria/" + id, function(res) {
                $("#Criteria_GradingCriteriaId").val(res.gradingCriteriaId);
                $("#Criteria_TermId").val(res.termId).trigger("change");
                $("#Criteria_ClassId").val(res.classId).trigger("change");
                $("#Criteria_BatchId").val(res.batchId).trigger("change");
                $("#Criteria_MinPercentage").val(res.minPercentage);
                $("#Criteria_MaxPercentage").val(res.maxPercentage);
                $("#Criteria_Grade").val(res.grade);
                $("#Criteria_Description").val(res.description);
                $("html, body").animate({ scrollTop: 0 }, 500);
            });
        });

        // Delete button handler
        $(document).on("click", ".btnDelete", function() {
            if (!confirm("Delete this record?")) return;
            var id = $(this).data("id");
            location.href = "/Grading/DeleteGradingCriteria/" + id;
        });

        // Bulk row management
        var index = 1;
        $("#btnAddRow").click(function() {
            var row = `<tr>
                        <td><input class="form-control required" name="GradeRanges[${index}].MinPercentage"/></td>
                        <td><input class="form-control required" name="GradeRanges[${index}].MaxPercentage"/></td>
                        <td><input class="form-control required" name="GradeRanges[${index}].Grade"/></td>
                        <td><input class="form-control required" name="GradeRanges[${index}].Description"/></td>
                        <td><button type="button" class="btn btn-danger btnRemove">X</button></td>
                    </tr>`;
            $("#tblBulk tbody").append(row);
            index++;
        });

        $(document).on("click", ".btnRemove", function() {
            $(this).closest("tr").remove();
        });
    </script>
}