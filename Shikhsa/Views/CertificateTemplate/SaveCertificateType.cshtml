@model Shikhsa.Models.Certificate.CertificateTypeMaster
@{
    bool isEdit = Model.CertificateTypeId != 0;
    ViewData["Title"] = isEdit
        ? @Localizer.Get("Edit Certificate Type")
        : @Localizer.Get("New Certificate Type");
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>

                <div class="card-body">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger py-2">@TempData["Error"]</div>
                    }

                    <form method="post" asp-action="SaveCertificateType">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CertificateTypeId" value="@Model.CertificateTypeId" />

                        <div class="mb-3">
                            <label class="form-label">@Localizer.Get("Type Name")</label>
                            <input type="text" name="TypeName" value="@Model.TypeName" required
                                   placeholder="@Localizer.Get("e.g. Bonafide Certificate")"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer.Get("Type Code")</label>
                            <input type="text" name="TypeCode" value="@Model.TypeCode" required
                                   placeholder="@Localizer.Get("e.g. BONAFIDE")"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer.Get("Applies To")</label>
                            <select name="AppliesTo" class="form-select">
                                <option value="Student" selected="@(Model.AppliesTo == "Student" ? "selected" : null)">
                                    @Localizer.Get("Student")
                                </option>
                                <option value="Staff" selected="@(Model.AppliesTo == "Staff" ? "selected" : null)">
                                    @Localizer.Get("Staff")
                                </option>
                            </select>
                            <small class="text-muted d-block mt-1">
                                @Localizer.Get("Select Staff for types like Staff Experience Certificates — the person picker and auto-resolve feature will update accordingly.")
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer.Get("Display Order")</label>
                            <input type="number" name="DisplayOrder" value="@Model.DisplayOrder"
                                   class="form-control" />
                        </div>

                        <div class="form-check mb-3">
                            <input type="checkbox" id="chkActive" name="IsActive" value="true"
                                   checked="@(Model.IsActive ? "checked" : null)"
                                   class="form-check-input" />
                            <label class="form-check-label" for="chkActive">
                                @Localizer.Get("Active")
                            </label>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                @Localizer.Get("Save")
                            </button>
                            <a asp-action="CertificateType" class="btn btn-secondary px-4">
                                @Localizer.Get("Cancel")
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>