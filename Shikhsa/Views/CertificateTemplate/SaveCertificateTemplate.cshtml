@model Shikhsa.Models.Certificate.CertificateTemplate
@{
    bool isEdit = Model.CertificateTemplateId != 0;
    ViewData["Title"] = isEdit ? "Edit Certificate Template" : "New Certificate Template";

    var certificateTypes = ViewBag.CertificateTypes as List<Shikhsa.Models.Certificate.CertificateTypeMaster> ?? new();
    var categories = ViewBag.Categories as List<Shikhsa.Models.Notification.NotificationCategory> ?? new();
    var placeholders = ViewBag.Placeholders as List<Shikhsa.Models.Notification.NotificationPlaceholder> ?? new();
    var selectedCategories = ViewBag.SelectedCategories as List<long> ?? new();

    var placeholderGroups = placeholders
        .GroupBy(p => p.NotificationCategory.CategoryName)
        .OrderBy(g => g.First().NotificationCategory.DisplayOrder)
        .ToList();
}

@* <link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css" rel="stylesheet" /> *@

<div class="tpl-page">
    <div class="tpl-header">Certificate Template</div>

    <form method="post" asp-action="SaveCertificateTemplate" id="tplForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CertificateTemplateId" value="@Model.CertificateTemplateId" />

        @if (TempData["Error"] != null)
        {
            <div class="tpl-alert tpl-alert--error">@TempData["Error"]</div>
        }

        <div class="tpl-row">
            <div class="tpl-field">
                <label>Template Name</label>
                <input type="text" name="TemplateName" value="@Model.TemplateName" required placeholder="e.g. Bonafide Certificate - Standard" />
            </div>
            <div class="tpl-field">
                <label>Template Code</label>
                <input type="text" name="TemplateCode" value="@Model.TemplateCode" required placeholder="e.g. BONAFIDE_STANDARD" />
            </div>
        </div>

        <div class="tpl-row">
            <div class="tpl-field">
                <label>Certificate Type</label>
                <select name="CertificateTypeId" required>
                    <option value="">--Select Certificate Type--</option>
                    @foreach (var t in certificateTypes)
                    {
                        <option value="@t.CertificateTypeId" selected="@(Model.CertificateTypeId == t.CertificateTypeId ? "selected" : null)">
                            @t.TypeName (@t.AppliesTo)
                        </option>
                    }
                </select>
                @if (!certificateTypes.Any())
                {
                    <p style="font-size:12px;color:#dc2626;margin-top:4px;">
                        Koi certificate type nahi mila.
                        <a asp-controller="CertificateType" asp-action="SaveCertificateType">Pehle ek type banao</a>
                        (e.g. Bonafide Certificate, Migration Certificate, Internship Certificate,
                        Attendance Certificate, Staff Experience Certificate).
                    </p>
                }
            </div>
            <div class="tpl-field">
                <label>Categories</label>
                <div class="chip-input" id="categoryInput">
                    <div class="chips" id="chipsContainer"></div>
                    <select id="categoryPicker">
                        <option value="">+ Add category...</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.NotificationCategoryId">@c.CategoryName</option>
                        }
                    </select>
                </div>
                <div id="categoryHiddenInputs"></div>
            </div>
        </div>

        <div class="tpl-body-heading">Template Body</div>

        <div class="tpl-body-grid">
            @* ---------- LEFT: Available Placeholders (live from NotificationPlaceholder) ---------- *@
            <div class="ph-panel">
                <div class="ph-panel__title">Available Placeholders</div>
                <input type="text" id="phSearch" class="ph-search" placeholder="Search Placeholder..." />

                <div class="ph-tabs" id="phTabs">
                    @for (int i = 0; i < placeholderGroups.Count; i++)
                    {
                        <button type="button" class="ph-tab @(i == 0 ? "active" : "")" data-group="@placeholderGroups[i].Key">@placeholderGroups[i].Key</button>
                    }
                </div>

                <div class="ph-list" id="phList">
                    @for (int i = 0; i < placeholderGroups.Count; i++)
                    {
                        var group = placeholderGroups[i];
                        <div class="ph-group" data-group="@group.Key" style="@(i == 0 ? "" : "display:none;")">
                            @foreach (var item in group)
                            {
                                string token = $"{{{{{group.Key}.{item.PlaceholderCode}}}}}";
                                <div class="ph-item" data-token="@token" data-label="@item.DisplayName" title="Click to insert">
                                    <strong>@item.DisplayName</strong>
                                    <span>@(group.Key + "." + item.PlaceholderCode)</span>
                                </div>
                            }
                        </div>
                    }
                    @if (!placeholderGroups.Any())
                    {
                        <p style="font-size:12px;color:#6b7280;">
                            Koi placeholder nahi mila. Notification &gt; Placeholder screen se
                            categories/placeholders add karo (e.g. category "Certificate" banao
                            aur usme TotalWorkingDays, ReasonForLeaving jaise manual-entry
                            fields, ya "Staff" category banao Experience Certificate ke liye).
                        </p>
                    }
                </div>
            </div>

            @* ---------- RIGHT: Rich text editor ---------- *@
            <div class="editor-panel">
                <div id="quillEditor"></div>
                <textarea name="Body" id="bodyHtmlHidden" style="display:none;">@Model.Body</textarea>
            </div>
        </div>

        <div class="tpl-actions">
            <button type="submit" class="btn btn--primary">Save Template</button>
            <a asp-action="CertificateTemplate" class="btn btn--ghost">Cancel</a>
        </div>
    </form>
</div>

<style>
    .tpl-page { max-width:1200px; margin:24px auto; font-family:'Segoe UI', Arial, sans-serif; }
    .tpl-header { background:#2563eb; color:#fff; font-weight:600; padding:14px 18px; border-radius:8px 8px 0 0; font-size:16px; }
    #tplForm { border:1px solid #e5e7eb; border-top:none; border-radius:0 0 8px 8px; padding:24px; background:#fff; }
    .tpl-alert { padding:10px 14px; border-radius:6px; margin-bottom:16px; font-size:13px; }
    .tpl-alert--error { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }

    .tpl-row { display:flex; gap:24px; margin-bottom:18px; }
    .tpl-field { flex:1; }
    .tpl-field label { display:block; font-size:13px; color:#374151; margin-bottom:6px; font-weight:500; }
    .tpl-field input[type="text"], .tpl-field select {
        width:100%; padding:9px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; background:#f8f8fc;
    }

    .chip-input { border:1px solid #d1d5db; border-radius:6px; padding:6px 8px; display:flex; flex-wrap:wrap; gap:6px; align-items:center; background:#f8f8fc; }
    .chips { display:flex; flex-wrap:wrap; gap:6px; }
    .chip { background:#eef0f3; border-radius:5px; padding:4px 8px; font-size:12px; display:flex; align-items:center; gap:6px; }
    .chip button { border:none; background:none; cursor:pointer; color:#6b7280; font-size:12px; }
    #categoryPicker { border:none; outline:none; flex:1; min-width:120px; padding:4px; background:transparent; font-size:13px; }

    .tpl-body-heading { font-weight:600; font-size:14px; margin:10px 0 12px; }
    .tpl-body-grid { display:flex; gap:16px; align-items:flex-start; }

    .ph-panel { flex:0 0 270px; border:1px solid #e5e7eb; border-radius:8px; padding:14px; background:#fafafa; max-height:520px; overflow-y:auto; }
    .ph-panel__title { background:#2563eb; color:#fff; font-size:13px; font-weight:600; padding:8px 10px; border-radius:6px; margin-bottom:10px; }
    .ph-search { width:100%; padding:7px 10px; border:1px solid #d1d5db; border-radius:6px; font-size:12px; margin-bottom:10px; }
    .ph-tabs { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
    .ph-tab { border:none; background:#eef0f3; color:#374151; font-size:11px; padding:5px 9px; border-radius:5px; cursor:pointer; }
    .ph-tab.active { background:#2563eb; color:#fff; }
    .ph-item { padding:8px 6px; border-bottom:1px solid #eee; cursor:pointer; font-size:12px; }
    .ph-item:hover { background:#eef2ff; }
    .ph-item strong { display:block; color:#111827; }
    .ph-item span { color:#6b7280; font-family:monospace; font-size:11px; }

    .editor-panel { flex:1; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden; }
    #quillEditor { min-height:420px; background:#fff; font-size:14px; }

    .tpl-actions { margin-top:20px; display:flex; gap:10px; }
    .btn { padding:10px 20px; border-radius:8px; font-size:14px; cursor:pointer; text-decoration:none; display:inline-block; }
    .btn--primary { background:#2563eb; color:#fff; border:none; }
    .btn--primary:hover { background:#1d4ed8; }
    .btn--ghost { background:#f3f4f6; color:#374151; }
</style>

