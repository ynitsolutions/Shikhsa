<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        /* =========================================================
           CKEDITOR
           ========================================================= */

        let editor = null;

        const editorElement =
            document.querySelector('#quillEditor');

        const bodyHidden =
            document.querySelector('#bodyHtmlHidden');

        if (editorElement && bodyHidden) {

            ClassicEditor
                .create(editorElement, {
                    toolbar: [
                        'heading',
                        '|',
                        'bold',
                        'italic',
                        'underline',
                        'strikethrough',
                        '|',
                        'fontSize',
                        'fontFamily',
                        '|',
                        'fontColor',
                        'fontBackgroundColor',
                        '|',
                        'alignment',
                        '|',
                        'bulletedList',
                        'numberedList',
                        '|',
                        'outdent',
                        'indent',
                        '|',
                        'link',
                        'blockQuote',
                        'insertTable',
                        '|',
                        'undo',
                        'redo'
                    ],

                    heading: {
                        options: [
                            {
                                model: 'paragraph',
                                title: 'Paragraph',
                                class: 'ck-heading_paragraph'
                            },
                            {
                                model: 'heading1',
                                view: 'h1',
                                title: 'Heading 1',
                                class: 'ck-heading_heading1'
                            },
                            {
                                model: 'heading2',
                                view: 'h2',
                                title: 'Heading 2',
                                class: 'ck-heading_heading2'
                            },
                            {
                                model: 'heading3',
                                view: 'h3',
                                title: 'Heading 3',
                                class: 'ck-heading_heading3'
                            }
                        ]
                    }
                })
                .then(function (createdEditor) {

                    editor = createdEditor;

                    /*
                     * Load existing HTML when editing
                     */
                    editor.setData(bodyHidden.value || '');

                    console.log('CKEditor initialized successfully.');
                })
                .catch(function (error) {

                    console.error(
                        'CKEditor initialization failed:',
                        error
                    );
                });
        }


        /* =========================================================
           FORM SUBMIT
           ========================================================= */

        const form =
            document.getElementById('tplForm');

        if (form) {

            form.addEventListener('submit', function () {

                /*
                 * Copy CKEditor HTML into hidden textarea
                 * before MVC form submission.
                 */
                if (editor && bodyHidden) {

                    bodyHidden.value =
                        editor.getData();
                }

                console.log(
                    'Certificate template body:',
                    bodyHidden ? bodyHidden.value : ''
                );
            });
        }


        /* =========================================================
           PLACEHOLDER TABS
           ========================================================= */

        const phTabs =
            document.querySelectorAll('.ph-tab');

        const phGroups =
            document.querySelectorAll('.ph-group');


        phTabs.forEach(function (tab) {

            tab.addEventListener('click', function () {

                /*
                 * Remove active class
                 * from all tabs.
                 */
                phTabs.forEach(function (item) {

                    item.classList.remove('active');

                });


                /*
                 * Activate clicked tab.
                 */
                tab.classList.add('active');


                const group =
                    tab.dataset.group;


                /*
                 * Show only selected group.
                 */
                phGroups.forEach(function (groupElement) {

                    if (groupElement.dataset.group === group) {

                        groupElement.style.display = '';

                    }
                    else {

                        groupElement.style.display = 'none';

                    }

                });

            });

        });


        /* =========================================================
           PLACEHOLDER SEARCH
           ========================================================= */

        const phSearch =
            document.getElementById('phSearch');


        if (phSearch) {

            phSearch.addEventListener('input', function (event) {

                const searchText =
                    event.target.value
                        .toLowerCase()
                        .trim();


                /*
                 * Empty search:
                 * show first category only.
                 */
                if (searchText.length === 0) {

                    phGroups.forEach(function (group, index) {

                        group.style.display =
                            index === 0 ? '' : 'none';

                    });


                    phTabs.forEach(function (tab, index) {

                        tab.classList.toggle(
                            'active',
                            index === 0
                        );

                    });

                    return;
                }


                /*
                 * Search all groups.
                 */
                phGroups.forEach(function (group) {

                    group.style.display = '';

                });


                phTabs.forEach(function (tab) {

                    tab.classList.remove('active');

                });


                /*
                 * Search individual placeholders.
                 */
                document
                    .querySelectorAll('.ph-item')
                    .forEach(function (item) {

                        const label =
                            (
                                item.dataset.label || ''
                            ).toLowerCase();

                        const token =
                            (
                                item.dataset.token || ''
                            ).toLowerCase();

                        const matched =
                            label.includes(searchText) ||
                            token.includes(searchText);

                        item.style.display =
                            matched ? '' : 'none';

                    });

            });

        }


        /* =========================================================
           PLACEHOLDER CLICK -> CKEDITOR
           ========================================================= */

        document
            .querySelectorAll('.ph-item')
            .forEach(function (item) {

                item.addEventListener('click', function () {

                    if (!editor) {

                        console.warn(
                            'CKEditor is not initialized yet.'
                        );

                        return;
                    }


                    const token =
                        item.dataset.token;


                    if (!token) {
                        return;
                    }


                    /*
                     * Insert placeholder into CKEditor.
                     */
                    editor.model.change(function (writer) {

                        editor.model.insertContent(
                            writer.createText(token)
                        );

                    });


                    /*
                     * Put focus back into editor.
                     */
                    editor.editing.view.focus();

                });

            });


        /* =========================================================
           CATEGORY CHIP SYSTEM
           ========================================================= */

        const chipsContainer =
            document.getElementById('chipsContainer');

        const categoryPicker =
            document.getElementById('categoryPicker');

        const hiddenInputsContainer =
            document.getElementById(
                'categoryHiddenInputs'
            );


        /*
         * Existing selected category IDs
         * supplied by Razor.
         */
        let selected =
            @Html.Raw(
                Json.Serialize(selectedCategories)
            );


        /*
         * Category ID -> Category Name
         */
        const categoryNames =
            @Html.Raw(
                Json.Serialize(
                    categories.ToDictionary(
                        c => c.NotificationCategoryId,
                        c => c.CategoryName
                    )
                )
            );


        /*
         * Make sure IDs are numbers.
         */
        selected =
            selected.map(function (id) {

                return Number(id);

            });


        /* =========================================================
           RENDER CATEGORY CHIPS
           ========================================================= */

        function renderChips() {

            if (!chipsContainer ||
                !hiddenInputsContainer) {

                return;
            }


            /*
             * Clear existing chips.
             */
            chipsContainer.innerHTML = '';

            /*
             * Clear hidden inputs.
             */
            hiddenInputsContainer.innerHTML = '';


            /*
             * Create chip for every selected category.
             */
            selected.forEach(function (id) {

                const chip =
                    document.createElement('div');

                chip.className = 'chip';


                const name =
                    categoryNames[id] || id;


                chip.innerHTML = `
                    <span>${escapeHtml(name)}</span>
                    <button type="button"
                            class="remove-category"
                            title="Remove">
                        ✕
                    </button>
                `;


                /*
                 * Remove category.
                 */
                const removeButton =
                    chip.querySelector(
                        '.remove-category'
                    );


                removeButton.addEventListener(
                    'click',
                    function () {

                        selected =
                            selected.filter(
                                function (x) {
                                    return x !== id;
                                }
                            );

                        renderChips();

                    }
                );


                chipsContainer.appendChild(chip);


                /*
                 * Hidden MVC input.
                 *
                 * POST:
                 *
                 * categoryIds=1
                 * categoryIds=2
                 * categoryIds=5
                 */
                const hidden =
                    document.createElement('input');

                hidden.type = 'hidden';

                hidden.name = 'categoryIds';

                hidden.value = id;


                hiddenInputsContainer
                    .appendChild(hidden);

            });

        }


        /* =========================================================
           ADD CATEGORY
           ========================================================= */

        if (categoryPicker) {

            categoryPicker.addEventListener(
                'change',
                function () {

                    const id =
                        parseInt(
                            categoryPicker.value,
                            10
                        );


                    /*
                     * Ignore invalid value.
                     */
                    if (!id) {

                        categoryPicker.value = '';

                        return;
                    }


                    /*
                     * Prevent duplicate category.
                     */
                    if (!selected.includes(id)) {

                        selected.push(id);

                        renderChips();

                    }


                    /*
                     * Reset dropdown.
                     */
                    categoryPicker.value = '';

                }
            );

        }


        /* =========================================================
           ESCAPE HTML
           ========================================================= */

        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return '';

            }


            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');

        }


        /* =========================================================
           INITIAL CATEGORY RENDER
           ========================================================= */

        renderChips();


        /* =========================================================
           DELETE TEMPLATE
           ========================================================= */

        const deleteButtons =
            document.querySelectorAll(
                '.delete-btn'
            );


        deleteButtons.forEach(function (button) {

            button.addEventListener(
                'click',
                async function () {

                    const id =
                        button.dataset.id;


                    if (!id) {

                        console.error(
                            'CertificateTemplateId missing.'
                        );

                        return;

                    }


                    /*
                     * Confirmation.
                     */
                    const confirmed =
                        confirm(
                            'Delete this certificate template?'
                        );


                    if (!confirmed) {
                        return;
                    }


                    /*
                     * Get Anti-Forgery token.
                     */
                    const tokenInput =
                        document.querySelector(
                            '#tokenForm input[name="__RequestVerificationToken"]'
                        );


                    const token =
                        tokenInput
                            ? tokenInput.value
                            : '';


                    try {

                        const response =
                            await fetch(
                                '@Url.Action("Delete", "CertificateTemplate")/' + id,
                                {
                                    method: 'POST',

                                    headers: {
                                        'RequestVerificationToken':
                                            token
                                    }
                                }
                            );


                        if (response.ok) {

                            /*
                             * Refresh page after delete.
                             */
                            window.location.reload();

                            return;
                        }


                        /*
                         * Try to read server response.
                         */
                        let message =
                            'Something went wrong while deleting.';


                        try {

                            const result =
                                await response.json();

                            if (result.message) {

                                message =
                                    result.message;

                            }

                        }
                        catch (e) {
                            // Response wasn't JSON.
                        }


                        if (typeof Swal !== 'undefined') {

                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: message,
                                confirmButtonText: 'OK'
                            });

                        }
                        else {

                            alert(message);

                        }

                    }
                    catch (error) {

                        console.error(
                            'Delete error:',
                            error
                        );


                        if (typeof Swal !== 'undefined') {

                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text:
                                    'Unable to delete the certificate template.',
                                confirmButtonText: 'OK'
                            });

                        }
                        else {

                            alert(
                                'Unable to delete the certificate template.'
                            );

                        }

                    }

                }
            );

        });


        /* =========================================================
           NEW TEMPLATE BUTTON / RESET
           ========================================================= */

        const newTemplateButtons =
            document.querySelectorAll(
                '[data-new-template]'
            );


        newTemplateButtons.forEach(function (button) {

            button.addEventListener(
                'click',
                function () {

                    /*
                     * This is optional.
                     * Your anchor normally handles this.
                     */
                    console.log(
                        'Creating new certificate template.'
                    );

                }
            );

        });


        /* =========================================================
           DEBUG
           ========================================================= */

        console.log(
            'Certificate Template page initialized.'
        );

    });
</script>
