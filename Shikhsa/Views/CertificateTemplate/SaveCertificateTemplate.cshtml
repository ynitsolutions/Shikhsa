@model List<Shikhsa.Models.Certificate.CertificateTemplate>
@{
    ViewData["Title"] = @Localizer.Get("Certificate Templates");
    var types = ViewBag.CertificateTypes as List<Shikhsa.Models.Certificate.CertificateTypeMaster> ?? new();
}

<div class="container-fluid py-3">
    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <h5 class="mb-0">@Localizer.Get("Certificate Templates")</h5>

            <a asp-controller="CertificateType" asp-action="CertificateType"
               class="btn btn-outline-light btn-sm">
                @Localizer.Get("Manage Certificate Types") &rarr;
            </a>
        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["Error"]</div>
            }

            <!-- Quick-create buttons -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var t in types)
                {
                    <a asp-action="SaveCertificateTemplate" asp-route-typeId="@t.CertificateTypeId"
                       class="btn btn-outline-primary btn-sm">
                        + @t.TypeName
                    </a>
                }
                @if (!types.Any())
                {
                    <span class="small text-muted">
                        @Localizer.Get("Create a Certificate Type first:")
                        <a asp-controller="CertificateType" asp-action="SaveCertificateType">
                            @Localizer.Get("New Certificate Type")
                        </a>
                    </span>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer.Get("Template Name")</th>
                            <th>@Localizer.Get("Code")</th>
                            <th>@Localizer.Get("Type")</th>
                            <th class="text-nowrap" style="width:220px;">@Localizer.Get("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    @Localizer.Get("No templates yet.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var t in Model)
                            {
                                <tr>
                                    <td>@t.TemplateName</td>
                                    <td><code>@t.TemplateCode</code></td>
                                    <td>
                                        @t.CertificateType?.TypeName
                                        <span class="text-muted">(@t.CertificateType?.AppliesTo)</span>
                                    </td>
                                    <td class="text-nowrap">
                                        <a asp-action="SaveCertificateTemplate"
                                           asp-route-id="@t.CertificateTemplateId"
                                           class="btn btn-warning btn-sm">
                                            @Localizer.Get("Edit")
                                        </a>

                                        <a asp-controller="CertificateGenerate"
                                           asp-action="DataEntry"
                                           asp-route-templateId="@t.CertificateTemplateId"
                                           class="btn btn-primary btn-sm">
                                            @Localizer.Get("Generate")
                                        </a>

                                        <button type="button"
                                                class="btn btn-danger btn-sm delete-btn"
                                                data-id="@t.CertificateTemplateId">
                                            @Localizer.Get("Delete")
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<form id="tokenForm" style="display:none;">@Html.AntiForgeryToken()</form>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('@Localizer.Get("Delete this template?")')) return;

                const res = await fetch('@Url.Action("Delete")/' + btn.dataset.id, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken':
                            document.querySelector('#tokenForm input[name="__RequestVerificationToken"]')?.value || ''
                    }
                });

                if (res.ok) {
                    window.location.reload();
                } else {
                    Swal.fire({
                            icon: 'error',
                            title: '@Localizer.Get("Error")',
                            text: res.message || '@Localizer.Get("Something went wrong.")',
                            confirmButtonText: 'OK'
                        });
                   // alert('@Localizer.Get("Error while deleting.")');
                }
            });
        });
    </script>
}