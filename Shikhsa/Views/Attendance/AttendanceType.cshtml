@model Shikhsa.ViewModels.AttendanceTypeVM

<div class="container-fluid">

    <div class="card shadow">

        @* <div class="card-header bg-primary text-white">
         
        </div> *@

        <div class="card-body">

            <form asp-action="SaveAttendanceType" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="AttendanceType.AttendanceTypeId" type="hidden" />

                <!-- Responsive form fields -->
                <div class="row g-3">

                    <div class="col-6 col-md-4 col-lg-3">
                        <label class="form-label">@Localizer.Get("Code")</label>
                        <input asp-for="AttendanceType.Code" class="form-control form-control-sm" />
                        <span asp-validation-for="AttendanceType.Code" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6 col-lg-5">
                        <label class="form-label">@Localizer.Get("Name")</label>
                        <input asp-for="AttendanceType.Name" class="form-control form-control-sm" />
                        <span asp-validation-for="AttendanceType.Name" class="text-danger small"></span>
                    </div>

                    <div class="col-6 col-md-4 col-lg-3">
                        <label class="form-label">@Localizer.Get("Display Order")</label>
                        <input asp-for="AttendanceType.DisplayOrder" class="form-control form-control-sm" />
                    </div>

                </div>

                <!-- Checkboxes in responsive row -->
                <div class="row g-3 mt-2">
                    <div class="col-6 col-md-3">
                        <div class="form-check">
                            <input asp-for="AttendanceType.IsLeave" class="form-check-input" />
                            <label asp-for="AttendanceType.IsLeave" class="form-check-label">
                                @Localizer.Get("Is Leave")
                            </label>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-check">
                            <input asp-for="AttendanceType.IsActive" class="form-check-input" />
                            <label asp-for="AttendanceType.IsActive" class="form-check-label">
                                @Localizer.Get("Active")
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button class="btn btn-success btn-sm d-flex align-items-center gap-1">
                        <i class="fa fa-save"></i>
                        @(Model.AttendanceType.AttendanceTypeId == 0 ? Localizer.Get("Save") : Localizer.Get("Update"))
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-sm d-flex align-items-center gap-1">
                        <i class="fa fa-times"></i> @Localizer.Get("Clear")
                    </a>
                </div>

            </form>

            <hr />

            <!-- Responsive Table with horizontal scroll -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle datatable">
                    <thead class="table-primary">
                        <tr>
                            <th style="width:50px;">#</th>
                            <th style="min-width:80px;">@Localizer.Get("Code")</th>
                            <th style="min-width:120px;">@Localizer.Get("Name")</th>
                            <th style="min-width:80px;">@Localizer.Get("Leave")</th>
                            <th style="min-width:80px;">@Localizer.Get("Active")</th>
                            <th style="min-width:80px;">@Localizer.Get("Order")</th>
                            <th style="min-width:150px;">@Localizer.Get("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sr = 1;
                        }
                        @foreach (var item in Model.AttendanceTypes)
                        {
                            <tr>
                                <td>@sr</td>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@(item.IsLeave ? "Yes" : "No")</td>
                                <td>@(item.IsActive ? "Yes" : "No")</td>
                                <td>@item.DisplayOrder</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <permission controller="Attendance" action="AttendanceType" type="edit">
                                            <a asp-action="AttendanceType" asp-route-id="@item.AttendanceTypeId"
                                               class="btn btn-warning btn-sm d-flex align-items-center gap-1">
                                                <i class="fa fa-edit"></i> @Localizer.Get("Edit")
                                            </a>
                                        </permission>
                                        <permission controller="Attendance" action="AttendanceType" type="delete">
                                            <a asp-action="DeleteAttendanceTypee"
                                               asp-route-id="@item.AttendanceTypeId"
                                               onclick="return confirm('Delete this record?')"
                                               class="btn btn-danger btn-sm d-flex align-items-center gap-1">
                                                <i class="fa fa-trash"></i> @Localizer.Get("Delete")
                                            </a>
                                        </permission>
                                    </div>
                                </td>
                            </tr>
                            sr++;
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>

</div>