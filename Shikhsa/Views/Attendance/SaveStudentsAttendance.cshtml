@model Shikhsa.ViewModels.StudentAttendanceVM

@{
    ViewData["Title"] = "Student Attendance";
}

<style>
    .table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: auto;
        max-height: 600px;
        white-space: nowrap;
    }

        .table-scroll table {
            width: max-content;
            min-width: 100%;
        }

    .card, .card-body {
        overflow: hidden;
    }

    .toggle-freeze {
        border: none;
        background: none;
        padding: 0;
    }

        .toggle-freeze i {
            font-size: 20px;
            cursor: pointer;
            transition: .2s;
        }

            .toggle-freeze i:hover {
                transform: scale(1.15);
            }

    /* Responsive tweaks for small screens */
    @@media (max-width: 576px) {
        .btn-load {
            font-size: 0.9rem;
        }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form id="frmMarks" asp-controller="Exam" asp-action="ExamMarksEntry" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- Responsive Filter Row -->
            <div class="row g-2 g-md-3 align-items-end">

                <!-- Shared Student Filter Partial – ensure it also uses responsive grid -->
                <partial name="~/Views/Shared/_StudentFilterPartial.cshtml" model="Model" />

                <!-- Term (ExamCategoryId) -->
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <label asp-for="ExamCategoryId" class="form-label">@Localizer.Get("Term")</label>
                    <select asp-for="ExamCategoryId" class="form-select form-select-sm">
                        <option value="">@Localizer.Get("Select")</option>
                        <!-- Options would be populated from ViewBag -->
                    </select>
                </div>

                <!-- Date -->
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <label class="form-label">@Localizer.Get("Date")</label>
                    <input asp-for="AttendanceDate" type="date" class="form-control form-control-sm" />
                </div>

                <!-- Load Button -->
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <button type="submit" class="btn btn-primary w-100 btn-load" id="btnLoadStudents">
                        <i class="fa fa-search"></i> @Localizer.Get("Load") @Localizer.Get("Students")
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Container for the student list (partial) -->
    <div id="marksContainer">
        <partial name="_StudentsAttendanceList" model="Model" />
    </div>
</form>

@section Scripts {
    <!-- Your existing scripts for loading and handling marks -->
    <script src="~/js/teacher-filter.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Any initialisation for DataTable, etc.
        });

        // AJAX load students (similar to attendance)
        $(document).on("click", "#btnLoadStudents", function(e) {
            e.preventDefault();

            $.ajax({
                url: "/Exam/LoadStudents", // adjust URL as needed
                type: "POST",
                data: $("#frmMarks").serialize(),
                beforeSend: function() {
                    $("#btnLoadStudents")
                        .prop("disabled", true)
                        .html('<i class="fa fa-spinner fa-spin"></i> Loading...');
                },
                success: function(html) {
                    $("#marksContainer").html(html);
                    // Re-init any DataTables or summary updates
                },
                complete: function() {
                    $("#btnLoadStudents")
                        .prop("disabled", false)
                        .html('<i class="fa fa-search"></i> Load Students');
                },
                error: function(xhr) {
                    console.log(xhr.responseText);
                }
            });
        });
    </script>
}