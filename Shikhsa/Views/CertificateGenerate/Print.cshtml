@model Shikhsa.Models.Certificate.GeneratedCertificate
@{
    ViewData["Title"] = "Print Certificate";
}

<div class="print-toolbar no-print">
    <a asp-controller="CertificateTemplate" asp-action="CertificateTemplate">&larr; Back to Templates</a>
    <button onclick="window.print()">🖨️ Print Certificate</button>
</div>

<div class="certificate-sheet">
    @Html.Raw(Model.FinalBodyHtml)
</div>

<style>
    .print-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 800px;
        margin: 16px auto;
    }

        .print-toolbar a {
            color: #2563eb;
            text-decoration: none;
            font-size: 14px;
        }

        .print-toolbar button {
            background: #16a34a;
            color: #fff;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
        }

            .print-toolbar button:hover {
                background: #15803d;
            }

    .certificate-sheet {
        border: 2px solid #333;
        padding: 28px 34px;
        font-family: 'Times New Roman', serif;
        background: #fffdf6;
        max-width: 800px;
        margin: 0 auto 40px;
    }

        .certificate-sheet h1, .certificate-sheet h2 {
            text-align: center;
        }

    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: #fff;
        }

        .certificate-sheet {
            border: 2px solid #000;
            box-shadow: none;
            margin: 0;
        }
    }
</style>
