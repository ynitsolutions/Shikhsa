@model Shikhsa.Models.StaffMaster

<div class="card shadow-sm">

    <div class="card-header bg-light">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0">

                <i class="ti ti-briefcase"></i>

                Experience Details

            </h5>

            <button type="button"
                    class="btn btn-primary"
                    id="btnAddExperience">

                <i class="ti ti-plus"></i>

                Add Experience

            </button>

        </div>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-bordered table-hover mb-0"
                   id="tblExperience">

                <thead class="table-primary">

                    <tr>

                        <th>#</th>

                        <th>Designation</th>

                        <th>Department</th>

                        <th>Organisation</th>

                        <th>Subject</th>

                        <th>From</th>

                        <th>To</th>

                        <th>Experience</th>

                        <th>Salary</th>

                        <th>Letter</th>

                        <th width="120">Action</th>
                        <th style="display:none"></th>
                        <th style="display:none"></th>
                    </tr>

                </thead>

                <tbody>

               
                </tbody>

            </table>

        </div>

    </div>

</div>


<div class="modal fade"
     id="ExperienceModal">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5>

                    Experience Details

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <div class="row g-3">

                    <input type="hidden"
                           id="ExperienceIndex" />

                    <div class="col-lg-4">

                        <label>

                            Department

                        </label>

                        <select id="ExperienceDepartmentId"
                                class="form-select select2 required">

                            <option value="">Select</option>

                            @foreach (var item in ViewBag.Department)
                            {
                                <option value="@item.DataListItemId">

                                    @item.DataListItemText

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-4">

                        <label>

                            Designation

                        </label>

                        <select id="ExperienceDesignationId"
                                class="form-select select2 required">

                            <option value="">Select</option>

                            @foreach (var item in ViewBag.Designation)
                            {
                                <option value="@item.DataListItemId">

                                    @item.DataListItemText

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-4">

                        <label>

                            Subject

                        </label>

                        <input type="text" id="ExperienceSubject" class="form-control required" />

                    </div>

                    <div class="col-lg-6">

                        <label>

                            Organisation Name

                        </label>

                        <input type="text" id="OrganisationName" class="form-control required" />

                    </div>

                    <div class="col-lg-3">

                        <label>

                            From Date

                        </label>

                        <input type="date" id="FromDate" class="form-control required" />

                    </div>

                    <div class="col-lg-3">

                        <label>

                            To Date

                        </label>

                        <input type="date" id="ToDate" class="form-control required" />

                    </div>

                    <div class="col-lg-4">

                        <label>

                            Years

                        </label>

                        <input type="text"
                               id="ExperienceYears"
                               readonly
                               class="form-control" />

                    </div>

                    <div class="col-lg-4">

                        <label>

                            Months

                        </label>

                        <input type="text"
                               id="ExperienceMonths"
                               readonly
                               class="form-control" />

                    </div>

                    <div class="col-lg-4">

                        <label>

                            Days

                        </label>

                        <input type="text"
                               id="ExperienceDays"
                               readonly
                               class="form-control" />

                    </div>

                    <div class="col-lg-4">

                        <label>

                            Last Drawn Salary

                        </label>

                        <input type="number" id="LastSalary" class="form-control required" />

                    </div>

                    <div class="col-lg-4">

                        <label>

                            Experience Letter

                        </label>

                        <input type="file"
                               id="ExperienceLetterFile"
                               class="form-control" />
                        <a id="ExperienceLetterPreview"
                           href="#"
                           target="_blank"
                           style="display:none">
                            View Existing Letter
                        </a>
                    </div>

                    <div class="col-lg-12">

                        <label>

                            Remarks

                        </label>

<textarea id="ExperienceRemarks"
          rows="2"
          class="form-control">

</textarea>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-success"
                        id="btnExperienceSave">

                    <i class="ti ti-device-floppy"></i>

                    Save

                </button>

                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>