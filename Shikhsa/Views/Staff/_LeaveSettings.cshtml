@model Shikhsa.Models.StaffLeaveSetting

<div class="card shadow-sm">

    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="ti ti-calendar"></i>
            @Localizer.Get("Leave & Attendance Settings")
        </h5>
    </div>

    <div class="card-body">

        <!-- ========== SECTION: Leave Group, Shift, Weekly Off ========== -->
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label">@Localizer.Get("Leave Group")</label>
                <select asp-for="LeaveGroupId" asp-items="ViewBag.LeaveGroups" class="form-select select2">
                    <option value="">@Localizer.Get("Select")</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">@Localizer.Get("Shift")</label>
                <select asp-for="ShiftId" asp-items="ViewBag.Shifts" class="form-select select2">
                    <option value="">@Localizer.Get("Select")</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">@Localizer.Get("Weekly Off")</label>
                <select asp-for="WeeklyOffId" asp-items="ViewBag.WeeklyOffList" class="form-select select2">
                    <option value="">@Localizer.Get("Select")</option>
                </select>
            </div>
        </div>

        <hr />

        <!-- ========== SECTION: Leave Balance ========== -->
        <h5 class="text-primary">@Localizer.Get("Leave Balance")</h5>
        <div class="row g-3">
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">@Localizer.Get("CL")</label>
                <input asp-for="CasualLeave" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">@Localizer.Get("SL")</label>
                <input asp-for="SickLeave" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">@Localizer.Get("EL")</label>
                <input asp-for="EarnedLeave" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">@Localizer.Get("ML")</label>
                <input asp-for="MaternityLeave" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">@Localizer.Get("PL")</label>
                <input asp-for="PaternityLeave" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">@Localizer.Get("Comp Off")</label>
                <input asp-for="CompOff" class="form-control" />
            </div>
        </div>

        <hr />

        <!-- ========== SECTION: Attendance ========== -->
        <h5 class="text-primary">@Localizer.Get("Attendance")</h5>
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Attendance Mode")</label>
                <select asp-for="AttendanceModeId" asp-items="ViewBag.AttendanceMode" class="form-select select2">
                    <option value="">@Localizer.Get("Select")</option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Default Status")</label>
                <select asp-for="DefaultAttendanceStatusId" asp-items="ViewBag.AttendanceStatus" class="form-select select2">
                    <option value="">@Localizer.Get("Select")</option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Grace Minutes")</label>
                <input asp-for="GraceMinutes" class="form-control" />
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Late Mark After")</label>
                <input asp-for="LateMarkAfterMinutes" class="form-control" />
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Half Day After")</label>
                <input asp-for="HalfDayAfterMinutes" class="form-control" />
            </div>
        </div>

        <hr />

        <!-- ========== SECTION: Biometric ========== -->
        <h5 class="text-primary">@Localizer.Get("Biometric")</h5>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">@Localizer.Get("Biometric Device")</label>
                <input asp-for="BiometricDeviceId" class="form-control" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">@Localizer.Get("Machine User ID")</label>
                <input asp-for="MachineUserId" class="form-control" />
            </div>

            <div class="col-12 col-md-4">
                <div class="form-check">
                    <input asp-for="AutoAttendance" class="form-check-input" />
                    <label class="form-check-label">@Localizer.Get("Auto Attendance")</label>
                </div>
            </div>
        </div>

        <hr />

        <!-- ========== SECTION: Overtime ========== -->
        <h5 class="text-primary">@Localizer.Get("Overtime")</h5>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <div class="form-check">
                    <input asp-for="OvertimeAllowed" class="form-check-input" />
                    <label class="form-check-label">@Localizer.Get("Overtime Allowed")</label>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">@Localizer.Get("Maximum OT Hours")</label>
                <input asp-for="MaxOTHours" class="form-control" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">@Localizer.Get("OT Rate")</label>
                <input asp-for="OTRate" class="form-control" />
            </div>
        </div>

    </div>
</div>