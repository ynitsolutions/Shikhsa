@model Shikhsa.Models.StaffMaster

<div class="card shadow-sm">

    <div class="card-header bg-light">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="mb-0">
                <i class="ti ti-school"></i>
                @Localizer.Get("Academic Details")
            </h5>
            <button type="button" class="btn btn-primary btn-sm" id="btnAddAcademic">
                <i class="ti ti-plus"></i>
                @Localizer.Get("Add Academic")
            </button>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" id="tblAcademic">
                <thead class="table-primary">
                    <tr>
                        <th style="width:50px;">#</th>
                        <th>@Localizer.Get("Degree")</th>
                        <th>@Localizer.Get("Stream")</th>
                        <th>@Localizer.Get("Institute")</th>
                        <th>@Localizer.Get("University")</th>
                        <th>@Localizer.Get("Year")</th>
                        <th>@Localizer.Get("Roll No")</th>
                        <th>@Localizer.Get("Total")</th>
                        <th>@Localizer.Get("Obtained")</th>
                        <th>%</th>
                        <th>@Localizer.Get("Grade")</th>
                        <th>@Localizer.Get("Marksheet")</th>
                        <th style="min-width:100px;">@Localizer.Get("Action")</th>
                        <!-- Hidden columns for data storage -->
                        <th style="display:none"></th>
                        <th style="display:none"></th>
                        <th style="display:none"></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Rows will be added dynamically -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal (fully responsive) -->
<div class="modal fade" id="AcademicModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@Localizer.Get("Academic Details")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <input type="hidden" id="AcademicIndex" />
                    <input type="hidden" id="AcademicId" />

                    <!-- Degree -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">
                            @Localizer.Get("Degree")
                            <span class="text-danger">*</span>
                        </label>
                        <select id="DegreeId" class="form-select select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.Degree)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                    </div>

                    <!-- Passing Year -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Passing Year")</label>
                        <select id="PassingYear" class="form-select select2">
                            @for (int i = DateTime.Now.Year + 2; i >= DateTime.Now.Year - 60; i--)
                            {
                                <option>@i</option>
                            }
                        </select>
                    </div>

                    <!-- Institute -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("Institute")</label>
                        <input type="text" id="InstituteName" class="form-control required" />
                    </div>

                    <!-- University -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label">@Localizer.Get("University")</label>
                        <input type="text" id="UniversityName" class="form-control required" />
                    </div>

                    <!-- Roll Number -->
                    <div class="col-12 col-md-3 col-lg-3">
                        <label class="form-label">@Localizer.Get("Roll Number")</label>
                        <input type="text" id="RollNumber" class="form-control required" />
                    </div>

                    <!-- Total Marks -->
                    <div class="col-12 col-md-3 col-lg-3">
                        <label class="form-label">@Localizer.Get("Total Marks")</label>
                        <input type="number" id="TotalMarks" class="form-control required" />
                    </div>

                    <!-- Obtained Marks -->
                    <div class="col-12 col-md-3 col-lg-3">
                        <label class="form-label">@Localizer.Get("Obtained Marks")</label>
                        <input type="number" id="ObtainedMarks" class="form-control required" />
                    </div>

                    <!-- Percentage -->
                    <div class="col-12 col-md-3 col-lg-3">
                        <label class="form-label">@Localizer.Get("Percentage")</label>
                        <input type="text" id="Percentage" readonly class="form-control" />
                    </div>

                    <!-- Grade -->
                    <div class="col-12 col-md-6 col-lg-6">
                        <label class="form-label">@Localizer.Get("Grade")</label>
                        <select id="GradeId" class="form-select select2">
                            <option value="">@Localizer.Get("Select")</option>
                            @foreach (var item in ViewBag.Grade)
                            {
                                <option value="@item.DataListItemId">@item.DataListItemText</option>
                            }
                        </select>
                    </div>

                    <!-- Marksheet -->
                    <div class="col-12 col-md-6 col-lg-6">
                        <label class="form-label">@Localizer.Get("Marksheet")</label>
                        <input type="file" id="MarksheetFile" class="form-control" />
                        <a id="MarksheetPreview" href="#" target="_blank" style="display:none" class="mt-1 d-inline-block">
                            @Localizer.Get("View Existing Marksheet")
                        </a>
                    </div>

                    <!-- Remarks -->
                    <div class="col-12">
                        <label class="form-label">@Localizer.Get("Remarks")</label>
                        <textarea id="Remarks" rows="2" class="form-control"></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="btnAcademicSave">
                    <i class="ti ti-device-floppy"></i> @Localizer.Get("Save")
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    @Localizer.Get("Close")
                </button>
            </div>
        </div>
    </div>
</div>