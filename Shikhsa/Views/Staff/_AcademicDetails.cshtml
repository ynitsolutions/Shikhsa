@model Shikhsa.Models.StaffMaster

<div class="card shadow-sm">

    <div class="card-header bg-light">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0">

                <i class="ti ti-school"></i>

                Academic Details

            </h5>

            <button type="button"
                    class="btn btn-primary"
                    id="btnAddAcademic">

                <i class="ti ti-plus"></i>

                Add Academic

            </button>

        </div>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle mb-0"
                   id="tblAcademic">

                <thead class="table-primary">

                    <tr>

                        <th width="60">#</th>
                        <th>Degree</th>
                       

                        <th>Stream</th>

                        <th>Institute</th>

                        <th>University</th>

                        <th>Year</th>

                        <th>Roll No</th>

                        <th>Total</th>

                        <th>Obtained</th>

                        <th>%</th>

                        <th>Grade</th>

                        <th>Marksheet</th>

                        <th>Action</th>
                        <th style="display:none"></th>
                        <th style="display:none"></th>
                        <th style="display:none"></th>
                    </tr>

                </thead>

                <tbody>

                    
                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- Modal -->

<div class="modal fade"
     id="AcademicModal">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5>

                    Academic Details

                </h5>

               @*  <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button> *@
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <div class="row g-3">

                    <input type="hidden"
                           id="AcademicIndex" />
                    <input type="hidden" id="AcademicId" />
                    <div class="col-lg-4">

                        <label>

                            Degree

                            <span class="text-danger">*</span>

                        </label>

                        <select id="DegreeId"class="form-select select2">

                            <option value="">Select</option>

                            @foreach (var item in ViewBag.Degree)
                            {
                                <option value="@item.DataListItemId">

                                    @item.DataListItemText

                                </option>
                            }

                        </select>

                    </div>

         @*            <div class="col-lg-4">

                        <label>

                            Stream

                        </label>

                        <select id="StreamId"
                                class="form-select select2">

                            <option value="">Select</option>

                            @foreach (var item in ViewBag.Stream)
                            {
                                <option value="@item.Value">

                                    @item.Text

                                </option>
                            }

                        </select>

                    </div> *@

                    <div class="col-lg-4">

                        <label>

                            Passing Year

                        </label>

                        <select id="PassingYear"
                                class="form-select select2">

                            @for (int i = DateTime.Now.Year + 2;
                                                        i >= DateTime.Now.Year - 60;
                                                        i--)
                            {
                                <option>

                                    @i

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-6">

                        <label>

                            Institute

                        </label>

                        <input type="text"
                               id="InstituteName"
                               class="form-control required" />

                    </div>

                    <div class="col-lg-6">

                        <label>

                            University

                        </label>

                        <input type="text"
                               id="UniversityName"
                               class="form-control required" />

                    </div>

                    <div class="col-lg-3">

                        <label>

                            Roll Number

                        </label>

                        <input type="text"
                               id="RollNumber"
                               class="form-control required" />

                    </div>

                    <div class="col-lg-3">

                        <label>

                            Total Marks

                        </label>

                        <input type="number"
                               id="TotalMarks"
                               class="form-control required" />

                    </div>

                    <div class="col-lg-3">

                        <label>

                            Obtained Marks

                        </label>

                        <input type="number"
                               id="ObtainedMarks"
                               class="form-control required" />

                    </div>

                    <div class="col-lg-3">

                        <label>

                            Percentage

                        </label>

                        <input type="text"
                               id="Percentage"
                               readonly
                               class="form-control required" />

                    </div>

                    <div class="col-lg-6">

                        <label>

                            Grade

                        </label>

                        <select id="GradeId"
                                class="form-select select2">

                            <option value="">Select</option>

                            @foreach (var item in ViewBag.Grade)
                            {
                                <option value="@item.DataListItemId">

                                    @item.DataListItemText

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-6">

                        <label>

                            Marksheet

                        </label>

                        <input type="file"
                               id="MarksheetFile"
                               class="form-control" />
                        <a id="MarksheetPreview"
                           href="#"
                           target="_blank"
                           style="display:none">
                            View Existing Marksheet
                        </a>

                    </div>

                    <div class="col-lg-12">

                        <label>

                            Remarks

                        </label>

<textarea id="Remarks"
          rows="2"
          class="form-control">

</textarea>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-success" id="btnAcademicSave">

                    <i class="ti ti-device-floppy"></i>

                    Save

                </button>

                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>