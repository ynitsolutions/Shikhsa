@model Shikhsa.ViewModels.StaffProfileViewModel
@{
    ViewData["Title"] = "Staff Profile";
    var s = Model.Staff;
    var ex = Model.ExtraInfo;
    var photoUrl = string.IsNullOrEmpty(s.PhotoPath) ? "/images/no-photo.png" : s.PhotoPath;
}

<div class="container-fluid">

    <!-- Profile Header (responsive flex) -->
    <div class="profile-header d-flex flex-wrap align-items-center justify-content-between border rounded p-3 mb-3 gap-3">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <img src="@photoUrl" alt="photo" class="rounded-circle"
                 style="width:90px;height:90px;object-fit:cover;" />
            <div>
                <h4 class="mb-0">@s.FullName</h4>
                <div class="text-muted small">
                    <span class="d-inline-block me-2">@Localizer.Get("Staff Code"): @s.StaffCode</span>
                    <span class="d-inline-block me-2">@ex.DesignationName (@ex.DepartmentName)</span>
                </div>
            </div>
        </div>
        <div>
            <a class="btn btn-primary btn-sm" href="@Url.Action("DownloadIdCard", "Staff", new { staffId = s.StaffId })">
                <i class="bi bi-download"></i> @Localizer.Get("Download ID Card")
            </a>
        </div>
    </div>

    <!-- Tabs (responsive: overflow auto on small screens) -->
    <ul class="nav nav-tabs flex-nowrap overflow-auto" id="profileTabs" role="tablist" style="gap:0; -webkit-overflow-scrolling:touch;">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#personal">@Localizer.Get("Personal")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#family">@Localizer.Get("Family")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#contact">@Localizer.Get("Contact / Address")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#employment">@Localizer.Get("Employment")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#academic">@Localizer.Get("Academic")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#experience">@Localizer.Get("Experience")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#emergency">@Localizer.Get("Emergency Contact")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#documents">@Localizer.Get("Documents")</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#salary">@Localizer.Get("Salary Summary")</button></li>
    </ul>

    <div class="tab-content border border-top-0 p-3">

        <!-- PERSONAL (responsive table) -->
        <div class="tab-pane fade show active" id="personal">
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <tbody>
                        <tr><th style="width:30%;">@Localizer.Get("DOB")</th><td>@s.DOB.ToString("dd-MMM-yyyy") (@Localizer.Get("Age"): @s.Age)</td></tr>
                        <tr><th>@Localizer.Get("Gender")</th><td>@ex.GenderName</td></tr>
                        <tr><th>@Localizer.Get("Blood Group")</th><td>@ex.BloodGroupName</td></tr>
                        <tr><th>@Localizer.Get("Marital Status")</th><td>@ex.MaritalStatusName</td></tr>
                        <tr><th>@Localizer.Get("Religion")</th><td>@ex.ReligionName</td></tr>
                        <tr><th>@Localizer.Get("Category")</th><td>@ex.CategoryName</td></tr>
                        <tr><th>@Localizer.Get("Nationality")</th><td>@s.Nationality</td></tr>
                        <tr><th>@Localizer.Get("Aadhaar No")</th><td>@s.AadhaarNumber</td></tr>
                        <tr><th>@Localizer.Get("PAN No")</th><td>@s.PANNumber</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FAMILY (responsive grid) -->
        <div class="tab-pane fade" id="family">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <h6>@Localizer.Get("Father")</h6>
                    <p class="mb-0">@s.FatherFirstName @s.FatherMiddleName @s.FatherLastName</p>
                </div>
                <div class="col-12 col-md-4">
                    <h6>@Localizer.Get("Mother")</h6>
                    <p class="mb-0">@s.MotherFirstName @s.MotherMiddleName @s.MotherLastName</p>
                </div>
                @if (!string.IsNullOrEmpty(s.SpouseName))
                {
                    <div class="col-12 col-md-4">
                        <h6>@Localizer.Get("Spouse")</h6>
                        <p class="mb-0">@s.SpouseName</p>
                        <p class="mb-0">@s.SpouseMobile</p>
                    </div>
                }
            </div>
        </div>

        <!-- CONTACT / ADDRESS -->
        <div class="tab-pane fade" id="contact">
            <div class="table-responsive">
                <table class="table table-sm table-striped datatable">
                    <tbody>
                        <tr><th style="width:30%;">@Localizer.Get("Mobile No")</th><td>@s.MobileNo</td></tr>
                        <tr><th>@Localizer.Get("Alternate Mobile")</th><td>@s.AlternateMobileNo</td></tr>
                        <tr><th>@Localizer.Get("Email")</th><td>@s.Email</td></tr>
                        <tr><th>@Localizer.Get("Alternate Email")</th><td>@s.AlternateEmail</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-12 col-md-6">
                    <h6>@Localizer.Get("Current Address")</h6>
                    <p class="mb-0">@s.Address</p>
                </div>
                <div class="col-12 col-md-6">
                    <h6>@Localizer.Get("Permanent Address")</h6>
                    <p class="mb-0">@(s.SameAsCurrentAddress == true ? s.Address : s.PermanentAddress)</p>
                </div>
            </div>
        </div>

        <!-- EMPLOYMENT -->
        <div class="tab-pane fade" id="employment">
            <div class="table-responsive">
                <table class="table table-sm table-striped datatable">
                    <tbody>
                        <tr><th style="width:30%;">@Localizer.Get("Department")</th><td>@ex.DepartmentName</td></tr>
                        <tr><th>@Localizer.Get("Designation")</th><td>@ex.DesignationName</td></tr>
                        <tr><th>@Localizer.Get("Staff Type")</th><td>@ex.StaffTypeName</td></tr>
                        <tr><th>@Localizer.Get("Employment Type")</th><td>@ex.EmploymentTypeName</td></tr>
                        <tr><th>@Localizer.Get("Employee Status")</th><td>@ex.EmployeeStatusName</td></tr>
                        <tr><th>@Localizer.Get("Reporting To")</th><td>@ex.ReportingStaffName</td></tr>
                        <tr><th>@Localizer.Get("Joining Date")</th><td>@s.JoiningDate.ToString("dd-MMM-yyyy")</td></tr>
                        <tr><th>@Localizer.Get("Confirmation Date")</th><td>@s.ConfirmationDate?.ToString("dd-MMM-yyyy")</td></tr>
                        @if (s.LeavingDate != null)
                        {
                            <tr><th>@Localizer.Get("Leaving Date")</th><td>@s.LeavingDate?.ToString("dd-MMM-yyyy")</td></tr>
                            <tr><th>@Localizer.Get("Leaving Reason")</th><td>@s.LeavingReason</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ACADEMIC -->
        <div class="tab-pane fade" id="academic">
            <div class="table-responsive">
                <table class="table table-sm table-striped datatable">
                    <thead>
                        <tr>
                            <th>@Localizer.Get("Degree")</th>
                            <th>@Localizer.Get("Stream")</th>
                            <th>@Localizer.Get("Institute")</th>
                            <th>@Localizer.Get("University")</th>
                            <th>@Localizer.Get("Passing Year")</th>
                            <th>%</th>
                            <th>@Localizer.Get("Grade")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Academics)
                        {
                            <tr>
                                <td>@a.DegreeName</td>
                                <td>@a.StreamName</td>
                                <td>@a.InstituteName</td>
                                <td>@a.UniversityName</td>
                                <td>@a.PassingYear</td>
                                <td>@a.Percentage%</td>
                                <td>@a.GradeName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- EXPERIENCE -->
        <div class="tab-pane fade" id="experience">
            <div class="table-responsive">
                <table class="table table-sm table-striped datatable">
                    <thead>
                        <tr>
                            <th>@Localizer.Get("Organisation")</th>
                            <th>@Localizer.Get("Designation")</th>
                            <th>@Localizer.Get("From")</th>
                            <th>@Localizer.Get("To")</th>
                            <th>@Localizer.Get("Duration")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Experiences)
                        {
                            <tr>
                                <td>@e.OrganisationName</td>
                                <td>@e.DesignationName</td>
                                <td>@e.FromDate.ToString("MMM-yyyy")</td>
                                <td>@e.ToDate.ToString("MMM-yyyy")</td>
                                <td>@e.TotalExperienceYears yr @e.TotalExperienceMonths mo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- EMERGENCY CONTACT -->
        <div class="tab-pane fade" id="emergency">
            <div class="table-responsive">
                <table class="table table-sm table-striped datatable">
                    <thead>
                        <tr>
                            <th>@Localizer.Get("Name")</th>
                            <th>@Localizer.Get("Mobile")</th>
                            <th>@Localizer.Get("Alternate")</th>
                            <th>@Localizer.Get("Address")</th>
                            <th>@Localizer.Get("Primary")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.EmergencyContacts)
                        {
                            <tr>
                                <td>@e.ContactName</td>
                                <td>@e.MobileNo</td>
                                <td>@e.AlternateMobileNo</td>
                                <td>@e.Address</td>
                                <td>@(e.IsPrimary ? @Localizer.Get("Yes") : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- DOCUMENTS -->
        <div class="tab-pane fade" id="documents">
            <div class="table-responsive">
                <table class="table table-sm table-striped datatable">
                    <thead>
                        <tr>
                            <th>@Localizer.Get("Document Type")</th>
                            <th>@Localizer.Get("Number")</th>
                            <th>@Localizer.Get("File")</th>
                            <th>@Localizer.Get("Expiry")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Documents)
                        {
                            <tr>
                                <td>@d.DocumentTypeName</td>
                                <td>@d.DocumentNumber</td>
                                <td><a href="@d.FilePath" target="_blank" class="btn btn-sm btn-outline-secondary">@Localizer.Get("View")</a></td>
                                <td>@d.ExpiryDate?.ToString("dd-MMM-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SALARY -->
        <div class="tab-pane fade" id="salary">
            @if (Model.CurrentSalary != null)
            {
                var cs = Model.CurrentSalary;
                <h6>@Localizer.Get("Current Salary Structure")</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-striped datatable">
                        <tbody>
                            <tr><th style="width:30%;">@Localizer.Get("Basic")</th><td>@cs.BasicSalary.ToString("N2")</td></tr>
                            <tr><th>@Localizer.Get("HRA")</th><td>@cs.HRA.ToString("N2")</td></tr>
                            <tr><th>@Localizer.Get("DA")</th><td>@cs.DA.ToString("N2")</td></tr>
                            <tr><th>@Localizer.Get("Gross Salary")</th><td>@cs.GrossSalary.ToString("N2")</td></tr>
                            <tr><th>@Localizer.Get("Total Deduction")</th><td>@cs.TotalDeduction.ToString("N2")</td></tr>
                            <tr class="fw-bold"><th>@Localizer.Get("Net Salary")</th><td>@cs.NetSalary.ToString("N2")</td></tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">@Localizer.Get("Current salary structure is not set.")</p>
            }

            <h6 class="mt-4">@Localizer.Get("Recent Salary History")</h6>
            <div class="table-responsive">
                <table class="table table-sm table-striped datatable">
                    <thead>
                        <tr>
                            <th>@Localizer.Get("Effective From")</th>
                            <th>@Localizer.Get("Gross")</th>
                            <th>@Localizer.Get("Deduction")</th>
                            <th>@Localizer.Get("Net")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sh in Model.SalaryHistory)
                        {
                            <tr>
                                <td>@sh.EffectiveFrom.ToString("dd-MMM-yyyy")</td>
                                <td>@sh.GrossSalary.ToString("N2")</td>
                                <td>@sh.TotalDeduction.ToString("N2")</td>
                                <td>@sh.NetSalary.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>