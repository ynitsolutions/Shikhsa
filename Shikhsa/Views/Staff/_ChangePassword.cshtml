@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="passwordModalLabel">
                    <i class="fa fa-key"></i> @Localizer.Get("Change Password")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- IsAdmin hidden field check karne ke liye -->
            <input type="hidden" id="CurrentLoggedInUserId" value="@UserManager.GetUserId(User)" />
            <input type="hidden" id="IsAdmin" value="@(User.IsInRole("Admin") ? "true" : "false")" />

            <!-- Modal ke andar upar hi yeh dono hidden fields rakh lijiye -->


            <div class="modal-body">
                <input type="hidden" id="PasswordUserId" /> <!-- Jis bande ka password badalna hai uski ID -->
                <!-- CONTROLLER SE YA JS SE IS DIV KO SHOW/HIDE KARENGE -->
                <div id="OldPasswordDiv" class="mb-3">
                    <label for="OldPassword" class="form-label">@Localizer.Get("Old Password")</label>
                    <input type="password" id="OldPassword" class="form-control" placeholder="@Localizer.Get("Enter old password")" />
                </div>

                <!-- New Password -->
                <div class="mb-3">
                    <label for="NewPassword" class="form-label">@Localizer.Get("New Password")</label>
                    <input type="password" id="NewPassword" class="form-control" placeholder="@Localizer.Get("Enter new password")" />
                </div>

                <!-- Confirm Password -->
                <div class="mb-3">
                    <label for="ConfirmPassword" class="form-label">@Localizer.Get("Confirm Password")</label>
                    <input type="password" id="ConfirmPassword" class="form-control" placeholder="@Localizer.Get("Confirm new password")" />
                </div>
            </div>


            <div class="modal-footer d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> @Localizer.Get("Close")
                </button>
                <button type="button" class="btn btn-success" id="btnPasswordSave">
                    <i class="fa fa-save"></i> @Localizer.Get("Save")
                </button>
            </div>
        </div>
    </div>
</div>
