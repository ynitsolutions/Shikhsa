@model Shikhsa.Models.StaffSalaryHistory

<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="ti ti-currency-rupee"></i>
            @Localizer.Get("Salary Details")
        </h5>
    </div>

    <div class="card-body">

        <div class="row g-3">

            <!-- Effective From -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Effective From") <span class="text-danger">*</span></label>
                <input asp-for="EffectiveFrom" type="date" class="form-control" />
            </div>

            <!-- Basic Salary -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Basic Salary")</label>
                <input asp-for="BasicSalary" id="BasicSalary" class="form-control salary" />
            </div>

            <!-- HRA -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("HRA")</label>
                <input asp-for="HRA" id="HRA" class="form-control salary" />
            </div>

            <!-- DA -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("DA")</label>
                <input asp-for="DA" id="DA" class="form-control salary" />
            </div>

            <!-- Medical -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Medical")</label>
                <input asp-for="MedicalAllowance" id="MedicalAllowance" class="form-control salary" />
            </div>

            <!-- Conveyance -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Conveyance")</label>
                <input asp-for="ConveyanceAllowance" id="ConveyanceAllowance" class="form-control salary" />
            </div>

            <!-- Special Allowance -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Special Allowance")</label>
                <input asp-for="SpecialAllowance" id="SpecialAllowance" class="form-control salary" />
            </div>

            <!-- Other Allowance -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Other Allowance")</label>
                <input asp-for="OtherAllowance" id="OtherAllowance" class="form-control salary" />
            </div>

            <!-- Gross Salary -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Gross Salary")</label>
                <input asp-for="GrossSalary" id="GrossSalary" readonly class="form-control bg-light fw-bold" />
            </div>

            <!-- PF -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("PF")</label>
                <input asp-for="PFDeduction" id="PFDeduction" class="form-control deduction" />
            </div>

            <!-- ESIC -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("ESIC")</label>
                <input asp-for="ESICDeduction" id="ESICDeduction" class="form-control deduction" />
            </div>

            <!-- PT -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("PT")</label>
                <input asp-for="PTDeduction" id="PTDeduction" class="form-control deduction" />
            </div>

            <!-- TDS -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("TDS")</label>
                <input asp-for="TDSDeduction" id="TDSDeduction" class="form-control deduction" />
            </div>

            <!-- Other Deduction -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Other Deduction")</label>
                <input asp-for="OtherDeduction" id="OtherDeduction" class="form-control deduction" />
            </div>

            <!-- Total Deduction -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Total Deduction")</label>
                <input asp-for="TotalDeduction" id="TotalDeduction" readonly class="form-control bg-light fw-bold" />
            </div>

            <!-- Net Salary -->
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label">@Localizer.Get("Net Salary")</label>
                <input asp-for="NetSalary" id="NetSalary" readonly class="form-control bg-warning fw-bold" />
            </div>

            <!-- Revision Reason -->
            <div class="col-12">
                <label class="form-label">@Localizer.Get("Revision Reason")</label>
                <textarea asp-for="RevisionReason" rows="2" class="form-control"></textarea>
            </div>

        </div>

    </div>

</div>