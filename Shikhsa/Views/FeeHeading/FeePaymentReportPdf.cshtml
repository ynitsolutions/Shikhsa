@model Shikhsa.ViewModels.FeePaymentReportVM
@{
    Layout = null;
    SchoolMaster mySchool = ViewBag.School as SchoolMaster;
    string? logoBase64 = ViewBag.LogoBase64 as string;
    string className = ViewBag.ClassName as string;
    string batchName = ViewBag.BatchName as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fee Payment Report</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Times New Roman', Times, serif;
                margin: 0;
                padding: 0;
                font-size: 10px;
                color: #111;
            }

            .report-box {
                border: 1.5px solid #000;
                padding: 10px 14px;
            }

            .school-header {
                text-align: center;
                padding-bottom: 4px;
            }

            .school-header-inner {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

            .school-logo {
                width: 34px;
                height: 34px;
                object-fit: contain;
                border-radius: 50%;
            }

            .school-name {
                font-size: 15px;
                font-weight: bold;
                margin: 0;
            }

            .school-address {
                font-size: 9px;
                margin: 2px 0 0;
            }

            .header-rule {
                border: none;
                border-top: 1.2px solid #000;
                margin: 5px 0;
            }

            .report-title {
                text-align: center;
                font-size: 15px;
                font-weight: bold;
                letter-spacing: 1px;
                margin: 4px 0 8px;
            }

            .filter-info {
                display: flex;
                justify-content: space-between;
                font-size: 9.5px;
                margin-bottom: 10px;
            }

            table.data-table {
                width: 100%;
                border-collapse: collapse;
            }

                table.data-table th, table.data-table td {
                    border: 1px solid #000;
                    padding: 4px 5px;
                    font-size: 9px;
                }

                table.data-table th {
                    background: #f0f0f0;
                    text-align: center;
                }

                    table.data-table td.num, table.data-table th.num {
                        text-align: right;
                    }

                table.data-table tfoot td {
                    font-weight: bold;
                    background: #f5f5f5;
                }

            .print-date {
                text-align: right;
                font-size: 8px;
                margin-top: 10px;
                color: #555;
            }

    </style>
</head>

<body>

    <div class="report-box">

        <div class="school-header">
            <div class="school-header-inner">
                @if (!string.IsNullOrWhiteSpace(logoBase64))
                {
                    <img src="@logoBase64" alt="Logo" class="school-logo" />
                }
                <p class="school-name">@mySchool?.SchoolName</p>
            </div>
            <p class="school-address">
                @mySchool?.SchoolAddress, @mySchool?.District, @mySchool?.State Pin- @mySchool?.PinCode.
            </p>
        </div>

        <hr class="header-rule" />

        <div class="report-title">FEE PAYMENT REPORT</div>

        <div class="filter-info">
            <span>
                <strong>Student:</strong> @(Model.SelectedStudent?.StudentName ?? "All Students")
                @if (Model.SelectedStudent != null)
                {
                    <text> | <strong>Father:</strong> @Model.SelectedStudent.FatherName</text>
                }
            </span>
            <span>
                <strong>Class:</strong> @className &nbsp;
                <strong>Batch:</strong> @batchName
            </span>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Receipt No</th>
                    <th>Date</th>
                    <th>Fee Type</th>
                    <th>Fee Head</th>
                    <th class="num">Total Fee</th>
                    <th class="num">Already Paid</th>
                    <th class="num">Paid Amount</th>
                    <th class="num">Late Fee</th>
                    <th class="num">Concession</th>
                    <th class="num">Remaining Due</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.ReceiptNumber</td>
                        <td>@r.ReceiptDate.ToString("dd-MMM-yyyy")</td>
                        <td>@r.FeeType</td>
                        <td>@r.FeeHeadName</td>
                        <td class="num">@r.TotalFee.ToString("N2")</td>
                        <td class="num">@r.AlreadyPaid.ToString("N2")</td>
                        <td class="num">@r.PaidAmount.ToString("N2")</td>
                        <td class="num">@r.LateFee.ToString("N2")</td>
                        <td class="num">@r.Concession.ToString("N2")</td>
                        <td class="num">@r.RemainingDue.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4">Total</td>
                    <td class="num">@Model.Rows.Sum(x => x.TotalFee).ToString("N2")</td>
                    <td class="num">@Model.Rows.Sum(x => x.AlreadyPaid).ToString("N2")</td>
                    <td class="num">@Model.Rows.Sum(x => x.PaidAmount).ToString("N2")</td>
                    <td class="num">@Model.Rows.Sum(x => x.LateFee).ToString("N2")</td>
                    <td class="num">@Model.Rows.Sum(x => x.Concession).ToString("N2")</td>
                    <td class="num">@Model.Rows.Sum(x => x.RemainingDue).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <div class="print-date">Generated on: @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")</div>

    </div>

</body>
</html>