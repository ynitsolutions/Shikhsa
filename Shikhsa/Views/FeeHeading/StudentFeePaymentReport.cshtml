@model Shikhsa.ViewModels.FeePaymentReportVM

@{
    ViewData["Title"] = "Fee Payment Report";
}

<style>
    /* ── Custom responsive tweaks ── */
    .report-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        padding: 1.25rem;
    }

    .report-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 1rem;
    }

    .filter-form .form-label {
        font-weight: 500;
        font-size: 0.8rem;
        margin-bottom: 0.25rem;
        color: #344054;
    }

    .filter-form .form-control,
    .filter-form .form-select {
        font-size: 0.9rem;
        height: 38px;
        border-radius: 6px;
    }

    .filter-actions .btn {
        font-size: 0.85rem;
        padding: 0.3rem 0.9rem;
        min-width: 100px;
    }

    /* Table responsiveness */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive table {
            min-width: 900px;
            width: 100%;
            font-size: 0.85rem;
        }

        .table-responsive th,
        .table-responsive td {
            padding: 0.5rem 0.4rem;
            vertical-align: middle;
            white-space: nowrap;
        }

        .table-responsive .text-end {
            text-align: right;
        }

        .table-responsive tfoot td {
            font-weight: 600;
            background: #f8f9fa;
        }

    /* ── Responsive ── */
    @@media (max-width: 575.98px) {
        .report-card {
            padding: 0.75rem;
        }

        .filter-form .row > [class*="col-"] {
            margin-bottom: 0.5rem;
        }

            .filter-form .row > [class*="col-"]:last-child {
                margin-bottom: 0;
            }

        .filter-actions {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

            .filter-actions .btn {
                width: 100%;
                justify-content: center;
            }

        .table-responsive table {
            font-size: 0.75rem;
            min-width: 700px;
        }

        .table-responsive th,
        .table-responsive td {
            padding: 0.3rem 0.3rem;
        }

        .report-title {
            font-size: 1rem;
            text-align: center;
        }

        .no-data {
            font-size: 0.9rem;
            padding: 2rem 0;
        }
    }

    @@media (min-width: 576px) and (max-width: 767.98px) {
        .filter-form .row > .col-md-3 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .filter-actions .btn {
            font-size: 0.8rem;
            padding: 0.25rem 0.7rem;
        }
    }

    @@media (max-width: 991.98px) {
        .table-responsive table {
            min-width: 800px;
        }
    }
</style>

<div class="container-fluid mt-2 mt-sm-3">

    <div class="report-card">

        <h5 class="report-title">📊 @Localizer.Get("Fee Payment Report")</h5>

        <form method="get" id="reportFilterForm" class="filter-form row g-2 g-sm-3 mb-3">

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">@Localizer.Get("Batch"):</label>
                <select name="batchId" id="batchId" class="form-select select2">
                    <option value="">@Localizer.Get("Select Batch")</option>
                    @foreach (var b in Model.Batches)
                    {
                        <option value="@b.BatchId" selected="@(Model.SelectedBatchId == b.BatchId)">@b.AcademicYear</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">@Localizer.Get("Class"):</label>
                <select name="classId" id="classId" class="form-select select2">
                    <option value="">@Localizer.Get("Select Class")</option>
                    @foreach (var c in Model.Classes)
                    {
                        <option value="@c.DataListItemId" selected="@(Model.SelectedClassId == c.DataListItemId)">@c.DataListItemText</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">@Localizer.Get("Section"):</label>
                <select name="sectionId" id="sectionId" class="form-select select2">
                    <option value="">@Localizer.Get("Select Section")</option>
                    @foreach (var s in Model.Sections)
                    {
                        <option value="@s.DataListItemId" selected="@(Model.SelectedSectionId == s.DataListItemId)">@s.DataListItemText</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">@Localizer.Get("Student"):</label>
                <select name="studentId" id="studentId" class="form-select select2">
                    <option value="">@Localizer.Get("All Students")</option>
                    @foreach (var st in Model.Students)
                    {
                        <option value="@st.StudentId" selected="@(Model.SelectedStudentId == st.StudentId)">@st.StudentName</option>
                    }
                </select>
            </div>

            <div class="col-12 mt-2 filter-actions d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-search"></i> @Localizer.Get("Apply Filter")
                </button>

                <a href="@Url.Action("ExportFeePaymentReportPdf")?batchId=@Model.SelectedBatchId&classId=@Model.SelectedClassId&sectionId=@Model.SelectedSectionId&studentId=@Model.SelectedStudentId"
                   class="btn btn-outline-danger btn-sm" target="_blank">
                    <i class="fa fa-file-pdf-o"></i> Export PDF
                </a>

                <a href="@Url.Action("ExportFeePaymentReportExcel")?batchId=@Model.SelectedBatchId&classId=@Model.SelectedClassId&sectionId=@Model.SelectedSectionId&studentId=@Model.SelectedStudentId"
                   class="btn btn-outline-success btn-sm">
                    <i class="fa fa-file-excel-o"></i> @Localizer.Get("Export Excel")
                </a>
            </div>

        </form>

        @if (Model.Rows.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm">
                    <thead class="table-primary">
                        <tr>
                            <th>@Localizer.Get("Receipt No")</th>
                            <th>@Localizer.Get("Date")</th>
                            <th>@Localizer.Get("Fee Type")</th>
                            <th>@Localizer.Get("Fee Head")</th>
                            <th class="text-end">@Localizer.Get("Total Fee")</th>
                            <th class="text-end">@Localizer.Get("Already Paid")</th>
                            <th class="text-end">@Localizer.Get("Paid Amount")</th>
                            <th class="text-end">@Localizer.Get("Late Fee")</th>
                            <th class="text-end">@Localizer.Get("Concession")</th>
                            <th class="text-end">@Localizer.Get("Remaining Due")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>@r.ReceiptNumber</td>
                                <td>@r.ReceiptDate.ToString("dd-MMM-yyyy")</td>
                                <td>@r.FeeType</td>
                                <td>@r.FeeHeadName</td>
                                <td class="text-end">@r.TotalFee.ToString("N2")</td>
                                <td class="text-end">@r.AlreadyPaid.ToString("N2")</td>
                                <td class="text-end">@r.PaidAmount.ToString("N2")</td>
                                <td class="text-end">@r.LateFee.ToString("N2")</td>
                                <td class="text-end">@r.Concession.ToString("N2")</td>
                                <td class="text-end">@r.RemainingDue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">Total</td>
                            <td class="text-end">@Model.Rows.Sum(x => x.TotalFee).ToString("N2")</td>
                            <td class="text-end">@Model.Rows.Sum(x => x.AlreadyPaid).ToString("N2")</td>
                            <td class="text-end">@Model.Rows.Sum(x => x.PaidAmount).ToString("N2")</td>
                            <td class="text-end">@Model.Rows.Sum(x => x.LateFee).ToString("N2")</td>
                            <td class="text-end">@Model.Rows.Sum(x => x.Concession).ToString("N2")</td>
                            <td class="text-end">@Model.Rows.Sum(x => x.RemainingDue).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted p-4 no-data">
                <i class="fa fa-info-circle fa-2x mb-2 d-block"></i>
                @Localizer.Get("Please Filter the record then see report.")
            </div>
        }

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}