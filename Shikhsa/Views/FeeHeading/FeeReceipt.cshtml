@model Shikhsa.ViewModels.StudentFeePageVM

@{
    ViewData["Title"] = "Student Fees";
}

<style>
    .fee-card {
        background: #fff;
        border-radius: 5px;
        padding: 8px;
        box-shadow: 0 1px 8px rgba(0, 0, 0, .08);
    }

    .fee-header {
        text-align: center;
    }

    .fee-header h5 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
    }

    .fee-header small {
        font-size: 9px;
        color: #555;
    }

    .fee-divider {
        border-top: 1px solid #174a8b;
        margin: 6px 0 10px;
    }

    .form-label {
        font-size: 9px;
        margin-bottom: 3px;
    }

    .form-control,
    .form-select {
        height: 30px;
        font-size: 10px;
        border-radius: 3px;
    }

    .student-wrapper {
        position: relative;
    }

    .student-select {
        height: 30px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        display: flex;
        align-items: center;
        padding: 0 8px;
        font-size: 10px;
        cursor: pointer;
        background: #fff;
    }

    .student-select span:first-child {
        flex: 1;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .student-dropdown {
        position: absolute;
        top: 32px;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #ddd;
        box-shadow: 0 4px 12px rgba(0,0,0,.18);
        z-index: 9999;
        display: none;
    }

    .student-search {
        padding: 7px;
        border-bottom: 1px solid #ddd;
    }

    .student-search input {
        width: 100%;
        height: 28px;
        font-size: 9px;
        border: 1px solid #ccc;
        border-radius: 3px;
        padding: 4px 7px;
    }

    .student-list {
        max-height: 170px;
        overflow-y: auto;
    }

    .student-item {
        padding: 7px 8px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }

    .student-item:hover {
        background: #eef6ff;
    }

    .student-name {
        font-size: 10px;
        font-weight: 600;
    }

    .student-info {
        font-size: 8px;
        color: #777;
        margin-top: 2px;
    }

    .student-contact {
        font-size: 8px;
        color: #777;
    }

    .student-balance {
        font-size: 8px;
        color: #dc3545;
        margin-top: 2px;
    }

    .student-count {
        text-align: center;
        font-size: 8px;
        color: #777;
        padding: 5px;
        border-top: 1px solid #eee;
    }

    .selected-field {
        background: #eef8ff;
    }

    .balance-field {
        background: #fff3f3;
        color: #dc3545;
        font-weight: 600;
    }

    .generate-area {
        text-align: center;
        margin-top: 15px;
    }

    .generate-btn {
        background: #337fc9;
        color: #fff;
        border: none;
        border-radius: 3px;
        padding: 7px 18px;
        font-size: 10px;
    }

    .generate-btn:hover {
        background: #286aa9;
        color: #fff;
    }
</style>


<div class="container-fluid">

    <div class="fee-card">

        <!-- HEADER -->

        <div class="fee-header">

            <h5>Student Fees</h5>

            <small>
                Generate Student Fee Receipt
            </small>

        </div>

        <div class="fee-divider"></div>


        <!-- FORM -->

        <form asp-controller="FeeHeading"
              asp-action="FeeReceipt"
              method="get"
              id="feeSearchForm">
            @Html.AntiForgeryToken()
            <div class="row g-2">

                <!-- CLASS -->

                <div class="col-md-4">

                    <label class="form-label">
                        Class:
                    </label>

                    <select asp-for="SelectedClassId"
                            id="ClassId"
                            class="form-select">

                        <option value="">
                            Select Class
                        </option>

                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.DataListItemId"
                                    selected="@(Model.SelectedClassId == item.DataListItemId)">

                                @item.DataListItemText

                            </option>
                        }

                    </select>

                </div>


                <!-- STUDENT -->

                <div class="col-md-4">

                    <label class="form-label">
                        Select Student:
                    </label>

                    <div class="student-wrapper">

                        <div class="student-select"
                             id="studentSelect">

                            <span id="selectedStudentText">

                                @if (Model.SelectedStudent != null)
                                {
                                    @Model.SelectedStudent.StudentName
                                }
                                else
                                {
                                    @:Select Student
                                }

                            </span>

                            <span>▼</span>

                        </div>


                        <div class="student-dropdown"
                             id="studentDropdown">

                            <!-- SEARCH -->

                            <div class="student-search">

                                <input type="text"
                                       id="studentSearch"
                                       placeholder="🔎 Search by name, roll no, father's name..." />

                            </div>


                            <!-- STUDENTS -->

                            <div class="student-list"
                                 id="studentList">

                                @if (Model.Students != null && Model.Students.Any())
                                {
                                    foreach (var student in Model.Students)
                                    {
                                        <div class="student-item"
                                             data-id="@student.StudentId"
                                             data-name="@student.StudentName"
                                             data-father="@student.FatherName"
                                             data-contact="@student.ContactNo"
                                             data-roll="@student.RollNo"
                                             data-balance="@student.DueBalance">

                                            <div class="student-name">
                                                @student.StudentName
                                            </div>

                                            <div class="student-info">

                                                Roll No:
                                                @student.RollNo

                                                &nbsp; |

                                                Father:
                                                @student.FatherName

                                                &nbsp; |

                                                Class:
                                                @student.ClassName

                                                @if (!string.IsNullOrWhiteSpace(student.SectionName))
                                                {
                                                    <text>-@student.SectionName</text>
                                                }

                                    </div>

                                    <div class="student-contact">

                                        Contact:
                                        @(string.IsNullOrWhiteSpace(student.ContactNo)
                                                                                ? "Not available"
                                                                                : student.ContactNo)

                                    </div>

                                            <div class="student-balance">

                                                Due Balance:
                                                ₹@student.DueBalance.ToString("N2")

                                            </div>

                                        </div>
                                                                }
                                }
                                else
                                {
                                    <div class="p-3 text-center"
                                         style="font-size:10px;color:#777;">

                                        No students found.

                                    </div>
                                }

                            </div>


                            <div class="student-count">

                                Showing
                                <span id="studentCount">
                                    @(Model.Students?.Count ?? 0)
                                </span>
                                students

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FATHER NAME -->

                <div class="col-md-4">

                    <label class="form-label">
                        Father's Name:
                    </label>

                    <input type="text"
                           id="FatherName"
                           class="form-control"
                           readonly
                           value="@Model.SelectedStudent?.FatherName" />

                </div>


                <!-- BATCH -->

                <div class="col-md-4">

                    <label class="form-label">
                        Batch:
                    </label>

                    <select asp-for="SelectedBatchId"
                            id="BatchId"
                            class="form-select">

                        <option value="">
                            Select Batch
                        </option>

                        @foreach (var item in Model.Batches)
                        {
                            <option value="@item.BatchId"
                                    selected="@(Model.SelectedBatchId == item.BatchId)">

                                @item.AcademicYear

                            </option>
                        }

                    </select>

                </div>


                <!-- STUDENT NAME -->

                <div class="col-md-4">

                    <label class="form-label">
                        Student Name:
                    </label>

                    <input type="text"
                           id="StudentName"
                           class="form-control selected-field"
                           readonly
                           value="@Model.SelectedStudent?.StudentName" />

                </div>


                <!-- CONTACT -->

                <div class="col-md-4">

                    <label class="form-label">
                        Contact No:
                    </label>

                    <input type="text"
                           id="ContactNo"
                           class="form-control"
                           readonly
                           value="@Model.SelectedStudent?.ContactNo" />

                </div>


                <!-- DUE FEE BATCH -->

                <div class="col-md-4">

                    <label class="form-label">
                        Due Fee Batch:
                    </label>

                    <input type="number"
                           id="DueFeeBatch"
                           class="form-control"
                           value="@Model.DueFeeBatch" />

                </div>


                <!-- ROLL NO -->

                <div class="col-md-4">

                    <label class="form-label">
                        Roll No:
                    </label>

                    <input type="text"
                           id="RollNo"
                           class="form-control"
                           readonly
                           value="@Model.SelectedStudent?.RollNo" />

                </div>


                <!-- DUE BALANCE -->

                <div class="col-md-4">

                    <label class="form-label">
                        Due Balance:
                    </label>

                    <input type="text"
                           id="DueBalance"
                           class="form-control balance-field"
                           readonly
                           value="@(Model.SelectedStudent == null
                                                          ? "₹0"
                                                          : "₹" + Model.SelectedStudent.DueBalance.ToString("N2"))" />

                </div>

            </div>


            <!-- BUTTON -->

            <div class="generate-area">

                <button type="button"
                        class="generate-btn"
                        id="checkGenerate">

                    ✔ Check & Generate

                </button>

            </div>
            @if (Model.FeeReceipt != null)
            {
                <div class="card mt-3">

                    <div class="card-header p-0">

                        <ul class="nav nav-tabs" role="tablist">

                            <li class="nav-item">
                                <button class="nav-link active"
                                        data-bs-toggle="tab"
                                        data-bs-target="#tuitionTab"
                                        type="button">

                                    Tuition Fee
                                    (@Model.FeeReceipt.TuitionFees.Count)
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link"
                                        data-bs-toggle="tab"
                                        data-bs-target="#transportTab"
                                        type="button">

                                    Transport Fee
                                    (@Model.FeeReceipt.TransportFees.Count)
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link"
                                        data-bs-toggle="tab"
                                        data-bs-target="#hostelTab"
                                        type="button">

                                    Hostel Fee
                                    (@Model.FeeReceipt.HostelFees.Count)
                                </button>
                            </li>

                        </ul>

                    </div>


                    <div class="card-body p-0">

                        <div class="tab-content">

                            <!-- ===================================== -->
                            <!-- TUITION FEE -->
                            <!-- ===================================== -->


<div class="tab-pane fade show active"
     id="tuitionTab">

    <div class="d-flex justify-content-between
                align-items-center p-2">

        <strong>
            Tuition Fee Details
        </strong> 

        @if (Model.FeeReceipt.TuitionFees.Any())
        {
            <label class="small">
                <input type="checkbox"
                       id="selectAllTuition" />

                Select All
            </label>
        }

    </div>


    @if (!Model.FeeReceipt.TuitionFees.Any())
    {
        <div class="p-3 text-muted">
            No unpaid tuition fee.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-sm mb-0">

                <thead>
                    <tr>
                        <th width="40">#</th>

                        <th>
                            Fee Description
                        </th>

                        <th width="120">
                            Amount (₹)
                        </th>

                        <th width="120">
                            Paid (₹)
                        </th>

                        <th width="120">
                            Balance (₹)
                        </th>

                        <th width="80">
                            Select
                        </th>

                        <th width="130">
                            Collect Amount
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @for (int i = 0;
                          i < Model.FeeReceipt.TuitionFees.Count;
                          i++)
                    {
                        var fee =
                            Model.FeeReceipt.TuitionFees[i];

                        <tr>

                            <td>
                                @(i + 1)
                            </td>

                            <td>
                                @fee.FeeDescription
                            </td>

                            <td>
                                @fee.Amount.ToString("N2")
                            </td>

                            <td>
                                @fee.PaidAmount.ToString("N2")
                            </td>

                            <td>
                                @fee.Balance.ToString("N2")
                            </td>

                            <td class="text-center">

                                <input type="checkbox"
                                       class="fee-select tuition-select"
                                       name="FeeReceipt.TuitionFees[@i].IsSelected"
                                       value="true"
                                       data-index="@i" />

                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].FeeId" value="@fee.FeeId" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].FeePlanId" value="@fee.FeePlanId" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].FeeType" value="@fee.FeeType" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].FeeDescription" value="@fee.FeeDescription" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].Month" value="@fee.Month" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].Year" value="@fee.Year" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].Amount" value="@fee.Amount" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].PaidAmount" value="@fee.PaidAmount" />
                                <input type="hidden" name="FeeReceipt.TuitionFees[@i].Balance" value="@fee.Balance" />

                            </td>

                            <td>

                                <input type="text"
                                       class="form-control form-control-sm collect-amount decimal"
                                       name="FeeReceipt.TuitionFees[@i].CollectAmount"
                                       value="0"
                                       min="0"
                                       max="@fee.Balance"
                                                                   data-amount="@fee.Amount"
                                       data-index="@i" />

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>


                            <!-- ===================================== -->
                            <!-- TRANSPORT -->
                            <!-- ===================================== -->


<div class="tab-pane fade"
     id="transportTab">

    <div class="d-flex justify-content-between
