    }

</div>

                        </div>

                    </div>

                </div>
            }
            @if (Model.FeeReceipt != null)
            {
                <div class="card mt-2">

                    <div class="card-body">

                        <div class="row g-3">

                            <!-- LEFT SIDE -->
                            <div class="col-md-4">

                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Total Amount:
                                    </label>

                                    <div class="col-6">
                                        <input type="text"
                                               id="totalAmount"
                                               class="form-control form-control-sm text-end "
                                               value="₹ @Model.FeeReceipt.TotalAmount.ToString("N2")"
                                               name="FeeReceipt.TotalAmount"
                                               readonly />
                                        <input type="hidden" id="totalDueAmount" value="@Model.FeeReceipt.TotalAmount" />
                                    </div>
                                </div>


                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Total Fees:
                                    </label>

                                    <div class="col-6">
                                        <input type="text"
                                               id="totalFees"
                                               class="form-control form-control-sm text-end"
                                               value="₹ @Model.FeeReceipt.TotalFees.ToString("N2")"
                                               name="FeeReceipt.TotalFees"
                                               readonly />
                                    </div>
                                </div>


                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Receipt Amount:
                                    </label>

                                    <div class="col-6">
                                        <input type="text"
                                               asp-for="FeeReceipt.ReceiptAmount"
                                               id="receiptAmount"
                                               class="form-control form-control-sm text-end decimal"
                                               name="FeeReceipt.ReceiptAmount"
                                               min="0"/>
                                    </div>
                                </div>


                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Balance Amount:
                                    </label>

                                    <div class="col-6">
                                        <input type="text" asp-for="FeeReceipt.BalanceAmount"
                                               id="balanceAmount"
                                               class="form-control form-control-sm text-end"
                                               value="₹ @Model.FeeReceipt.BalanceAmount.ToString("N2")"
                                               name="FeeReceipt.BalanceAmount"
                                               readonly />
                                    </div>
                                </div>

                            </div>


                            <!-- MIDDLE -->
                            <div class="col-md-4">

                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Late Fee:
                                    </label>

                                    <div class="col-6">
                                        <input type="text"
                                               asp-for="FeeReceipt.LateFee"
                                               id="lateFee"
                                               class="form-control form-control-sm text-end decimal"
                                               name="FeeReceipt.LateFee"
                                               min="0"/>
                                    </div>
                                </div>


                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Concession:
                                    </label>

                                    <div class="col-6">
                                        <input type="text"
                                               asp-for="FeeReceipt.Concession"
                                               id="concession"
                                               class="form-control form-control-sm text-end"
                                               name="FeeReceipt.Concession"                           />
                                    </div>
                                </div>


                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Concession Amount:
                                    </label>

                                    <div class="col-6">
                                        <input type="text"
                                               asp-for="FeeReceipt.ConcessionAmount"
                                               id="concessionAmount"
                                               class="form-control form-control-sm text-end decimal"
                                               name="FeeReceipt.ConcessionAmount"
                                               min="0" />
                                    </div>
                                </div>


                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Net Fee:
                                    </label>

                                    <div class="col-6">
                                        <input type="text"
                                               id="netFee"
                                               class="form-control form-control-sm text-end decimal"
                                               value="₹ @Model.FeeReceipt.NetFee.ToString("N2")"
                                               name="FeeReceipt.NetFee"
                                               readonly />
                                    </div>
                                </div>

                            </div>


                            <!-- RIGHT SIDE -->
                            <div class="col-md-4">

                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Payment Mode:
                                    </label>

                                    <div class="col-6">

                                        <select asp-for="FeeReceipt.PaymentModeId" name="FeeReceipt.PaymentModeId"
                                                class="form-select form-select-sm">

                                            <option value="">
                                                Select Payment Mode
                                            </option>

                                            @foreach (var item in Model.PaymentMode)
                                                {
                                                    <option value="@item.DataListItemId">

                                                        @item.DataListItemText

                                                    </option>
                                                }

                                        </select>

                                    </div>
                                </div>


                                <div class="row mb-2 align-items-center">
                                    <label class="col-6 col-form-label col-form-label-sm">
                                        Remark:
                                    </label>

                                    <div class="col-6">
                                        <input asp-for="FeeReceipt.Remark"
                                               class="form-control form-control-sm"
                                               placeholder="Remark" name="FeeReceipt.Remark" />
                                    </div>
                                </div>

                            </div>

                        </div>


                        <hr class="my-2" />


                        <!-- DATE + SAVE -->
                        <div class="row align-items-center">

                            <div class="col-md-6">

                                <div class="d-flex align-items-center gap-2">

                                    <label class="small mb-0">
                                        Date &amp; Time:
                                    </label>

                                    <input asp-for="FeeReceipt.ReceiptDate"
                                           type="datetime-local"
                                           class="form-control form-control-sm"
                                           style="width:170px;" />

                                </div>

                            </div>


                            <div class="col-md-6 text-end">

                                <button type="submit" class="btn btn-success btn-sm px-4" id="saveReceiptBtn">

                                    💾 Save Receipt

                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }
        </form>

    </div>

</div>

@section Scripts
{
    <script>

        // =========================================================
        // SELECT2 INIT + CLASS/BATCH CHANGE (jQuery se bind, Select2 compatible)
        // =========================================================

        $(document).ready(function() {

            $('#ClassId').select2({ width: '100%' });
            $('#BatchId').select2({ width: '100%' });

            // Native addEventListener ke bajaye jQuery se bind kiya
            // taaki Select2 ke jQuery-triggered change event ke saath reliably kaam kare
            $('#ClassId, #BatchId').on('change', function() {
                loadStudents();
            });

        });


        const studentSelect = document.getElementById("studentSelect");
        const studentDropdown = document.getElementById("studentDropdown");
        const studentSearch = document.getElementById("studentSearch");
        const selectedStudentText = document.getElementById("selectedStudentText");


        // =========================================================
        // OPEN STUDENT DROPDOWN
        // =========================================================

        studentSelect.addEventListener("click", function() {

            studentDropdown.style.display =
                studentDropdown.style.display === "block" ? "none" : "block";

            if (studentDropdown.style.display === "block") {
                studentSearch.focus();
            }

        });


        // =========================================================
        // SEARCH STUDENT
        // =========================================================

        studentSearch.addEventListener("input", function() {

            const search = this.value.toLowerCase().trim();
            const items = document.querySelectorAll(".student-item");
            let count = 0;

            items.forEach(function(item) {

                const text = (
                    item.dataset.name + " " +
                    item.dataset.father + " " +
                    item.dataset.roll
                ).toLowerCase();

                if (text.includes(search)) {
                    item.style.display = "block";
                    count++;
                } else {
                    item.style.display = "none";
                }

            });

            document.getElementById("studentCount").textContent = count;

        });


        // =========================================================
        // SELECT STUDENT
        // =========================================================

        function bindStudentEvents() {

            document.querySelectorAll(".student-item").forEach(function(item) {

                item.addEventListener("click", function() {

                    const studentId = this.dataset.id;
                    const studentName = this.dataset.name;
                    const fatherName = this.dataset.father;
                    const contact = this.dataset.contact;
                    const roll = this.dataset.roll;
                    const balance = parseFloat(this.dataset.balance || 0);

                    selectedStudentText.textContent = studentName;

                    document.getElementById("StudentName").value = studentName;
                    document.getElementById("FatherName").value = fatherName;
                    document.getElementById("ContactNo").value = contact || "Not available";
                    document.getElementById("RollNo").value = roll || "Not assigned";
                    document.getElementById("DueBalance").value = formatCurrency(balance);
                    document.getElementById("DueFeeBatch").value = balance;

                    document.getElementById("SelectedStudentId").value = studentId;

                    studentDropdown.style.display = "none";

                });

            });

        }

        bindStudentEvents();


        // =========================================================
        // HIDDEN STUDENT ID
        // =========================================================

        const hiddenStudent = document.createElement("input");
        hiddenStudent.type = "hidden";
        hiddenStudent.id = "SelectedStudentId";
        hiddenStudent.name = "SelectedStudentId";
        hiddenStudent.value = "@Model.SelectedStudentId";

        document.getElementById("feeSearchForm").appendChild(hiddenStudent);


        // =========================================================
        // CLASS / BATCH CHANGE HANDLER
        // =========================================================

        function loadStudents() {

            const classId = document.getElementById("ClassId").value;
            const batchId = document.getElementById("BatchId").value;

            if (!classId || !batchId) return;

            const url =
                '@Url.Action("FeeReceipt", "FeeHeading")' +
                '?classId=' + encodeURIComponent(classId) +
                '&batchId=' + encodeURIComponent(batchId);

            window.location.href = url;

        }


        // =========================================================
        // CHECK & GENERATE
        // =========================================================

        document.getElementById("checkGenerate").addEventListener("click", function() {

            const classId = document.getElementById("ClassId").value;
            const batchId = document.getElementById("BatchId").value;
            const studentId = document.getElementById("SelectedStudentId").value;

            if (!classId) {
                alert("Please select Class.");
                return;
            }

            if (!batchId) {
                alert("Please select Batch.");
                return;
            }

            if (!studentId) {
                alert("Please select Student.");
                return;
            }

            window.location.href =
                '@Url.Action("FeeReceipt", "FeeHeading")' +
                '?classId=' + encodeURIComponent(classId) +
                '&batchId=' + encodeURIComponent(batchId) +
                '&studentId=' + encodeURIComponent(studentId);

        });


        // =========================================================
        // CURRENCY FORMAT
        // =========================================================

        function formatCurrency(value) {

            let num = Number(value || 0);

            // Point ke baad ke sirf 2 digit rakhne ke liye (Bina round off kiye)
            num = Math.trunc(num * 100) / 100;

            return "₹" + num.toLocaleString("en-IN", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });

        }


        // =========================================================
        // CLOSE DROPDOWN (OUTSIDE CLICK)
        // =========================================================

        document.addEventListener("click", function(event) {

            if (!event.target.closest(".student-wrapper")) {
                studentDropdown.style.display = "none";
            }

        });


        // =========================================================
        // GET INPUT BY NAME
        // =========================================================

        function getInput(name) {
            return document.querySelector(`[name="${name}"]`);
        }


        // =========================================================
        // CALCULATE RECEIPT (backend logic se match)
        // =========================================================

        function calculateReceipt() {

            let totalFeesSum = 0;   // Selected fees ka ACTUAL amount sum
            let collectSum = 0;     // Selected fees me ENTER kiya gaya amount sum

            document.querySelectorAll(".fee-select").forEach(function(checkbox) {

                if (!checkbox.checked) return;

                const index = checkbox.dataset.index;

                const actualAmount = parseFloat(checkbox.dataset.amount) || 0;
                totalFeesSum += actualAmount;

                const collectInput =
                    document.querySelector(`.collect-amount[data-index="${index}"]`);

                if (collectInput) {
                    collectSum += parseFloat(collectInput.value) || 0;
                }

            });

            totalFeesSum = Math.round(totalFeesSum * 100) / 100;
            collectSum = Math.round(collectSum * 100) / 100;


            const lateFeeInput = getInput("FeeReceipt.LateFee");
            const lateFee = lateFeeInput ? (parseFloat(lateFeeInput.value) || 0) : 0;

            const concessionInput = getInput("FeeReceipt.ConcessionAmount");
            const concession = concessionInput ? (parseFloat(concessionInput.value) || 0) : 0;


            // ============================================
            // RECEIPT AMOUNT — jo CASH actually collect hoga
            // (Late Fee ADD, Concession MINUS)
            // ============================================

            let receiptAmount = collectSum + lateFee - concession;
            receiptAmount = Math.round(receiptAmount * 100) / 100;
            if (receiptAmount < 0) receiptAmount = 0;


            // ============================================
            // TOTAL DUE (overall student due, is payment se pehle)
            // ============================================

            const totalDueInput = document.getElementById("totalDueAmount");
            const totalDue = totalDueInput ? (parseFloat(totalDueInput.value) || 0) : 0;


            // ============================================
            // BALANCE AMOUNT (naya due) — backend formula:
            // TotalDue - CollectSum(sirf fee) - Concession
            // Late Fee due se kabhi minus nahi hota
            // ============================================

            let balanceAmount = totalDue - collectSum - concession;
            balanceAmount = Math.round(balanceAmount * 100) / 100;
            if (balanceAmount < 0) balanceAmount = 0;


            // ================= UPDATE UI FIELDS =================

            const totalAmountInput = document.getElementById("totalAmount");
            if (totalAmountInput) totalAmountInput.value = formatCurrency(totalDue);

            const totalFeesInput = document.getElementById("totalFees");
            if (totalFeesInput) totalFeesInput.value = formatCurrency(collectSum);

            const receiptAmountInput = getInput("FeeReceipt.ReceiptAmount");
            if (receiptAmountInput) receiptAmountInput.value = receiptAmount.toFixed(2);

            const balanceAmountInput = document.getElementById("balanceAmount");
            if (balanceAmountInput) balanceAmountInput.value = balanceAmount.toFixed(2);

            const netFeeInput = document.getElementById("netFee");
            if (netFeeInput) netFeeInput.value = receiptAmount.toFixed(2);

        }


        // =========================================================
        // FEE CHECKBOX SELECT / UNSELECT
        // =========================================================

        document.addEventListener("change", function(e) {

            if (!e.target.classList.contains("fee-select")) return;

            const checkbox = e.target;
            const index = checkbox.dataset.index;

            const collectInput =
                document.querySelector(`.collect-amount[data-index="${index}"]`);

            if (!collectInput) return;

            if (checkbox.checked) {

                const balance = parseFloat(collectInput.max) || 0;
                collectInput.value = balance.toFixed(2);

            } else {

                collectInput.value = "0";

            }

            calculateReceipt();

        });


        // =========================================================
        // INPUT EVENTS: Collect Amount / Late Fee / Concession
        // =========================================================

      document.addEventListener("input", function (e) {

    if (e.target.classList.contains("collect-amount")) {

        const input = e.target;
        const max = parseFloat(input.max) || 0;

        // ============================================
        // Raw string ko clean karo — sirf ek dot aur digits allow karo
        // ============================================

        let rawValue = input.value;

        // Multiple dots allow na karo (sirf pehla dot valid rahega)
        rawValue = rawValue.replace(/[^0-9.]/g, '');

        const dotCount = (rawValue.match(/\./g) || []).length;
        if (dotCount > 1) {
            rawValue = rawValue.substring(0, rawValue.lastIndexOf('.'));
        }

        input.value = rawValue;


        // ============================================
        // Agar value abhi INCOMPLETE hai (jaise "300." ya khali),
        // to clamp/reformat SKIP karo — user ko type karne do
        // ============================================

        if (rawValue === '' || rawValue.endsWith('.')) {

            const checkbox = document.querySelector(
                `.fee-select[data-index="${input.dataset.index}"]`
            );
            if (checkbox) {
                checkbox.checked = (parseFloat(rawValue) || 0) > 0;
            }

            calculateReceipt();
            return;   // 👈 yahin ruk jao, max clamp mat karo
        }


        // ============================================
        // Ab value COMPLETE hai — tabhi min/max clamp karo
        // ============================================

        let value = parseFloat(rawValue) || 0;

        if (value < 0) value = 0;

        if (value > max) {
            value = max;
            input.value = value;   // sirf tabhi overwrite karo jab actually clamp hua ho
        }


        const index = input.dataset.index;
        const checkbox = document.querySelector(`.fee-select[data-index="${index}"]`);

        if (checkbox) {
            checkbox.checked = value > 0;
        }

        calculateReceipt();

    }

    
            // -----------------------------------------------------
            // Late Fee
            // -----------------------------------------------------

            if (e.target.name === "FeeReceipt.LateFee") {
                calculateReceipt();
            }


            // -----------------------------------------------------
            // Concession Amount → calculation + required message toggle
            // -----------------------------------------------------

            if (e.target.name === "FeeReceipt.ConcessionAmount") {

                calculateReceipt();

                const concessionValue = parseFloat(e.target.value) || 0;
                const messageInput = document.getElementById("concessionMessage");
                const requiredMark = document.getElementById("concessionMsgRequiredMark");

                if (messageInput) {

                    if (concessionValue > 0) {
                        messageInput.setAttribute("required", "required");
                        if (requiredMark) requiredMark.style.display = "inline";
                    } else {
                        messageInput.removeAttribute("required");
                        if (requiredMark) requiredMark.style.display = "none";
                    }

                }

            }

});


        // =========================================================
        // SELECT ALL TUITION
        // =========================================================

        const selectAllTuition = document.getElementById("selectAllTuition");

        if (selectAllTuition) {

            selectAllTuition.addEventListener("change", function() {

                const checked = selectAllTuition.checked;

                document.querySelectorAll(".tuition-select").forEach(function(checkbox) {

                    checkbox.checked = checked;

                    const index = checkbox.dataset.index;
                    const collectInput =
                        document.querySelector(`.collect-amount[data-index="${index}"]`);

                    if (!collectInput) return;

                    if (checked) {
                        const balance = parseFloat(collectInput.max) || 0;
                        collectInput.value = balance.toFixed(2);
                    } else {
                        collectInput.value = "0";
                    }

                });

                calculateReceipt();

            });

        }


        // =========================================================
        // SELECT ALL TRANSPORT
        // =========================================================

        const selectAllTransport = document.getElementById("selectAllTransport");

        if (selectAllTransport) {

            selectAllTransport.addEventListener("change", function() {

                const checked = selectAllTransport.checked;

                document.querySelectorAll(".transport-select").forEach(function(checkbox) {

                    checkbox.checked = checked;

                    const index = checkbox.dataset.index;
                    const collectInput =
                        document.querySelector(`.collect-amount[data-index="${index}"]`);

                    if (!collectInput) return;

                    if (checked) {
                        const balance = parseFloat(collectInput.max) || 0;
                        collectInput.value = balance.toFixed(2);
                    } else {
                        collectInput.value = "0";
                    }

                });

                calculateReceipt();

            });

        }


        // =========================================================
        // SELECT ALL HOSTEL
        // =========================================================

        const selectAllHostel = document.getElementById("selectAllHostel");

        if (selectAllHostel) {

            selectAllHostel.addEventListener("change", function() {

                const checked = selectAllHostel.checked;

                document.querySelectorAll(".hostel-select").forEach(function(checkbox) {

                    checkbox.checked = checked;

                    const index = checkbox.dataset.index;
                    const collectInput =
                        document.querySelector(`.collect-amount[data-index="${index}"]`);

                    if (!collectInput) return;

                    if (checked) {
                        const balance = parseFloat(collectInput.max) || 0;
                        collectInput.value = balance.toFixed(2);
                    } else {
                        collectInput.value = "0";
                    }

                });

                calculateReceipt();

            });

        }


        // =========================================================
        // SAVE RECEIPT — Concession validation + submit
        // =========================================================

        const saveReceiptBtn = document.getElementById("saveReceiptBtn");

        if (saveReceiptBtn) {

            saveReceiptBtn.addEventListener("click", function() {

                const concessionInput = document.getElementById("concessionAmount");
                const messageInput = document.getElementById("concession");

                const concessionValue = parseFloat(concessionInput?.value) || 0;
                const messageValue = messageInput?.value.trim() || "";

                if (concessionValue > 0 && messageValue === "") {

                    alert("Please Enter Concession Reason or Message!");

                    messageInput.focus();

                    return;

                }

                const form = document.getElementById("feeSearchForm");

                form.action = '@Url.Action("SaveFeeReceipt", "FeeHeading")';
                form.method = "post";

                form.submit();

            });

        }


        // =========================================================
        // INITIAL CALCULATION (page load / postback)
        // =========================================================

        document.addEventListener("DOMContentLoaded", function() {

            calculateReceipt();

            // Postback/edit case me agar concession pehle se filled ho
            const concessionInput = document.getElementById("concessionAmount");

            if (concessionInput) {
                concessionInput.dispatchEvent(new Event("input"));
            }

        });

    </script>
}