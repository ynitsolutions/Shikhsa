                            </td>

                            <td>
                                @fee.Balance.ToString("N2")
                            </td>

                            <td class="text-center">

                                <input type="checkbox"
                                       class="fee-select transport-select"
                                       name="FeeReceipt.TransportFees[@i].IsSelected"
                                       value="true"
                                       data-index="@i" />

                               <input type="hidden" name="FeeReceipt.TransportFees[@i].FeeId" value="@fee.FeeId" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].FeePlanId" value="@fee.FeePlanId" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].FeeType" value="@fee.FeeType" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].FeeDescription" value="@fee.FeeDescription" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].Month" value="@fee.Month" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].Year" value="@fee.Year" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].Amount" value="@fee.Amount" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].PaidAmount" value="@fee.PaidAmount" />
                                <input type="hidden" name="FeeReceipt.TransportFees[@i].Balance" value="@fee.Balance" />

                            </td>

                            <td>

                                <input type="text"
                                       class="form-control form-control-sm collect-amount decimal"
                                       name="FeeReceipt.TransportFees[@i].CollectAmount"
                                       value="0"
                                       min="0"
                                       max="@fee.Balance"
                                       data-amount="@fee.Amount"
                                       data-index="@i" />
                                

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>


                            <!-- ===================================== -->
                            <!-- HOSTEL -->
                            <!-- ===================================== -->


