                                       value="true"
                                       data-index="@i" />

                                <input type="hidden" name="FeeReceipt.HostelFees[@i].FeeId" value="@fee.FeeId" />
                                <input type="hidden" name="FeeReceipt.HostelFees[@i].FeePlanId" value="@fee.FeePlanId" />
                                <input type="hidden" name="FeeReceipt.HostelFees[@i].FeeType" value="@fee.FeeType" />
                                <input type="hidden" name="FeeReceipt.HostelFees[@i].FeeDescription" value="@fee.FeeDescription" />
                                <input type="hidden" name="FeeReceipt.HostelFees[@i].Month" value="@fee.Month" />
                                <input type="hidden" name="FeeReceipt.HostelFees[@i].Year" value="@fee.Year" />
                                <input type="hidden" name="FeeReceipt.HostelFees[@i].Amount" value="@fee.Amount" />
                                <input type="hidden" name="FeeReceipt.HostelFees[@i].PaidAmount" value="@fee.PaidAmount" />
