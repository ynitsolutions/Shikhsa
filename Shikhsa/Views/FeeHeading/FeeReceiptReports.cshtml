@model Shikhsa.ViewModels.FeeReceiptRecordVM

@{
    ViewData["Title"] = "Fee Receipt Records";
}

<style>
    /* ── Custom styles for this view ── */
    .receipt-page .filter-card,
    .receipt-page .record-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .receipt-page .filter-header {
        padding: 0.75rem 1rem;
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .receipt-page .filter-header .title {
            font-weight: 600;
            font-size: 1rem;
        }

    .receipt-page .filter-body {
        padding: 1rem;
    }

    .receipt-page .form-label {
        font-weight: 500;
        font-size: 0.8rem;
        margin-bottom: 0.25rem;
        color: #344054;
    }

    .receipt-page .form-control,
    .receipt-page .form-select {
        font-size: 0.9rem;
        height: 38px;
        border-radius: 6px;
    }

    .receipt-page .record-header {
        padding: 0.75rem 1rem;
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .receipt-page .record-title {
        font-weight: 600;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .receipt-page .record-count {
        font-size: 0.8rem;
        background: #e6f7fb;
        color: #17849a;
        padding: 2px 10px;
        border-radius: 20px;
        margin-left: 6px;
        white-space: nowrap;
    }

    .receipt-page .table-responsive {
        padding: 0.5rem 0.75rem;
    }

    #receiptTable {
        width: 100% !important;
        font-size: 0.85rem;
    }

        #receiptTable thead th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #475467;
            background: #f8fafc;
            white-space: nowrap;
            padding: 0.6rem 0.5rem;
        }

        #receiptTable tbody td {
            padding: 0.5rem;
            vertical-align: middle;
        }

    .student-name {
        font-weight: 600;
        color: #17365d;
    }

    .class-badge,
    .batch-badge,
    .mode-badge {
        font-size: 0.7rem;
        padding: 3px 10px;
        border-radius: 20px;
        display: inline-block;
        white-space: nowrap;
    }

    .class-badge {
        background: #e5f3ff;
        color: #2473a9;
    }

    .batch-badge {
        background: #fff4d6;
        color: #946b00;
    }

    .mode-badge {
        background: #e4f8e8;
        color: #1c7c35;
    }

    .fee-headings {
        min-width: 200px;
        max-width: 350px;
        line-height: 1.4;
        word-break: break-word;
    }

    .amount {
        font-weight: 600;
        white-space: nowrap;
    }

    .preview-btn {
        font-size: 0.75rem;
        padding: 0.2rem 0.6rem;
        min-width: 70px;
    }

    .export-btn {
        font-size: 0.85rem;
        padding: 0.3rem 0.9rem;
    }

    .reset-btn {
        font-size: 0.8rem;
        padding: 0.25rem 0.7rem;
    }

    /* DataTable overrides */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
    }

    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        font-size: 0.85rem;
    }

    .dataTables_wrapper .dataTables_length select {
        height: 34px;
        font-size: 0.85rem;
        border-radius: 4px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        font-size: 0.8rem !important;
        padding: 4px 10px !important;
    }

    /* ── Responsive ── */
    @@media (max-width: 575.98px) {
        .receipt-page .filter-header {
            flex-direction: column;
            align-items: stretch;
        }

            .receipt-page .filter-header .title {
                text-align: center;
            }

            .receipt-page .filter-header .reset-btn {
                width: 100%;
            }

        .receipt-page .record-header {
            flex-direction: column;
            align-items: stretch;
        }

            .receipt-page .record-header .record-title {
                justify-content: center;
            }

            .receipt-page .record-header .export-btn {
                width: 100%;
            }

        .receipt-page .filter-body .row > [class*="col-"] {
            margin-bottom: 0.5rem;
        }

            .receipt-page .filter-body .row > [class*="col-"]:last-child {
                margin-bottom: 0;
            }

        #receiptTable {
            font-size: 0.75rem;
        }

            #receiptTable thead th {
                font-size: 0.65rem;
                padding: 0.3rem 0.3rem;
            }

            #receiptTable tbody td {
                padding: 0.3rem;
            }

        .fee-headings {
            min-width: 120px;
            max-width: 180px;
        }

        .preview-btn {
            font-size: 0.65rem;
            padding: 0.1rem 0.4rem;
            min-width: 60px;
        }

        .export-btn {
            font-size: 0.8rem;
        }

        .reset-btn {
            font-size: 0.75rem;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            font-size: 0.75rem;
        }

        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            font-size: 0.75rem;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                font-size: 0.7rem !important;
                padding: 2px 6px !important;
            }
    }

    @@media (min-width: 576px) and (max-width: 767.98px) {
        .receipt-page .filter-body .row > .col-md-2 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .receipt-page .filter-body .row > .col-md-4 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }

    @@media (min-width: 768px) and (max-width: 991.98px) {
        .receipt-page .filter-body .row > .col-md-2 {
            flex: 0 0 33.333%;
            max-width: 33.333%;
        }

        .receipt-page .filter-body .row > .col-md-4 {
            flex: 0 0 66.666%;
            max-width: 66.666%;
        }
    }
</style>

<div class="container-fluid receipt-page">

    <form id="receiptAntiForgeryForm">
        @Html.AntiForgeryToken()
    </form>

    <!-- ═══════ FILTER CARD ═══════ -->
    <div class="filter-card">

        <div class="filter-header">
            <span class="title">
                <i class="fa fa-filter me-1"></i> @Localizer.Get("Filter Records")
            </span>
            <button type="button" id="resetFilters" class="btn btn-secondary btn-sm reset-btn">
                <i class="fa fa-refresh"></i> @Localizer.Get("Reset Filters")
            </button>
        </div>

        <div class="filter-body">
            <div class="row g-2">

                <!-- Date From -->
                <div class="col-6 col-md-2">
                    <label class="form-label"><i class="fa fa-calendar"></i> @Localizer.Get("Date From"):</label>
                    <input type="date" id="dateFrom" class="form-control" />
                </div>

                <!-- Date To -->
                <div class="col-6 col-md-2">
                    <label class="form-label"><i class="fa fa-calendar"></i> @Localizer.Get("Date To"):</label>
                    <input type="date" id="dateTo" class="form-control" />
                </div>

                <!-- Search -->
                <div class="col-12 col-md-4">
                    <label class="form-label"><i class="fa fa-search"></i> @Localizer.Get("Search"):</label>
                    <input type="text" id="receiptSearch" class="form-control"
                           placeholder="Search by student or fee headings..." />
                </div>

                <!-- Class -->
                <div class="col-6 col-md-2">
                    <label class="form-label"><i class="fa fa-graduation-cap"></i> @Localizer.Get("Class"):</label>
                    <select id="classId" class="form-select select2">
                        <option value="">@Localizer.Get("All Classes")</option>
                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <!-- Payment Mode -->
                <div class="col-6 col-md-2">
                    <label class="form-label"><i class="fa fa-credit-card"></i> @Localizer.Get("Payment Mode"):</label>
                    <select id="paymentModeId" class="form-select select2">
                        <option value="">@Localizer.Get("All Modes")</option>
                        @foreach (var item in Model.PaymentModes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <!-- Batch -->
                <div class="col-6 col-md-2">
                    <label class="form-label"><i class="fa fa-calendar-check"></i> @Localizer.Get("Batch"):</label>
                    <select id="batchId" class="form-select select2">
                     @*    <option value="">All Batches</option> *@
                        @foreach (var item in Model.Batches)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

            </div><!-- /row -->
        </div><!-- /filter-body -->
    </div><!-- /filter-card -->
    <!-- ═══════ RECORDS CARD ═══════ -->
    <div class="record-card">

        <div class="record-header">
            <div class="record-title">
                <i class="fa fa-list-alt me-1"></i> @Localizer.Get("Receipt Records")
                <span id="recordCount" class="record-count">@Localizer.Get("Loading")...</span>
            </div>
            <button type="button" id="exportBtn" class="btn btn-success btn-sm export-btn">
                <i class="fa fa-file-excel-o"></i> @Localizer.Get("Export")
            </button>
        </div>

        <div class="table-responsive">
            <table id="receiptTable" class="table table-bordered table-hover table-sm datatable">
                <thead>
                    <tr>
                        <th>@Localizer.Get("RECEIPT ID")</th>
                        <th>@Localizer.Get("STUDENT")</th>
                        <th>@Localizer.Get("CLASS")</th>
                        <th>@Localizer.Get("BATCH")</th>
                        <th>@Localizer.Get("FEE HEADINGS")</th>
                        <th>@Localizer.Get("MODE")</th>
                        <th>@Localizer.Get("TOTAL FEE")</th>
                        <th>@Localizer.Get("PAID AMOUNT")</th>
                        <th>@Localizer.Get("DATE")</th>
                        <th>@Localizer.Get("ACTION")</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div><!-- /record-card -->

</div><!-- /container-fluid -->
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {

            let searchTimer = null;

            const table = $('#receiptTable').DataTable({

                processing: true,
                serverSide: true,
                searching: false,
                ordering: true,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],

                ajax: {
                    url: '@Url.Action("FeeReceiptReports", "FeeHeading")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: function(d) {
                        d.DateFrom = $('#dateFrom').val() || null;
                        d.DateTo = $('#dateTo').val() || null;
                        d.ClassId = $('#classId').val() || null;
                        d.BatchId = $('#batchId').val() || null;
                        d.PaymentModeId = $('#paymentModeId').val() || null;
                        d.search = $('#receiptSearch').val() || '';
                    },
                    dataSrc: function(json) {
                        $('#recordCount').text(json.recordsFiltered + ' ' + @Html.Raw(Json.Serialize(Localizer.Get("records found"))));
                        return json.data;
                    }
                },

                order: [[8, 'desc']],

                columns: [
                    { data: 'feeReceiptId' },
                    {
                        data: 'studentName',
                        render: function(data) {
                            return '<span class="student-name">' + escapeHtml(data || '') + '</span>';
                        }
                    },
                    {
                        data: 'className',
                        render: function(data) {
                            return '<span class="class-badge">' + escapeHtml(data || '') + '</span>';
                        }
                    },
                    {
                        data: 'academicYear',
                        render: function(data) {
                            return '<span class="batch-badge">' + escapeHtml(data || '') + '</span>';
                        }
                    },
                    {
                        data: 'feeHeadings',
                        render: function(data) {
                            return '<div class="fee-headings">' + escapeHtml(data || '') + '</div>';
                        }
                    },
                    {
                        data: 'paymentMode',
                        render: function(data) {
                            return '<span class="mode-badge"><i class="fa fa-money"></i> ' + escapeHtml(data || '') + '</span>';
                        }
                    },
                    {
                        data: 'totalFee',
                        className: 'text-end amount',
                        render: function(data) {
                            return '₹' + Number(data || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 });
                        }
                    },
                    {
                        data: 'paidAmount',
                        className: 'text-end amount',
                        render: function(data) {
                            return '₹' + Number(data || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 });
                        }
                    },
                    {
                        data: 'receiptDate',
                        render: function(data) {
                            if (!data) return '';
                            const date = new Date(data);
                            return formatDate(date);
                        }
                    },
                    {
                        data: 'feeReceiptId',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function(data) {
                            const url = '@Url.Action("PrintReceipt", "FeeHeading")' + '?id=' + data;
                            return '<a href="' + url + '" target="_blank" class="btn btn-primary btn-sm preview-btn">'
                                + '<i class="fa fa-eye"></i> @Localizer.Get("Preview")</a>';
                        }
                    }
                ],

                language: {
                    processing: '<i class="fa fa-spinner fa-spin"></i> Loading...',
                    emptyTable: '@Localizer.Get("No receipt records found")',
                    zeroRecords: '@Localizer.Get("No matching receipt records found")'
                }

            });

            // ─── Filter changes ───
            $('#dateFrom, #dateTo, #classId, #batchId, #paymentModeId')
                .on('change', function() {
                    table.ajax.reload();
                });

            // ─── Search (debounced) ───
            $('#receiptSearch')
                .on('keyup', function() {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function() {
                        table.ajax.reload();
                    }, 400);
                });

            // ─── Reset ───
            $('#resetFilters').on('click', function() {
                $('#dateFrom').val('');
                $('#dateTo').val('');
                $('#receiptSearch').val('');
                $('#classId').val('');
                $('#batchId').val('');
                $('#paymentModeId').val('');
                // Trigger select2 reset if needed
                $('.select2').val('').trigger('change');
                table.ajax.reload();
            });

            // ─── Export ───
            $('#exportBtn').on('click', function() {
                const params = new URLSearchParams({
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    search: $('#receiptSearch').val(),
                    classId: $('#classId').val(),
                    batchId: $('#batchId').val(),
                    paymentModeId: $('#paymentModeId').val()
                });
                window.location.href = '@Url.Action("ExportFeeReceiptReports", "FeeHeading")' + '?' + params.toString();
            });

        });

        // ─── Helpers ───

        function formatDate(date) {
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            let hours = date.getHours();
            const minutes = String(date.getMinutes()).padStart(2, '0');
            const ampm = hours >= 12 ? 'pm' : 'am';
            hours = hours % 12 || 12;
            return `${day}/${month}/${year} ${hours}:${minutes} ${ampm}`;
        }

        function escapeHtml(value) {
            return $('<div>').text(value).html();
        }
    </script>
}