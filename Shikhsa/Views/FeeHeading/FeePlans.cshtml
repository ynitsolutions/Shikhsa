@model Shikhsa.ViewModels.FeePlanIndexViewModel
@{
    ViewData["Title"] = "Configure Fee Plans";
    var feeHeadings = ViewBag.FeeHeadingList as List<FeeHeading>;
}

<style>
    /* ── Extra stijlen voor deze view ── */
    .tab-content .card {
        background: transparent;
        border: none;
        box-shadow: none;
        padding: 0;
    }

    .tab-content .card-body {
        padding: 0;
    }

    .tab-pane .form-actions .btn {
        min-width: 120px;
    }
    /* Zorg dat tabellen op kleine schermen horizontaal scrollen */
    .table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    /* Responsieve knoppen in tabellen */
    .btn-action-sm {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        min-width: 32px;
    }

    @@media (max-width: 575.98px) {
        .tab-pane .row.g-3 > [class*="col-"] {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .tab-pane .form-actions {
            flex-direction: column;
            gap: 0.5rem;
        }

            .tab-pane .form-actions .btn {
                width: 100%;
            }

        .table th, .table td {
            font-size: 0.75rem;
            padding: 0.3rem 0.4rem;
        }

        .btn-action-sm {
            font-size: 0.65rem;
            padding: 0.15rem 0.3rem;
            min-width: 28px;
        }
    }

    @@media (min-width: 576px) and (max-width: 767.98px) {
        .tab-pane .row.g-3 .col-md-3 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .tab-pane .row.g-3 .col-md-2 {
            flex: 0 0 33.333%;
            max-width: 33.333%;
        }
    }

    @@media (max-width: 991.98px) {
        .tab-pane .row.g-3 .col-md-3 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .tab-pane .row.g-3 .col-md-2 {
            flex: 0 0 50%;
            max-width: 50%;
        }
    }
</style>

<div class="container-fluid mt-2 mt-sm-3">

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white py-2 py-sm-3">
            <h4 class="mb-0 fs-5 fs-sm-4">
                @Localizer.Get("Configure Fee Plans")
            </h4>
        </div>
        <div class="card-body p-2 p-sm-3 p-md-4">

            <!-- Tabs -->
            <ul class="nav nav-tabs" id="feePlanTabs" role="tablist">
                <permission controller="FeeHeading" action="TuitionFee" type="create">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tuition" type="button">
                            🏫 @Localizer.Get("Tuition Fee")
                        </button>
                    </li>
                </permission>
                <permission controller="FeeHeading" action="TransportFee" type="create">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#transport" type="button">
                            🚌 @Localizer.Get("Transport Fee")
                        </button>
                    </li>
                </permission>
                <permission controller="FeeHeading" action="HostelFee" type="create">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#hostel" type="button">
                            🏠 @Localizer.Get("Hostel Fee")
                        </button>
                    </li>
                </permission>
            </ul>

            <div class="tab-content border border-top-0 p-2 p-sm-3">

                <!-- ═══════════════════ TUITION TAB ═══════════════════ -->
                <div class="tab-pane fade show active" id="tuition">

                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@Localizer.Get("Tuition Fee Plan")</h5>

                            <form asp-action="SaveTuitionFee" method="post" class="row g-3">
                                <input type="hidden" asp-for="NewTuition.TuitionFeePlanId" />

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">@Localizer.Get("Fee Heading")</label>
                                    <select asp-for="NewTuition.FeeHeadingId" class="form-select select2 required" required>
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in feeHeadings?.Where(x => x.IsActive) ?? Enumerable.Empty<FeeHeading>())
                                        {
                                            <option value="@item.FeeHeadingId">@item.FeeHeadingName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewTuition.FeeHeadingId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">@Localizer.Get("Class")</label>
                                    <select asp-for="NewTuition.ClassIds" class="form-select select2 required" multiple>
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in ViewBag.Classes)
                                        {
                                            <option value="@item.DataListItemId" data-name="@item.DataListItemText">@item.DataListItemText</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewTuition.ClassIds" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label class="form-label">@Localizer.Get("Fee Value")</label>
                                    <input asp-for="NewTuition.FeeValue" type="text" class="form-control decimal required" required />
                                    <span asp-validation-for="NewTuition.FeeValue" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label class="form-label">@Localizer.Get("Academic Year")</label>
                                    <select asp-for="NewTuition.BatchId" class="form-select select2 required" required>
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in ViewBag.Batches)
                                        {
                                            <option value="@item.BatchId">@item.AcademicYear</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewTuition.BatchId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 text-end form-actions d-flex flex-wrap justify-content-end gap-2 mt-3">
                                    <button type="reset" class="btn btn-outline-secondary">@Localizer.Get("Reset")</button>
                                    <button type="submit" class="btn btn-primary">@Localizer.Get("Save Tuition Plan")</button>
                                </div>
                            </form>

                            <hr />

                            <h6 class="mt-3">@Localizer.Get("Tuition Fee Plans") (@Model.TuitionPlans.Count)</h6>

                            <div class="table-wrapper">
                                <table class="table table-striped table-bordered table-hover align-middle datatable" id="tuitionTable">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>#</th>
                                            <th>@Localizer.Get("Class")</th>
                                            <th>@Localizer.Get("Fee") @Localizer.Get("Heading")</th>
                                            <th>@Localizer.Get("Batch")</th>
                                            <th>@Localizer.Get("Fee") @Localizer.Get("Value")</th>
                                            <th class="text-center">@Localizer.Get("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.TuitionPlans.Count; i++)
                                        {
                                            var p = Model.TuitionPlans[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>@p.ClassName</td>
                                                <td>@p.FeeHeading.FeeHeadingName</td>
                                                <td>@p.Batch.AcademicYear</td>
                                                <td>₹@p.FeeValue</td>
                                                <td class="text-center">
                                                     <permission controller="FeeHeading" action="TuitionFee" type="edit">
                                                        <a asp-action="SaveTuitionFee" asp-route-id="@p.TuitionFeePlanId" class="btn btn-outline-primary btn-action-sm" title="@Localizer.Get("Edit")">
                                                            <span class="ti ti-pencil"></span>
                                                        </a>
                                                    </permission>
                                                     <permission controller="FeeHeading" action="TuitionFee" type="delete">
                                                        <form asp-action="DeleteTuitionFee" asp-route-id="@p.TuitionFeePlanId" method="post" class="d-inline"
                                                              onsubmit="return confirm('@Localizer.Get("Delete this plan?")');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-outline-danger btn-action-sm" title="@Localizer.Get("Delete")">
                                                                <span class="ti ti-trash"></span>
                                                            </button>
                                                        </form>
                                                    </permission>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══════════════════ TRANSPORT TAB ═══════════════════ -->
                <div class="tab-pane fade" id="transport">

                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@Localizer.Get("Configure Transport Fee Plan")</h5>

                            <form asp-action="SaveTransportFee" method="post" class="row g-3">
                                <input type="hidden" asp-for="NewTransport.TransportFeePlanId" />

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">@Localizer.Get("Fee Type")</label>
                                    <select asp-for="NewTransport.FeeHeadingId" class="form-select select2 required" required>
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in feeHeadings?.Where(x => x.IsActive) ?? Enumerable.Empty<FeeHeading>())
                                        {
                                            <option value="@item.FeeHeadingId">@item.FeeHeadingName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewTransport.FeeHeadingId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">@Localizer.Get("Academic Year")</label>
                                    <select asp-for="NewTransport.BatchId" class="form-select select2 required" required>
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in ViewBag.Batches)
                                        {
                                            <option value="@item.BatchId">@item.AcademicYear</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewTransport.BatchId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">@Localizer.Get("Transport")</label>
                                    <select asp-for="NewTransport.TransportId" class="form-select select2 required">
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in ViewBag.Transports)
                                        {
                                            <option value="@item.DataListItemId" data-name="@item.DataListItemText">@item.DataListItemText</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewTransport.TransportId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label class="form-label">@Localizer.Get("Transport Fee")</label>
                                    <input asp-for="NewTransport.TransportFee" type="text" class="form-control decimal required" required />
                                    <span asp-validation-for="NewTransport.TransportFee" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label class="form-label">@Localizer.Get("Transport Option")</label>
                                    <select asp-for="NewTransport.TransportOption" class="form-select select2 required">
                                        <option value="">@Localizer.Get("Select")</option>
                                        <option value="@Localizer.Get("One Way")">@Localizer.Get("One") @Localizer.Get("Way")</option>
                                        <option value="@Localizer.Get("Two Way")">@Localizer.Get("Two") @Localizer.Get("Way")</option>
                                    </select>
                                    <span asp-validation-for="NewTransport.TransportOption" class="text-danger small"></span>
                                </div>

                                <div class="col-12 text-end form-actions d-flex flex-wrap justify-content-end gap-2 mt-3">
                                    <button type="reset" class="btn btn-outline-secondary">@Localizer.Get("Reset")</button>
                                    <button type="submit" class="btn btn-success">@Localizer.Get("Save Transport Plan")</button>
                                </div>
                            </form>

                            <hr />

                            <h6 class="mt-3">@Localizer.Get("Transport Fee Configuration") (@Model.TransportPlans.Count)</h6>

                            <div class="table-wrapper">
                                <table class="table table-striped table-bordered table-hover align-middle datatable" id="transportTable">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>#</th>
                                            <th>@Localizer.Get("Transport")</th>
                                            <th>@Localizer.Get("Fee") @Localizer.Get("Type")</th>
                                            <th>@Localizer.Get("Fee")</th>
                                            <th>@Localizer.Get("Option")</th>
                                            <th class="text-center">@Localizer.Get("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.TransportPlans != null)
                                        {
                                            @for (int i = 0; i < Model.TransportPlans.Count; i++)
                                            {
                                                var p = Model.TransportPlans[i];
                                                <tr>
                                                    <td>@(i + 1)</td>
                                                    <td>@p.TransportName</td>
                                                    <td>@p.FeeHeading.FeeHeadingName</td>
                                                    <td>₹@p.TransportFee</td>
                                                    <td>@p.TransportOption</td>
                                                    <td class="text-center">
                                                        <a asp-action="SaveTransportFee" asp-route-id="@p.TransportFeePlanId" class="btn btn-outline-primary btn-action-sm" title="@Localizer.Get("Edit")">
                                                            <span class="ti ti-pencil"></span>
                                                        </a>
                                                        <form asp-action="DeleteTransportFee" asp-route-id="@p.TransportFeePlanId" method="post" class="d-inline"
                                                              onsubmit="return confirm('@Localizer.Get("Delete this plan?")');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-outline-danger btn-action-sm" title="@Localizer.Get("Delete")">
                                                                <span class="ti ti-trash"></span>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══════════════════ HOSTEL TAB ═══════════════════ -->
                <div class="tab-pane fade" id="hostel">

                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@Localizer.Get("Configure Hostel Fee Plan")</h5>

                            <form asp-action="SaveHostelFee" method="post" class="row g-3">
                                <input type="hidden" asp-for="NewHostel.HostelFeePlanId" />

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">@Localizer.Get("Fee Type")</label>
                                    <select asp-for="NewHostel.FeeHeadingId" class="form-select select2 required" required>
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in feeHeadings?.Where(x => x.IsActive) ?? Enumerable.Empty<FeeHeading>())
                                        {
                                            <option value="@item.FeeHeadingId">@item.FeeHeadingName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewHostel.FeeHeadingId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">@Localizer.Get("Hostel")</label>
                                    <select asp-for="NewHostel.HostelId" class="form-select select2 required">
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in ViewBag.Hostels)
                                        {
                                            <option value="@item.DataListItemId" data-name="@item.DataListItemText">@item.DataListItemText</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewHostel.HostelId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label class="form-label">@Localizer.Get("Room Type")</label>
                                    <select asp-for="NewHostel.RoomType" class="form-select select2 required">
                                        <option value="">@Localizer.Get("Select")</option>
                                        @foreach (var item in ViewBag.RoomType)
                                        {
                                            <option value="@item.DataListItemId" data-name="@item.DataListItemText">@item.DataListItemText</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewHostel.RoomType" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label class="form-label">@Localizer.Get("Meal Plan")</label>
                                    <select asp-for="NewHostel.MealPlan" class="form-select select2 required">
                                        <option value="">@Localizer.Get("Select")</option>
                                        @if (ViewBag.MealType != null)
                                        {
                                            @foreach (var item in ViewBag.MealType)
                                            {
                                                <option value="@item.DataListItemId" data-name="@item.DataListItemText">@item.DataListItemText</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="NewHostel.MealPlan" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label class="form-label">@Localizer.Get("Hostel Fee")</label>
                                    <input asp-for="NewHostel.HostelFee" type="text" class="form-control decimal required" required />
                                    <span asp-validation-for="NewHostel.HostelFee" class="text-danger small"></span>
                                </div>

                                <div class="col-12 text-end form-actions d-flex flex-wrap justify-content-end gap-2 mt-3">
                                    <button type="reset" class="btn btn-outline-secondary">@Localizer.Get("Reset")</button>

                                    <button type="submit" class="btn btn-danger">@Localizer.Get("Save Hostel Plan")</button>
                                </div>
                            </form>

                            <hr />

                            <h6 class="mt-3">@Localizer.Get("Hostel Configuration") (@Model.HostelPlans.Count)</h6>

                            <div class="table-wrapper">
                                <table class="table table-striped table-bordered table-hover align-middle datatable" id="hostelTable">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>#</th>
                                            <th>@Localizer.Get("Fee")</th>
                                            <th>@Localizer.Get("Hostel")</th>
                                            <th>@Localizer.Get("Room") @Localizer.Get("Type")</th>
                                            <th>@Localizer.Get("Meal") @Localizer.Get("Plan")</th>
                                            <th>@Localizer.Get("Fee")</th>
                                            <th class="text-center">@Localizer.Get("Actions")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.HostelPlans.Count; i++)
                                        {
                                            var p = Model.HostelPlans[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>@p.FeeHeading.FeeHeadingName</td>
                                                <td>@p.HostelName</td>
                                                <td>@p.RoomTypeName</td>
                                                <td>@p.MealPlanName</td>
                                                <td>₹@p.HostelFee</td>
                                                <td class="text-center">
                                                    <a asp-action="SaveHostelFee" asp-route-id="@p.HostelFeePlanId" class="btn btn-outline-primary btn-action-sm" title="@Localizer.Get("Edit")">
                                                        <span class="ti ti-pencil"></span>
                                                    </a>
                                                    <form asp-action="DeleteHostelFee" asp-route-id="@p.HostelFeePlanId" method="post" class="d-inline"
                                                          onsubmit="return confirm('@Localizer.Get("Delete this plan?")');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger btn-action-sm" title="@Localizer.Get("Delete")">
                                                            <span class="ti ti-trash"></span>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div> <!-- /tab-content -->

        </div> <!-- /card-body -->
    </div> <!-- /card -->
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

 
}