@model Shikhsa.ViewModels.FeeFrequencyPageVM

@{
    ViewData["Title"] = "Fee Frequency Master";
}

<style>
    /* ── Custom responsive tweaks for this view ── */
    .card-header .d-flex {
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .card-header .btn {
        white-space: nowrap;
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-check-input {
        margin-top: 0;
    }

    /* Table responsiveness */
    #tblFrequency_wrapper .dataTables_length,
    #tblFrequency_wrapper .dataTables_filter {
        margin-bottom: 0.75rem;
    }

        #tblFrequency_wrapper .dataTables_filter input {
            min-width: 180px;
        }

    @@media (max-width: 575.98px) {
        .card-header .d-flex {
            flex-direction: column;
            align-items: stretch !important;
        }

        .card-header .btn {
            width: 100%;
            justify-content: center;
        }

        .form-actions .btn {
            width: 100%;
            margin-bottom: 0.4rem;
        }

            .form-actions .btn:last-child {
                margin-bottom: 0;
            }

        .table th,
        .table td {
            font-size: 0.75rem;
            padding: 0.35rem 0.4rem;
        }

        #tblFrequency_wrapper .dataTables_filter input {
            min-width: 120px;
            width: 100%;
        }

        #tblFrequency_wrapper .dataTables_length select {
            width: auto;
            min-width: 60px;
        }

        .btn-sm {
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
        }
    }

    @@media (min-width: 576px) and (max-width: 767.98px) {
        .card-header .btn {
            padding: 0.25rem 0.6rem;
            font-size: 0.8rem;
        }

        .table th,
        .table td {
            font-size: 0.8rem;
            padding: 0.4rem 0.5rem;
        }
    }

    /* For very small screens, stack form fields */
    @@media (max-width: 991.98px) {
        .row .col-lg-4,
        .row .col-lg-2 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }

    @@media (min-width: 992px) {
        .row .col-lg-4 {
            flex: 0 0 33.3333%;
            max-width: 33.3333%;
        }

        .row .col-lg-2 {
            flex: 0 0 16.6667%;
            max-width: 16.6667%;
        }
    }
</style>

<div class="container-fluid mt-2 mt-sm-3">

    <!-- ──── FORM CARD ──── -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white py-2 py-sm-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fs-6 fs-sm-5">
                    @Localizer.Get("Fee Frequency Master")
                </h5>

                <a asp-action="Index"
                   class="btn btn-light btn-sm">
                    <i class="fa fa-plus"></i>
                    @Localizer.Get("New")
                </a>

            </div>

        </div>

        <div class="card-body p-2 p-sm-3 p-md-4">

            <form asp-action="SaveFeeFrequency"
                  method="post"
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <input asp-for="Form.FrequencyId" type="hidden" />

                <div class="row g-2 g-sm-3">

                    <!-- Value -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label asp-for="Form.Value"
                               class="form-label fw-semibold mb-1">
                            @Localizer.Get("Value")
                        </label>
                        <input asp-for="Form.Value"
                               class="form-control form-control-sm required text-only"
                               placeholder="Enter value" />
                        <span asp-validation-for="Form.Value"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Text -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label asp-for="Form.Text"
                               class="form-label fw-semibold mb-1">
                            @Localizer.Get("Text")
                        </label>
                        <input asp-for="Form.Text"
                               class="form-control form-control-sm"
                               placeholder="Display Text" />
                        <span asp-validation-for="Form.Text"
                              class="text-danger small">
                        </span>
                    </div>

                    <!-- Display Order -->
                    <div class="col-6 col-md-3 col-lg-2">
                        <label asp-for="Form.DisplayOrder"
                               class="form-label fw-semibold mb-1">
                            @Localizer.Get("Display Order")
                        </label>
                        <input asp-for="Form.DisplayOrder"
                               class="form-control form-control-sm"
                               type="number" />
                    </div>

                    <!-- Status -->
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="form-label fw-semibold mb-1">
                            @Localizer.Get("Status")
                        </label>
                        <div class="form-check mt-1 mt-sm-2">
                            <input asp-for="Form.IsActive"
                                   class="form-check-input" />
                            <label asp-for="Form.IsActive"
                                   class="form-check-label">
                                @Localizer.Get("Active")
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-3" />

                <!-- ── Form Actions ── -->
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 form-actions">

                    <button type="submit"
                            class="btn btn-primary btn-sm order-2 order-sm-1">
                        <i class="fa fa-save"></i>
                        @(Model.Form.FrequencyId == 0 ? @Localizer.Get("Save") : @Localizer.Get("Update"))
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary btn-sm order-1 order-sm-2">
                        <i class="fa fa-refresh"></i>
                        @Localizer.Get("Reset")
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- ──── LIST CARD ──── -->
    <div class="card shadow-sm mt-3 mt-sm-4">

        <div class="card-header bg-dark text-white py-2 py-sm-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fs-6 fs-sm-5">
                    @Localizer.Get("Frequency List")
                </h5>

                <span class="badge bg-light text-dark d-none d-sm-inline-block">
                    @Localizer.Get("Total Records") : @Model.List.Count
                </span>

            </div>

        </div>

        <div class="card-body p-1 p-sm-2 p-md-3">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0 datatable"
                       id="tblFrequency">

                    <thead class="table-primary">
                        <tr>
                            <th width="50" class="text-center">#</th>
                            <th>@Localizer.Get("Value")</th>
                            <th>@Localizer.Get("Text")</th>
                            <th width="120">@Localizer.Get("Display Order")</th>
                            <th width="100" class="text-center">@Localizer.Get("Status")</th>
                            <th width="80" class="text-center">@Localizer.Get("Edit")</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int sr = 1;
                        }
                        @foreach (var item in Model.List)
                        {
                            <tr>
                                <td class="text-center">@(sr++)</td>
                                <td>@item.Value</td>
                                <td>@item.Text</td>
                                <td>@item.DisplayOrder</td>
                                <td class="text-center">
                                    <permission controller="FeeHeading" action="FeeFrequency" type="delete">
                                    @if (item.IsActive)
                                    {
                                        <a asp-action="DeleteFeeFrequency"
                                           asp-route-id="@item.FrequencyId"
                                           class="btn btn-success btn-sm btn-status"
                                           title="Click to Deactivate">
                                            <i class="fa fa-check-circle"></i>
                                            @Localizer.Get("Active")
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="DeleteFeeFrequency"
                                           asp-route-id="@item.FrequencyId"
                                           class="btn btn-danger btn-sm btn-status"
                                           title="Click to Activate">
                                            <i class="fa fa-times-circle"></i>
                                            @Localizer.Get("Inactive")
                                        </a>
                                    }
   
                                    </permission>
                                </td>
                                <td class="text-center">
                                     <permission controller="FeeHeading" action="FeeFrequency" type="edit">
                                        <a asp-action="FeeFrequency"
                                           asp-route-id="@item.FrequencyId"
                                           class="btn btn-warning btn-sm btn-action"
                                           title="Edit">
                                            <i class="fa fa-edit"></i>

                                        </a>
                                    </permission>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    
}