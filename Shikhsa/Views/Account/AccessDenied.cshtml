@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied — Shikhsa</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.19.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div style="min-height:100vh; display:flex; align-items:center;
            justify-content:center; background:var(--bg-page); padding:2rem;">
        <div class="card" style="max-width:420px; width:100%; text-align:center; padding:3rem 2rem;">
            <div style="font-size:3.5rem; color:var(--danger); margin-bottom:1rem;">
                <i class="ti ti-shield-off"></i>
            </div>
            <h2 style="margin-bottom:0.5rem;">Access Denied</h2>
            <p style="color:var(--text-secondary); font-size:0.9rem; margin-bottom:1.5rem;">
                You don't have permission to access this page.
                Please contact your administrator.
            </p>
            <a href="/" class="btn btn-primary">
                <i class="ti ti-home"></i> Go to Dashboard
            </a>
        </div>
    </div>
</body>
</html>